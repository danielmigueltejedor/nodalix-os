#!/usr/bin/env python3
"""NXPM: one binary-only interface to Linux software on Nodalix.

Native packages are installed by ALPM/pacman, Flatpaks by Flatpak and portable
AppImages by the NXPM applications integration. There is NO on-client source
download, Git checkout, AUR compilation or makepkg fallback.
"""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys

PACMAN = "/usr/bin/pacman"
FLATPAK = "/usr/bin/flatpak"
PKEXEC = "/usr/bin/pkexec"
PACKAGE = re.compile(r"[A-Za-z0-9_@+][A-Za-z0-9_@+.-]*\Z")
APPID = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]*\Z")
DESKTOP = re.compile(r"[A-Za-z0-9_@+ .-]+\.desktop\Z")
SAFE_FILESYSTEMS = {"home", "xdg-documents", "xdg-download", "xdg-pictures",
                    "xdg-music", "xdg-videos", "xdg-desktop"}
CORE = {"nxpm", "nodalix-release", "nodalix-gnome", "nodalix-updater",
        "nodalix-settings", "nodalix-control-center", "linux-nodalix",
        "pacman", "glibc", "systemd", "gnome-shell", "mutter",
        "filesystem", "base", "bash", "polkit", "networkmanager"}


class NxpmError(Exception):
    pass


def execute(argv, privileged=False):
    cmd = ([PKEXEC] if privileged and os.geteuid() else []) + argv
    return subprocess.run(cmd, check=False).returncode


def output(argv):
    result = subprocess.run(argv, text=True, capture_output=True, check=False)
    return result.returncode, result.stdout


def valid(value, kind):
    pattern = PACKAGE if kind == "package" else APPID if kind == "flatpak" else DESKTOP
    if not pattern.fullmatch(value) or value.startswith(("-", ".")):
        raise NxpmError("Identificador no válido")
    return value


def installed(package):
    return output([PACMAN, "-Q", "--", package])[0] == 0


def native_transaction(arguments):
    # The release-controlled kernel is never updated through ordinary
    # app transactions. A separate Nodalix release controls kernel versions.
    return execute([PACMAN, "-Syu", "--ignore", "linux-nodalix",
                    *arguments], privileged=True)


def flatpak_installed(app_id):
    for scope in ("--user", "--system"):
        code, _ = output([FLATPAK, "info", scope, app_id])
        if code == 0:
            return scope
    return None


def provider(target, selected):
    if target.startswith("flatpak:"):
        return "flatpak", valid(target[len("flatpak:"):], "flatpak")
    if target.startswith("aur:"):
        raise NxpmError("AUR solo está disponible si existe un binario verificado "
                        "en los repositorios Nodalix; no compilamos en el PC.")
    if target.lower().endswith(".appimage"):
        return "appimage", target
    if selected == "flatpak":
        return "flatpak", valid(target, "flatpak")
    if selected == "native":
        return "native", valid(target, "package")
    raise NxpmError("Proveedor no admitido")


def search(term, source):
    if source in ("native", "all"):
        execute([PACMAN, "-Ss", "--", term])
    if source in ("flatpak", "all"):
        execute([FLATPAK, "search", term])


def list_installed(source):
    if source in ("native", "all"):
        execute([PACMAN, "-Qe"])
    if source in ("flatpak", "all"):
        execute([FLATPAK, "list", "--app", "--columns=application,version,origin"])


def install(target, source):
    name, value = provider(target, source)
    if name == "native":
        return native_transaction(["--needed", "--", value])
    if name == "flatpak":
        return execute([FLATPAK, "install", "--user", "--", value])
    # AppImage is copied and indexed by NXPM; no execution/build for metadata.
    source_path = Path(value).expanduser().resolve()
    if not source_path.is_file() or source_path.suffix.lower() != ".appimage":
        raise NxpmError("Selecciona un archivo AppImage local válido.")
    return execute(["/usr/bin/nxpm-app-library", "install", str(source_path)])


def remove(target, source):
    name, value = provider(target, source)
    if name == "native":
        if value.lower() in CORE:
            raise NxpmError("El paquete pertenece al sistema Nodalix.")
        if not installed(value):
            raise NxpmError("El paquete no está instalado.")
        # -R retains app data and dependencies, refuses required dependencies.
        return execute([PACMAN, "-R", "--", value], privileged=True)
    if name == "flatpak":
        scope = flatpak_installed(value)
        if not scope:
            raise NxpmError("Flatpak no está instalado.")
        return execute([FLATPAK, "uninstall", scope, "--", value],
                       privileged=scope == "--system")
    raise NxpmError("Desinstala este AppImage desde Aplicaciones.")


def update(target=None):
    if target:
        name, value = provider(target, "native")
        if name == "flatpak":
            scope = flatpak_installed(value)
            if not scope:
                raise NxpmError("Flatpak no está instalado.")
            return execute([FLATPAK, "update", scope, "--", value],
                           privileged=scope == "--system")
        if name != "native" or not installed(value):
            raise NxpmError("Solo pueden actualizarse paquetes ya instalados.")
        return native_transaction(["--needed", "--", value])
    status = native_transaction([])
    if status:
        return status
    # Flatpak is independent of the ALPM system transaction.
    if Path(FLATPAK).exists():
        return execute([FLATPAK, "update", "--user"])
    return 0


def permissions(action, app_id, filesystem=None):
    valid(app_id, "flatpak")
    if not flatpak_installed(app_id):
        raise NxpmError("La aplicación Flatpak no está instalada.")
    if action == "show":
        code = execute([FLATPAK, "info", "--show-permissions", app_id])
        if code:
            return code
        return execute([FLATPAK, "override", "--user", "--show", app_id])
    if action == "reset":
        return execute([FLATPAK, "override", "--user", "--reset", app_id])
    if filesystem not in SAFE_FILESYSTEMS:
        raise NxpmError("Permiso no reconocido. Los permisos peligrosos "
                        "requieren una gestión explícita y no se conceden por defecto.")
    flag = "--filesystem=" if action == "grant" else "--nofilesystem="
    return execute([FLATPAK, "override", "--user", flag + filesystem, app_id])


def remove_desktop(ident):
    valid(ident, "desktop")
    launcher = Path("/usr/share/applications") / ident
    if launcher.is_symlink() or not launcher.is_file():
        raise NxpmError("No existe un lanzador del sistema válido.")
    for directory in (launcher, *launcher.parents):
        status = directory.stat()
        if status.st_uid != 0 or status.st_mode & 0o022:
            raise NxpmError("El lanzador debe ser propiedad de root y no modificable.")
    code, owner = output([PACMAN, "-Qqo", "--", str(launcher)])
    if code:
        raise NxpmError("El lanzador no pertenece a un paquete nativo.")
    return remove(valid(owner.strip(), "package"), "native")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="nxpm", description="NXPM: software Linux sin compilaciones locales")
    sub = parser.add_subparsers(dest="action", required=True)
    p = sub.add_parser("search")
    p.add_argument("term")
    p.add_argument("--source", choices=("all", "native", "flatpak"), default="all")
    p = sub.add_parser("list")
    p.add_argument("--source", choices=("all", "native", "flatpak"), default="all")
    for name in ("install", "remove"):
        p = sub.add_parser(name)
        p.add_argument("package")
        p.add_argument("--source", choices=("native", "flatpak"), default="native")
    p = sub.add_parser("update")
    p.add_argument("package", nargs="?")
    p.add_argument("--all", action="store_true")
    p = sub.add_parser("permissions")
    p.add_argument("operation", choices=("show", "grant", "revoke", "reset"))
    p.add_argument("app_id")
    p.add_argument("filesystem", nargs="?")
    p = sub.add_parser("remove-desktop", help=argparse.SUPPRESS)
    p.add_argument("desktop_id")
    args = parser.parse_args(argv)
    try:
        if args.action == "search":
            return search(args.term, args.source) or 0
        if args.action == "list":
            return list_installed(args.source) or 0
        if args.action == "install":
            return install(args.package, args.source)
        if args.action == "remove":
            return remove(args.package, args.source)
        if args.action == "update":
            if args.package and args.all:
                parser.error("Elige un paquete o --all")
            return update(args.package)
        if args.action == "permissions":
            return permissions(args.operation, args.app_id, args.filesystem)
        return remove_desktop(args.desktop_id)
    except (NxpmError, OSError) as error:
        print("NXPM:", error, file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
