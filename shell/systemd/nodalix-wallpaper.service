[Unit]
Description=Nodalix unified wallpaper engine
After=graphical-session-pre.target
PartOf=graphical-session.target
Conflicts=skwd-deck.service skwd-daemon.service skwd-walld.service

[Service]
Type=simple
Environment=SKWD_WALL_V2_CONFIG=%h/.config/nodalix/wallpaper
Environment=SKWD_WALL_V2_CACHE=%h/.cache/nodalix/wallpaper
ExecStart=/usr/bin/skwd-walld --wait-for-session
Restart=on-failure
RestartSec=3
Slice=session.slice
