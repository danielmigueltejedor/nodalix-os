QtObject {
    id: root

    readonly property string language: {
        void SettingsService.rev
        return SettingsService.get("general.language", "en")
    }
    readonly property string localeName: language === "es" ? "es_ES" : "en_US"
    readonly property var languages: [
        { key: "en", label: "English" },
        { key: "es", label: "Español" }
    ]

    function setLanguage(value) { SettingsService.set("general.language", value) }
    function tr(source) {
        void SettingsService.rev
        if (root.language !== "es") return source
        return _es[source] !== undefined ? _es[source] : source
    }

