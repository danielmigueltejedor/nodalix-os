#!/bin/sh
set -eu

if [ "${1:-}" = --system ]; then
    [ "$(id -u)" -eq 0 ] || { echo 'Run --system as root' >&2; exit 1; }
    # Select the next login manager without ending the active session.
    systemctl disable greetd.service 2>/dev/null || true
    systemctl enable gdm.service
    systemctl --global disable nodalix-shell.service nodalix-app-accent.path 2>/dev/null || true
    exit 0
fi

case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:GNOME:*|*:gnome:*) ;;
    *) echo 'Run user migration from a GNOME session' >&2; exit 1 ;;
esac
backup="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix/migrations/gnome-first-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -m 0700 -p "$backup"
if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" ]; then
    cp -a "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" "$backup/"
fi
for unit in nodalix-shell.service nodalix-wallpaper.service nodalix-app-accent.path; do
    printf '%s ' "$unit" >> "$backup/unit-states"
    systemctl --user is-enabled "$unit" >> "$backup/unit-states" 2>/dev/null || true
done
systemctl --user disable --now nodalix-shell.service nodalix-app-accent.path 2>/dev/null || true
systemctl --user mask --now nodalix-shell.service nodalix-wallpaper.service
systemctl --user daemon-reload
printf 'GNOME migration complete. Configuration backup: %s\n' "$backup"
