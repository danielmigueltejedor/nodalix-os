#!/usr/bin/python3
"""Authenticated, bounded image publication; no user pathname is read as root."""
import os
from pathlib import Path
import pwd
import resource
import stat
import subprocess
import sys
import tempfile


def publish(data, directory=Path('/var/lib/nodalix/login')):
    if len(data) > 20*1024*1024 or not data.startswith(b'\xff\xd8\xff'):
        raise ValueError('Expected a JPEG poster smaller than 20 MiB')
    # Reject substituted parents and untrusted writable directories.
    for parent in (Path('/var'), Path('/var/lib'), directory.parent, directory):
        if not parent.exists():
            parent.mkdir(mode=0o755)
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError('Untrusted system wallpaper directory')
    pixels = decode(data)
    fd, temporary = tempfile.mkstemp(prefix='.background-', suffix='.jpg', dir=directory)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(pixels)
        os.chmod(temporary, 0o644)
        os.replace(temporary, directory/'background.jpg')
    finally:
        Path(temporary).unlink(missing_ok=True)


def limit_decoder():
    # A crafted picture must not be able to exhaust memory, time or disk.
    for name, value in (('RLIMIT_AS', 3 << 30), ('RLIMIT_CPU', 30), ('RLIMIT_FSIZE', 64 << 20),
                        ('RLIMIT_NOFILE', 64), ('RLIMIT_CORE', 0)):
        resource.setrlimit(getattr(resource, name), (value, value))


def decode(data):
    """Re-encode the poster as an unprivileged user; root only handles the result.

    ffmpeg parses attacker-influenced bytes, so it runs as `nobody` with resource
    limits, no network or file protocols and a minimal environment. The privileged
    process then validates what came back before publishing it.
    """
    command = ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error',
               '-protocol_whitelist', 'pipe', '-f', 'image2pipe', '-i', 'pipe:0',
               '-frames:v', '1', '-vf', 'scale=min(4096\\,iw):-2', '-threads', '1',
               '-q:v', '2', '-f', 'mjpeg', 'pipe:1']
    options = {}
    if os.geteuid() == 0:
        try:
            identity = pwd.getpwnam('nobody')
            uid, gid = identity.pw_uid, identity.pw_gid
        except KeyError:
            uid = gid = 65534
        options = {'user': uid, 'group': gid, 'extra_groups': []}
    result = subprocess.run(command, input=data, check=True, timeout=20, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, cwd='/', env={'PATH': '/usr/bin', 'LC_ALL': 'C'},
                            preexec_fn=limit_decoder, **options)
    pixels = result.stdout
    if not pixels.startswith(b'\xff\xd8\xff') or len(pixels) > 20*1024*1024:
        raise ValueError('The converted poster is not a valid JPEG')
    return pixels


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise SystemExit('Authentication required')
    publish(sys.stdin.buffer.read(20*1024*1024+1))
