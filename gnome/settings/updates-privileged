#!/usr/bin/python3
"""Authenticated entry point for the shared fixed update transaction."""
import os
import subprocess
import sys
if len(sys.argv)!=2 or sys.argv[1] not in ('nodalix','system','firmware'):
    raise SystemExit('Operación no admitida')
if os.geteuid()!=0:
    raise SystemExit('Se requiere autenticación de administrador')
raise SystemExit(subprocess.run(['/usr/lib/nodalix-updater/update-transaction',sys.argv[1]]).returncode)
