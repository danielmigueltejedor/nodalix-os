pkgname=nodalix-updater
pkgver=0.2.0beta.1
pkgrel=1
pkgdesc="Nodalix GitHub Releases update service"
arch=('any')
url="https://github.com/danielmigueltejedor/nodalix-os"
license=('GPL-3.0-or-later')
depends=('python' 'pacman' 'polkit' 'minisign')
backup=('etc/nodalix/updater.json')
source=("nodalix-updater-$pkgver.tar.zst")
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/updater/nodalix-updater" "$pkgdir/usr/bin/nodalix-updater"
  install -Dm644 "$srcdir/updater/updater.json" "$pkgdir/etc/nodalix/updater.json"
  install -Dm644 "$srcdir/updater/nodalix-update-check.service" "$pkgdir/usr/lib/systemd/system/nodalix-update-check.service"
  install -Dm644 "$srcdir/updater/nodalix-update-check.timer" "$pkgdir/usr/lib/systemd/system/nodalix-update-check.timer"
  install -Dm644 "$srcdir/updater/com.nodalix.updater.policy" "$pkgdir/usr/share/polkit-1/actions/com.nodalix.updater.policy"
  install -d "$pkgdir/etc/systemd/system/timers.target.wants"
  ln -s /usr/lib/systemd/system/nodalix-update-check.timer \
    "$pkgdir/etc/systemd/system/timers.target.wants/nodalix-update-check.timer"
}
