pkgname=nodalix-updater
pkgver=0.2.0
pkgrel=1
pkgdesc="Nodalix GitHub Releases update service"
arch=('any')
url="https://github.com/danielmigueltejedor/nodalix-os"
license=('GPL-3.0-or-later')
depends=('python' 'pacman' 'polkit' 'minisign')
backup=('etc/nodalix/updater.json')
source=("nodalix-updater-$pkgver.tar.zst")
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/updater/nodalix-updater" "$pkgdir/usr/bin/nodalix-updater"
  install -Dm755 "$srcdir/updater/nodalix-system-update" "$pkgdir/usr/bin/nodalix-system-update"
  install -Dm755 "$srcdir/updater/nodalix-hardware-profile" "$pkgdir/usr/bin/nodalix-hardware-profile"
  install -d "$pkgdir/usr/lib/nodalix-updater/migrations"
  install -m644 "$srcdir/updater/migrations/"*.py "$pkgdir/usr/lib/nodalix-updater/migrations/"
  cp -a --no-preserve=ownership "$srcdir/updater/vendor/cachyos-repo" \
    "$pkgdir/usr/lib/nodalix-updater/"
  install -Dm644 "$srcdir/updater/updater.json" "$pkgdir/etc/nodalix/updater.json"
  install -Dm644 "$srcdir/updater/nodalix-update-check.service" "$pkgdir/usr/lib/systemd/system/nodalix-update-check.service"
  install -Dm644 "$srcdir/updater/nodalix-update-check.timer" "$pkgdir/usr/lib/systemd/system/nodalix-update-check.timer"
  install -Dm644 "$srcdir/updater/nodalix-update-system.service" "$pkgdir/usr/lib/systemd/system/nodalix-update-system.service"
  install -Dm644 "$srcdir/updater/nodalix-update-system.timer" "$pkgdir/usr/lib/systemd/system/nodalix-update-system.timer"
  install -Dm644 "$srcdir/updater/nodalix-update-firmware.service" "$pkgdir/usr/lib/systemd/system/nodalix-update-firmware.service"
  install -Dm644 "$srcdir/updater/nodalix-update-firmware.timer" "$pkgdir/usr/lib/systemd/system/nodalix-update-firmware.timer"
  install -Dm644 "$srcdir/updater/nodalix-update-nodalix.service" "$pkgdir/usr/lib/systemd/system/nodalix-update-nodalix.service"
  install -Dm644 "$srcdir/updater/nodalix-update-nodalix.timer" "$pkgdir/usr/lib/systemd/system/nodalix-update-nodalix.timer"
  install -Dm644 "$srcdir/updater/nodalix-update-apps.service" "$pkgdir/usr/lib/systemd/user/nodalix-update-apps.service"
  install -Dm644 "$srcdir/updater/nodalix-update-apps.timer" "$pkgdir/usr/lib/systemd/user/nodalix-update-apps.timer"
  install -Dm644 "$srcdir/updater/com.nodalix.updater.policy" "$pkgdir/usr/share/polkit-1/actions/com.nodalix.updater.policy"
  install -d "$pkgdir/etc/systemd/system/timers.target.wants"
  ln -s /usr/lib/systemd/system/nodalix-update-check.timer \
    "$pkgdir/etc/systemd/system/timers.target.wants/nodalix-update-check.timer"
}
