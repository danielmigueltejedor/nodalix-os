#!/bin/sh
set -u

old_state="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
new_state="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix"
marker="$new_state/.migrated-from-quickshell-v1"

if [ ! -e "$marker" ] && [ -d "$old_state" ]; then
    mkdir -p "$new_state"
    # Before this marker exists the legacy tree is the canonical user state.
    # Overwrite any partial files left by a validation or interrupted first run.
    if cp -a "$old_state/." "$new_state/"; then
        : > "$marker"
    else
        printf '%s\n' "nodalix-shell: state migration incomplete; it will be retried" >&2
    fi
fi

# Set the Nodalix icon default once; later user choices remain untouched.
icon_marker="$new_state/.colloid-icon-theme-v1"
if [ ! -e "$icon_marker" ] && [ -d /usr/share/icons/Colloid-Teal ] && command -v gsettings >/dev/null 2>&1; then
    current_icon=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || true)
    if [ -n "$current_icon" ]; then
        icon_ready=1
        case "$current_icon" in
            "'Adwaita'"|"''")
                gsettings set org.gnome.desktop.interface icon-theme Colloid-Teal >/dev/null 2>&1 || icon_ready=0
                ;;
        esac
        if [ "$icon_ready" -eq 1 ]; then
            mkdir -p "$new_state"
            : > "$icon_marker"
        fi
    fi
fi

exec qs --no-duplicate -c nodalix "$@"
