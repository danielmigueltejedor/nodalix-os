#!/bin/sh
set -u

old_state="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell"
new_state="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix"
marker="$new_state/.migrated-from-quickshell-v1"

if [ ! -e "$marker" ] && [ -d "$old_state" ]; then
    mkdir -p "$new_state"
    # Before this marker exists the legacy tree is the canonical user state.
    # Overwrite any partial files left by a validation or interrupted first run.
    if cp -a "$old_state/." "$new_state/"; then
        : > "$marker"
    else
        printf '%s\n' "nodalix-shell: state migration incomplete; it will be retried" >&2
    fi
fi

# Set the Nodalix icon default once; later user choices remain untouched.
icon_marker="$new_state/.colloid-icon-theme-v1"
if [ ! -e "$icon_marker" ] && [ -d /usr/share/icons/Colloid-Teal ] && command -v gsettings >/dev/null 2>&1; then
    current_icon=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || true)
    if [ -n "$current_icon" ]; then
        icon_ready=1
        case "$current_icon" in
            "'Adwaita'"|"''")
                gsettings set org.gnome.desktop.interface icon-theme Colloid-Teal >/dev/null 2>&1 || icon_ready=0
                ;;
        esac
        if [ "$icon_ready" -eq 1 ]; then
            mkdir -p "$new_state"
            : > "$icon_marker"
        fi
    fi
fi

# Set the Nodalix cursor default once; preserve deliberate custom user themes.
cursor_marker="$new_state/.nodalix-cursor-theme-v1"
if [ ! -e "$cursor_marker" ] && [ -d /usr/share/icons/Nodalix/cursors ] && command -v gsettings >/dev/null 2>&1; then
    current_cursor=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || true)
    cursor_ready=1
    case "$current_cursor" in
        "'Adwaita'"|"'Bibata-Modern-Classic'"|"'Nodalix'"|"''")
            gsettings set org.gnome.desktop.interface cursor-theme Nodalix >/dev/null 2>&1 || cursor_ready=0
            gsettings set org.gnome.desktop.interface cursor-size 24 >/dev/null 2>&1 || cursor_ready=0
            ;;
    esac
    if [ "$cursor_ready" -eq 1 ]; then
        mkdir -p "$new_state"
        : > "$cursor_marker"
    fi
fi

# Reconcile once before QML reads paths; timers handle later installations.
layout_state="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix/layout-mode"
if [ ! -f "$layout_state" ] && command -v nodalix-layout-mode >/dev/null 2>&1; then
    nodalix-layout-mode desktop || true
fi
if command -v nodalix-user-layout >/dev/null 2>&1; then
    nodalix-user-layout --apply || printf '%s\n' "Nodalix layout needs attention" >&2
    systemctl --user start nodalix-user-layout.timer nodalix-user-layout.path nodalix-app-icons.timer 2>/dev/null || true
fi
if command -v nodalix-app-icons >/dev/null 2>&1; then
    nodalix-app-icons >/dev/null || true
fi
exec qs --no-duplicate -c nodalix "$@"
