[Unit]
Description=Nodalix desktop shell
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecCondition=/usr/lib/nodalix/is-hyprland-session
ExecStart=/usr/bin/nodalix-shell
Restart=on-failure
RestartSec=2
# Applications launched from the shell must survive a shell reload.
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
