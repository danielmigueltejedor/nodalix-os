pkgname=nodalix-store
pkgver=0.5.0
pkgrel=1
# Nodalix Store is built from danielmigueltejedor/tienda (branch nodalix/store),
# pinned to an exact commit like every other external Nodalix source.
_store_commit=7d6668c428d85d3dadebb5046bc3a8d28a9b8158
pkgdesc='Nodalix Store: the default app store of Nodalix OS (Flatpak and official packages through NXPM)'
arch=('x86_64')
url='https://github.com/danielmigueltejedor/tienda'
license=('GPL-3.0-or-later')
depends=('nodalix-nxpm' 'gtk4' 'libadwaita' 'libdex' 'flatpak' 'libxmlb' 'libyaml' 'libsoup3'
         'json-glib' 'glycin' 'glycin-gtk4' 'webkitgtk-6.0' 'libsecret' 'libproxy'
         'malcontent' 'gtksourceview5' 'md4c' 'appstream' 'dbus')
makedepends=('meson' 'ninja' 'vala' 'blueprint-compiler' 'gettext' 'libxml2' 'desktop-file-utils'
             'python' 'python-babel' 'perl' 'glib2-devel')
source=("tienda-$_store_commit.tar.gz::https://codeload.github.com/danielmigueltejedor/tienda/tar.gz/$_store_commit")
sha256sums=('beb7eec0c9d7b5d2564479f2f138150b794aac2610a7ba0f19510721698a8b85')

build() {
    cd "$srcdir/tienda-$_store_commit"
    meson setup "$srcdir/build" --prefix=/usr --buildtype=plain
    meson compile -C "$srcdir/build"
}

package() {
    cd "$srcdir/tienda-$_store_commit"
    DESTDIR="$pkgdir" meson install -C "$srcdir/build"
    # Make it the default for software links (appstream:, .flatpakref). It lives in the
    # vendor data directory so it never claims or overrides an administrator's /etc file.
    install -d "$pkgdir/usr/share/applications"
    {
        echo '[Default Applications]'
        for type in x-scheme-handler/appstream x-scheme-handler/flatpak x-scheme-handler/flatpak+https \
                    application/vnd.flatpak application/vnd.flatpak.ref \
                    application/x-freedesktop-appstream-component; do
            echo "$type=os.nodalix.Store.desktop"
        done
    } > "$pkgdir/usr/share/applications/mimeapps.list"
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
