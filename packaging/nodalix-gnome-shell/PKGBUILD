# Rebuild and validate this fork for every Nodalix and GNOME update.
pkgname=nodalix-gnome-shell
pkgver=0.5.2
pkgrel=1
_gnomever=51.1
_upstream_commit=33da06854e229c256afd5872fedd83c28cbfa176
pkgdesc="Nodalix-maintained GNOME Shell 51.1 with bundled desktop modules"
arch=('x86_64')
url='https://github.com/danielmigueltejedor/nodalix-os'
license=('GPL-3.0-or-later')
depends=(
  'accountsservice' 'at-spi2-core' 'bash' 'cairo' 'dconf' 'gcr-4'
  'gdk-pixbuf2' 'gjs' 'glib2' 'glibc' 'gnome-autoar' 'gnome-desktop-4'
  'gnome-session' 'gnome-settings-daemon' 'graphene' 'gsettings-desktop-schemas'
  'gtk4' 'hicolor-icon-theme' 'ibus' 'json-glib' 'libadwaita'
  'libcanberra' 'libgdm' 'libglvnd' 'libgweather-4' 'libical'
  'mutter>=51' 'mutter<52' 'libnm' 'libnma-gtk4' 'libpipewire'
  'libpulse' 'libsecret' 'libsoup3' 'libx11' 'libxext'
  'libxfixes' 'pango' 'polkit' 'systemd-libs' 'unzip' 'upower'
  'webkitgtk-6.0' 'nodalix-gnome>=0.5.1-1'
  'nodalix-settings>=0.5.1-1' 'nodalix-video-wallpapers>=0.5.1-1'
)
makedepends=(
  'git' 'python-gobject' 'meson' 'ninja' 'python' 'asciidoc' 'bash-completion'
  'evolution-data-server' 'gi-docgen' 'glib2-devel'
  'gnome-keybindings' 'gobject-introspection' 'python-docutils' 'sassc'
)
optdepends=('evolution-data-server: calendar' 'gnome-bluetooth-3.0: Bluetooth'
  'gnome-extensions-app: optional third-party GNOME extensions'
  'gst-plugin-pipewire: screen recording' 'gst-plugins-good: screen recording')
provides=("gnome-shell=1:$_gnomever")
conflicts=('gnome-shell' 'nodalix-shell-preview')
source=("git+https://github.com/GNOME/gnome-shell.git#commit=$_upstream_commit"
        'gvc::git+https://github.com/GNOME/libgnome-volume-control.git#commit=0a4eda0cdc2deb352bebc70ec697c42af46094e4'
        'git+https://github.com/ptomato/jasmine-gjs.git#commit=856465dddbd92e82e574891e1ebc79e17d7b708a'
        'git+https://github.com/GNOME/libshew.git#commit=d16afc40412b565d2bbecf80335f54a19a978009'
        'nodalix-shell-overlays.tar.zst'
        'nowplaying-v1.0.14.zip::https://github.com/epogonii/nowplaying-card/releases/download/v1.0.14/nowplaying%40epogonii.github.io.shell-extension.zip')
noextract=('nowplaying-v1.0.14.zip')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'AUTO_OVERLAY_SHA256'
            'b556a9ef350c7776e9060c6f1a7254cc847158dc43b9d62ccd1ef2c1973d24ce')

prepare() {
  local project target
  for project in gvc jasmine-gjs libshew; do
    target="$srcdir/gnome-shell/subprojects/$project"
    if [[ -e "$target" ]]; then
      echo "Refusing an existing GNOME subproject: $project" >&2
      return 1
    fi
    cp -a "$srcdir/$project" "$target"
  done
  python3 "$srcdir/tools/prepare-nodalix-shell.py" "$srcdir/gnome-shell" \
    --overlay "$srcdir/gnome/nodalix-shell"
}

build() {
  local upstream_tests=false
  # Arch's regular Mutter package does not ship its private test library.
  if pkg-config --exists libmutter-test-51; then
    upstream_tests=true
  fi
  arch-meson gnome-shell build --wrap-mode=nodownload -Dgtk_doc=false -Dtests="$upstream_tests"
  meson compile -C build
}

check() {
  local module
  for module in main.js connect.js modules.js modules.json; do
    gresource extract build/src/libshell-51.so "/org/gnome/shell/nodalix/$module" |
      cmp - "$srcdir/gnome/nodalix-shell/$module"
  done
  if pkg-config --exists libmutter-test-51; then
    meson test -C build --print-errorlogs
  fi
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  local module_dir target="$pkgdir/usr/share/gnome-shell/nodalix-modules"
  install -d "$target" "$pkgdir/usr/share/nodalix"
  local music="$target/nowplaying@epogonii.github.io"
  unzip -q "$srcdir/nowplaying-v1.0.14.zip" -d "$music"
  # Keep upstream Now Playing Card 1.0.14; apply Nodalix multi-monitor bridge only.
  python3 "$srcdir/tools/patch-nowplaying-multimonitor.py" "$music/extension.js"
  install -Dm644 "$music/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/NOWPLAYING-CARD-LICENSE"
  glib-compile-schemas --strict "$music/schemas"
  for module_dir in "$srcdir"/gnome/extensions/*; do
    cp -a --no-preserve=ownership "$module_dir" "$target/"
    if [[ -d "$target/${module_dir##*/}/schemas" ]]; then
      glib-compile-schemas --strict "$target/${module_dir##*/}/schemas"
    fi
  done
  # Reject a profile that names a missing key or a value its schema refuses.
  # Desktop packages (LocalSend, Hanabi) install their own schemas; unit tests cover those rows.
  python3 - "$srcdir/gnome/nodalix-shell/profile.json" "$target" "$srcdir/gnome/nodalix-shell/modules.json" <<'PY'
import json, sys
from pathlib import Path
from gi.repository import Gio, GLib
profile, modules = Path(sys.argv[1]), Path(sys.argv[2])
data = json.loads(profile.read_text())
bundled = set(json.loads(Path(sys.argv[3]).read_text())['bundled'])
for row in data['extensions']:
    if row['uuid'] not in bundled:
        continue
    source = Gio.SettingsSchemaSource.new_from_directory(
        str(modules / row['uuid'] / 'schemas'), Gio.SettingsSchemaSource.get_default(), False)
    schema = source.lookup(row['schema'], False)
    if schema is None:
        sys.exit('Missing schema ' + row['schema'])
    for key, text in row['values'].items():
        value = GLib.Variant.parse(None, text, None, None)
        definition = schema.get_key(key)
        if value.get_type_string() != definition.get_value_type().dup_string() or not definition.range_check(value):
            sys.exit('Invalid profile value ' + row['schema'] + ' ' + key)
for uuid in data['enableModules']:
    if not (modules / uuid / 'metadata.json').is_file():
        sys.exit('Missing module ' + uuid)
PY
  install -Dm644 "$srcdir/gnome/nodalix-shell/profile.json" "$pkgdir/usr/share/nodalix/nodalix-shell-profile.json"
  printf 'NODALIX_OS_VERSION=%s\nGNOME_SHELL_VERSION=%s\nUPSTREAM_COMMIT=%s\n' \
    "$pkgver" "$_gnomever" "$_upstream_commit" \
    > "$pkgdir/usr/share/nodalix/shell-build"
}
