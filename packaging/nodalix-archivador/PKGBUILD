pkgname=nodalix-archivador
pkgver=51.1.0
pkgrel=1
pkgdesc="Archivador: Nautilus with the Nodalia Design Language (NDL), the file manager of Nodalix OS"
arch=("x86_64")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
# Same binary, application id, D-Bus names and extension API as Nautilus, so portals,
# nautilus-python extensions and every caller of `nautilus` keep working.
# Arch splits the extension library into libnautilus-extension, which this package also ships.
provides=("nautilus=51.1" "libnautilus-extension=51.1")
conflicts=("nautilus" "libnautilus-extension")
# Runtime libraries are the ones Arch's nautilus links; the build tool installs them
# by installing the stock package first (see tools/build-packages.sh).
depends=("gnome-autoar" "gnome-desktop-4" "gtk4" "libadwaita" "glycin" "glycin-gtk4"
         "libportal" "libportal-gtk4" "tinysparql" "icu" "gexiv2" "gst-plugins-base-libs"
         "gdk-pixbuf2" "libcloudproviders" "gvfs" "dconf" "gsettings-desktop-schemas" "json-glib"
         "systemd" "libnotify")
makedepends=("meson" "ninja" "gobject-introspection" "blueprint-compiler" "python" "glib2-devel"
             "gettext" "desktop-file-utils" "appstream" "libxml2" "json-glib")
# Prepared by tools/build-archivador-package.py from a pinned Nautilus 51.1 tree.
source=("nautilus-51.1.tar.zst" "nodalix-archivador-$pkgver.tar.zst")
sha256sums=("SKIP" "SKIP")
prepare() {
  (cd "$srcdir/nautilus" && python "$srcdir/gnome/archivador/apply.py")
}
build() {
  meson setup "$srcdir/build" "$srcdir/nautilus" --prefix=/usr --buildtype=release \
    -Dtests=none -Ddocs=false -Dselinux=disabled -Dcloudproviders=auto
  meson compile -C "$srcdir/build"
}
package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
}
