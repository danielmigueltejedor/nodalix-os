#!/bin/sh
set -eu

ROOT=${NODALIX_ROOT:-}
ROOT=${ROOT%/}

legacy="$ROOT/usr/share/icons/Nodalix"
target="/usr/share/nodalix/cursor-theme/Nodalix"
target_real="$ROOT$target"
state="$ROOT/var/lib/nodalix-updater/migrations/cursor-theme-layout-v1"
marker="$state/system-mirror"

warn() {
    printf 'nodalix-cursor-theme: %s\n' "$*" >&2
}

owner_of() {
    path=$1

    if ! command -v pacman >/dev/null 2>&1; then
        return 1
    fi

    if [ -n "$ROOT" ]; then
        pacman \
            --root "$ROOT" \
            --dbpath "$ROOT/var/lib/pacman" \
            -Qoq "$path" \
            2>/dev/null
    else
        pacman -Qoq "$path" 2>/dev/null
    fi
}

if [ ! -d "$target_real/cursors" ] || [ ! -f "$target_real/index.theme" ]; then
    warn "packaged cursor payload is missing; leaving the current cursor untouched"
    exit 0
fi

mkdir -p "$ROOT/usr/share/icons" "$state"

if [ -L "$legacy" ] && [ "$(readlink "$legacy")" != "$target" ]; then
    warn "$legacy is a different symlink; leaving it untouched"
    exit 0
fi

managed=no
if [ -d "$legacy" ] && [ ! -L "$legacy" ] &&
        [ "$(stat -c '%d:%i' "$legacy")" = "$(cat "$marker" 2>/dev/null || true)" ]; then
    managed=yes
fi

if [ -e "$legacy" ] && [ ! -L "$legacy" ] && [ "$managed" = no ]; then
    if [ ! -d "$legacy" ]; then
        warn "$legacy is not a directory; leaving it untouched"
        exit 0
    fi

    # A foreign package must retain ownership of its entire installation.
    while IFS= read -r path; do
        owner=$(owner_of "$path" || true)
        if [ -n "$owner" ] && [ "$owner" != "nodalix-cursor-theme" ]; then
            warn "$legacy contains files owned by $owner; leaving it untouched"
            exit 0
        fi
    done <<EOF
$(find "$legacy" \( -type f -o -type l \) -print)
EOF
fi

scratch=$(mktemp -d "$ROOT/usr/share/icons/.nodalix-cursor.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
mkdir "$scratch/new"
# A regular directory and real file entries, even for runtimes that expose
# the icons tree alone. Hard links avoid a second system copy when possible.
if ! cp -al "$target_real/." "$scratch/new/" 2>/dev/null; then
    rm -rf "$scratch/new"
    cp -a "$target_real/." "$scratch/new/"
fi
backup="$scratch/previous"
if [ -e "$legacy" ] || [ -L "$legacy" ]; then
    mv -T -- "$legacy" "$backup"
fi
if ! mv -T -- "$scratch/new" "$legacy"; then
    [ ! -e "$backup" ] && [ ! -L "$backup" ] || mv -T -- "$backup" "$legacy"
    exit 1
fi
if [ -d "$backup" ] && [ ! -L "$backup" ] && [ "$managed" = no ]; then
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    destination="$state/legacy-Nodalix-$stamp-$$"
    if ! mv -- "$backup" "$destination"; then
        mv -T -- "$legacy" "$scratch/new"
        mv -T -- "$backup" "$legacy"
        exit 1
    fi
    {
        printf 'timestamp=%s\n' "$stamp"
        printf 'source=%s\n' "/usr/share/icons/Nodalix"
        printf 'backup=%s\n' "${destination#"$ROOT"}"
        printf 'action=moved-unowned-legacy-cursor\n'
    } > "$state/latest"
    warn "saved legacy cursor theme at ${destination#"$ROOT"}"
fi
stat -c '%d:%i' "$legacy" > "$marker"
