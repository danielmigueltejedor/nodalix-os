post_install() {
    /usr/lib/nodalix/migrate-cursor-theme || true
}

post_upgrade() {
    /usr/lib/nodalix/migrate-cursor-theme || true
}

post_remove() {
    link=/usr/share/icons/Nodalix
    target=/usr/share/nodalix/cursor-theme/Nodalix

    if [ -L "$link" ] && [ "$(readlink "$link" 2>/dev/null || true)" = "$target" ]; then
        rm -f "$link"
    fi
}
