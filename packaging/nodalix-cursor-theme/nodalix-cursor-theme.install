post_install() {
    /usr/lib/nodalix/migrate-cursor-theme
}

post_upgrade() {
    /usr/lib/nodalix/migrate-cursor-theme
}

post_remove() {
    directory=/usr/share/icons/Nodalix
    marker=/var/lib/nodalix-updater/migrations/cursor-theme-layout-v1/system-mirror
    if [ ! -L "$directory" ] && [ -f "$marker" ] &&
        [ "$(stat -c '%d:%i' "$directory" 2>/dev/null)" = "$(cat "$marker")" ]; then
        rm -rf -- "$directory"
        rm -f -- "$marker"
    fi
}
