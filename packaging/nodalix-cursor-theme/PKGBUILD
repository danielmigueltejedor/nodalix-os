pkgname=nodalix-cursor-theme
pkgver=0.2.2
pkgrel=1
pkgdesc="Nodalix system cursor theme based on Bibata Modern Classic"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
source=("Bibata.tar.xz::https://github.com/ful1e5/Bibata_Cursor/releases/download/v2.0.7/Bibata.tar.xz"\n        "nodalix-cursor.conf"\n        "UPSTREAM.md")\nsha256sums=("172e33c4ae415278384dcecc7d1a9b7a024266bc944bc751fd86532be1cc6251"\n            "29b10dc47ed0940e26e4ff982f9d76ad9bd75289e665d75a40fce2fab1c6658b"\n            "50fab64e879d37148eb524f0e4a72ad13023f0d3e64a7ebea0ba009ef0f1018c")

package() {
    local theme="$srcdir/Bibata-Modern-Classic"
    test -d "$theme/cursors"

    install -d "$pkgdir/usr/share/icons/Nodalix"
    cp -a "$theme/." "$pkgdir/usr/share/icons/Nodalix/"
    sed -i \
        -e 's/^Name=.*/Name=Nodalix/' \
        -e 's/^Comment=.*/Comment=Nodalix cursor theme based on Bibata Modern Classic v2.0.7/' \
        "$pkgdir/usr/share/icons/Nodalix/index.theme"

    install -Dm644 nodalix-cursor.conf "$pkgdir/etc/environment.d/90-nodalix-cursor.conf"
    install -Dm644 UPSTREAM.md "$pkgdir/usr/share/doc/nodalix-cursor-theme/UPSTREAM.md"
}
