pkgname=nodalix-cursor-theme
pkgver=0.3.0
pkgrel=2
options=("!strip")
pkgdesc="Nodalix system cursor theme based on Bibata Modern Classic"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
install=nodalix-cursor-theme.install
source=("Bibata.tar.xz::https://github.com/ful1e5/Bibata_Cursor/releases/download/v2.0.7/Bibata.tar.xz"
        "nodalix-cursor.conf"
        "UPSTREAM.md"
        "migrate-cursor-theme")
sha256sums=("172e33c4ae415278384dcecc7d1a9b7a024266bc944bc751fd86532be1cc6251"
            "29b10dc47ed0940e26e4ff982f9d76ad9bd75289e665d75a40fce2fab1c6658b"
            "50fab64e879d37148eb524f0e4a72ad13023f0d3e64a7ebea0ba009ef0f1018c"
            "SKIP")

package() {
    local theme="$srcdir/Bibata-Modern-Classic"
    test -d "$theme/cursors"

    local target="$pkgdir/usr/share/nodalix/cursor-theme/Nodalix"

    install -d "$target"
    cp -a --no-preserve=ownership "$theme/." "$target/"
    sed -i \
        -e 's/^Name=.*/Name=Nodalix/' \
        -e 's/^Inherits=.*/Inherits=Adwaita,hicolor/' \
        -e 's/^Comment=.*/Comment=Nodalix cursor theme based on Bibata Modern Classic v2.0.7/' \
        "$target/index.theme"

    # Stage only: repair standard aliases and reject broken XCursor payloads.
    local alias original
    for pair in default:left_ptr pointer:hand2 wait:watch text:xterm n-resize:top_side w-resize:left_side ew-resize:sb_h_double_arrow ns-resize:sb_v_double_arrow; do
        alias=${pair%%:*}; original=${pair#*:}
        if [ ! -e "$target/cursors/$alias" ]; then
            test -f "$target/cursors/$original" || return 1
            ln -sfn "$original" "$target/cursors/$alias"
        fi
    done
    test -z "$(find -L "$target/cursors" -type l -print)" || return 1
    install -Dm755 migrate-cursor-theme "$pkgdir/usr/lib/nodalix/migrate-cursor-theme"
    install -Dm644 nodalix-cursor.conf "$pkgdir/etc/environment.d/90-nodalix-cursor.conf"
    install -Dm644 UPSTREAM.md "$pkgdir/usr/share/doc/nodalix-cursor-theme/UPSTREAM.md"
}
