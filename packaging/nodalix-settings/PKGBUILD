pkgname=nodalix-settings
pkgver=0.4.0
pkgrel=2
pkgdesc="Native Nodalix updates, animated wallpaper controls and GNOME branding"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
depends=("python" "python-gobject" "polkit" "pacman-contrib" "nodalix-updater>=0.4.0-2" "nodalix-apps" "flatpak" "fwupd" "ffmpeg")
install=nodalix-settings.install
source=("nodalix-settings-$pkgver.tar.zst")
sha256sums=("SKIP")
package() {
  install -Dm644 "$srcdir/gnome/settings/wallpaper_poster.py" "$pkgdir/usr/lib/nodalix/wallpaper_poster.py"
  install -Dm644 "$srcdir/gnome/settings/update_state.py" "$pkgdir/usr/lib/nodalix/update_state.py"
  install -Dm644 "$srcdir/gnome/settings/automatic_updates.py" "$pkgdir/usr/lib/nodalix/automatic_updates.py"
  for helper in automatic-updates-enable automatic-updates-disable; do
    install -Dm755 "$srcdir/gnome/settings/$helper" "$pkgdir/usr/lib/nodalix/$helper"
  done
  install -Dm755 "$srcdir/gnome/settings/sync-login-background" "$pkgdir/usr/lib/nodalix/sync-login-background"
  install -Dm755 "$srcdir/gnome/settings/service.py" "$pkgdir/usr/lib/nodalix/settings-service"
  install -Dm755 "$srcdir/gnome/settings/updates-privileged" "$pkgdir/usr/lib/nodalix/updates-privileged"
  install -Dm644 "$srcdir/gnome/settings/com.nodalix.Settings.service" "$pkgdir/usr/share/dbus-1/services/com.nodalix.Settings.service"
  install -Dm644 "$srcdir/gnome/settings/com.nodalix.settings.policy" "$pkgdir/usr/share/polkit-1/actions/com.nodalix.settings.policy"
  install -Dm644 "$srcdir/docs/images/nodalix-logo.png" "$pkgdir/usr/share/pixmaps/nodalix-logo.png"
  python "$srcdir/gnome/settings/build-login-logo.py" "$srcdir/docs/images/nodalix-logo.png" "$pkgdir/usr/share/pixmaps/nodalix-login-logo.svg"
  install -Dm644 "$srcdir/gnome/settings/gdm-branding" "$pkgdir/usr/lib/nodalix/gdm-branding"
  install -d "$pkgdir/usr/share/gnome-shell/extensions/nodalix-login-background@getnodalia.com"
  cp -a --no-preserve=ownership "$srcdir/gnome/settings/login-background/." "$pkgdir/usr/share/gnome-shell/extensions/nodalix-login-background@getnodalia.com/"
  install -Dm755 "$srcdir/gnome/settings/apply-gdm-branding" "$pkgdir/usr/lib/nodalix/apply-gdm-branding"
}
