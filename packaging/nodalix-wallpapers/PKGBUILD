pkgname=nodalix-wallpapers
pkgver=0.3.0
pkgrel=2
options=("!strip")
pkgdesc="Curated original-resolution wallpapers for Nodalix"
arch=('any')
makedepends=("python")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=('custom:Unsplash')
source=(
  'nodalix-abstract-wave.jpg'
  'nodalix-violet-forms.jpg'
  'nodalix-blue-structure.jpg'
  'nodalix-alpine-mirror.jpg'
  'nodalix-glacier-lake.jpg'
  'nodalix-orbital-nebula.jpg'
  'nodalix-cosmic-cloud.jpg'
  'SOURCES.md'
)
sha256sums=(
  '63b3fcaca5d56acd50f4739dec7e753b9c8699a248ee99227f5be7091864a693'
  '819f5ae40dc3dd52712c415e064b307882304faf77f2411c8683af189047da88'
  'd9b9d3a692e0343d1777b9e4b61b921e77d6cca59ac9f2e51719cddb3e0c3ce6'
  '97e4f3a6192f48ec9ba4863632ff91a55b6b9d9bd9b9f2f86112144241cf1da0'
  '8a106fc57068197009126ddfbd63d9d3abddfd07fc6115d1f25506289cead74c'
  '4eea34440715c9e7583fe734a79c0c5b0b14b5d6d8e9d177b01ca81712925162'
  '613f5dec39ba71a19b7c4fa91660c66dc09793751efa126a390958a588e3b8e2'
  'SKIP'
)

package() {
  local image
  for image in "$srcdir"/nodalix-*.jpg; do
    install -Dm644 "$image" "$pkgdir/usr/share/backgrounds/nodalix/static/${image##*/}"
  done
  install -d "$pkgdir/usr/share/gnome-background-properties" "$pkgdir/usr/share/backgrounds/nodalix/login"
  ln -s static "$pkgdir/usr/share/backgrounds/nodalix/Estáticos"
  install -m644 "$srcdir/nodalix-abstract-wave.jpg" "$pkgdir/usr/share/backgrounds/nodalix/login/nodalix-login-fallback.jpg"
  python - "$pkgdir" <<'PYXML'
from pathlib import Path
import sys,xml.etree.ElementTree as ET
root=Path(sys.argv[1]);catalog=ET.Element('wallpapers')
for path in sorted((root/'usr/share/backgrounds/nodalix/static').glob('*.jpg')):
    wallpaper=ET.SubElement(catalog,'wallpaper',deleted='false')
    ET.SubElement(wallpaper,'name').text=path.stem.replace('nodalix-','Nodalix ').replace('-',' ').title()
    ET.SubElement(wallpaper,'filename').text='/'+str(path.relative_to(root))
    ET.SubElement(wallpaper,'options').text='zoom'
ET.indent(catalog)
ET.ElementTree(catalog).write(root/'usr/share/gnome-background-properties/nodalix-wallpapers.xml',encoding='UTF-8',xml_declaration=True)
PYXML
  install -Dm644 "$srcdir/SOURCES.md" \
    "$pkgdir/usr/share/licenses/$pkgname/SOURCES.md"
}
