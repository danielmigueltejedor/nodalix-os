pkgname=nodalix-control-center
pkgver=51.0.0
pkgrel=1
pkgdesc="GNOME Settings with native Nodalix updates and animated backgrounds"
arch=("x86_64")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-2.0-or-later" "GPL-3.0-or-later")
provides=("gnome-control-center=51.0")
conflicts=("gnome-control-center")
depends=("nodalix-settings" "accountsservice" "bolt" "cairo" "colord-gtk4" "cups-pk-helper" "dconf" "fontconfig" "gcr-4" "gdk-pixbuf2" "glib2" "glibc" "gnome-bluetooth-3.0" "gnome-color-manager" "gnome-desktop-4" "gnome-online-accounts" "gnome-settings-daemon" "gnome-shell" "gnutls" "graphene" "gsettings-desktop-schemas" "gsound" "gst-plugins-good" "gtk4" "hicolor-icon-theme" "json-glib" "krb5" "libadwaita" "libcolord" "libcups" "libepoxy" "libgcc" "libgoa" "libgtop" "libgudev" "libibus" "libmalcontent" "libmm-glib" "libnm" "libnma-gtk4" "libpulse" "libpwquality" "libsecret" "libsoup3" "libwacom" "libx11" "libxi" "libxml2" "pango" "polkit" "smbclient" "sound-theme-freedesktop" "tecla" "udisks2" "upower" "wayland" "gnome-keybindings")
makedepends=("meson" "ninja" "glib2-devel" "git")
# Prepared by tools/build-settings-packages.py from pinned upstream sources.
source=("control-center-51.0.tar.zst" "nodalix-control-center-$pkgver.tar.zst")
sha256sums=("SKIP" "SKIP")
prepare() {
  python "$srcdir/gnome/control-center/apply.py" "$srcdir/control-center"
}
build() {
  export PYTHONPATH="$srcdir/control-center/subprojects/blueprint-compiler"
  meson setup "$srcdir/build" "$srcdir/control-center" --prefix=/usr --buildtype=release \
    -Dtests=false -Ddocumentation=false -Dsnap=false \
    -Ddistributor_logo=/usr/share/pixmaps/nodalix-logo.png \
    -Ddark_mode_distributor_logo=/usr/share/pixmaps/nodalix-logo.png
  meson compile -C "$srcdir/build"
}
package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
  # Arch ships these shared resources in the gnome-keybindings dependency.
  rm -r "$pkgdir/usr/share/gnome-control-center/keybindings"
  rm "$pkgdir/usr/share/pkgconfig/gnome-keybindings.pc"
  rm "$pkgdir/usr/share/gettext/its/gnome-keybindings.its" "$pkgdir/usr/share/gettext/its/gnome-keybindings.loc"
}
