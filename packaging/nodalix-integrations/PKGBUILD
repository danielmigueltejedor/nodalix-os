pkgname=nodalix-integrations
pkgver=0.2.4
pkgrel=2
pkgdesc="Nodalix desktop services independent of the compositor"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
depends=("python" "python-gobject" "evolution-data-server" "xdg-user-dirs" "rclone" "fuse3" "openssl" "fish")
optdepends=("vdirsyncer: external calendar synchronization")
source=("nodalix-integrations-$pkgver.tar.zst")
sha256sums=("SKIP")

package() {
    for helper in user-layout app-icons calendar-bridge security-status; do
        install -Dm755 "$srcdir/shell/scripts/nodalix-${helper}.py" "$pkgdir/usr/bin/nodalix-${helper}"
    done
    install -Dm755 "$srcdir/shell/scripts/nodalix-icloud-apply-icon.fish" "$pkgdir/usr/bin/nodalix-icloud-apply-icon"
    install -Dm755 "$srcdir/shell/scripts/nodalix-localsend.py" "$pkgdir/usr/lib/nodalix/nodalix-localsend.py"
    install -Dm755 "$srcdir/packaging/nodalix-shell/is-hyprland-session" "$pkgdir/usr/lib/nodalix/is-hyprland-session"
    for unit in nodalix-user-layout.service nodalix-user-layout.timer nodalix-user-layout.path \
                nodalix-app-icons.service nodalix-app-icons.timer nodalix-icloud-drive.service \
                nodalix-icloud-sync.service nodalix-icloud-sync.timer nodalix-localsend.service; do
        install -Dm644 "$srcdir/shell/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
    done
    # LocalSend's old receiver and icon rewrites are opt-in. GNOME uses
    # GLocalSend and the selected icon theme, without competing receivers.
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    for unit in nodalix-user-layout.timer nodalix-user-layout.path nodalix-icloud-drive.service nodalix-icloud-sync.timer; do
        ln -s "../$unit" "$pkgdir/usr/lib/systemd/user/default.target.wants/$unit"
    done
}
