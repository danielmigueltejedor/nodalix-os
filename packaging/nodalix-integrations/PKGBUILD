pkgname=nodalix-integrations
pkgver=0.3.1
pkgrel=1
pkgdesc="Nodalix desktop services independent of the compositor"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
depends=("python" "python-gobject" "evolution-data-server" "xdg-user-dirs" "rclone" "fuse3" "openssl" "fish" "vdirsyncer" "gtk3" "desktop-file-utils")
optdepends=("keyd: optional Super copy/paste/cut remapping" "gamemode: automatic performance requests for Steam games" "xorg-xprop: native Steam window association" "python-xlib: native GNOME frames for Craft applications" "openlogi: optional Logitech device agent")
source=("nodalix-integrations-$pkgver.tar.zst")
sha256sums=("SKIP")

package() {
    for helper in steam-auto-gamemode steam-desktop-sync; do
        install -Dm755 "$srcdir/integrations/scripts/$helper.py" "$pkgdir/usr/bin/$helper"
    done
    install -Dm644 "$srcdir/integrations/scripts/craft_gnome.py" "$pkgdir/usr/lib/nodalix/craft_gnome.py"
    install -Dm755 "$srcdir/integrations/scripts/craft-gnome-launch" "$pkgdir/usr/bin/craft-gnome-launch"
    for unit in steam-auto-gamemode.service steam-desktop-sync.service steam-desktop-sync.timer nodalix-craft-gnome.service; do
        install -Dm644 "$srcdir/integrations/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
    done
    install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    for unit in steam-auto-gamemode.service steam-desktop-sync.timer nodalix-craft-gnome.service; do
        ln -s "../$unit" "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/$unit"
    done
    for helper in user-layout app-icons calendar-bridge security-status keyboard-remap organize-apps icloud-renovar; do
        install -Dm755 "$srcdir/integrations/scripts/nodalix-${helper}.py" "$pkgdir/usr/bin/nodalix-${helper}"
    done
    install -Dm755 "$srcdir/integrations/scripts/nodalix-icloud-apply-icon.fish" "$pkgdir/usr/bin/nodalix-icloud-apply-icon"
    for unit in nodalix-user-layout.service nodalix-user-layout.timer nodalix-user-layout.path \
                nodalix-app-icons.service nodalix-app-icons.timer nodalix-icloud-drive.service \
                nodalix-icloud-sync.service nodalix-icloud-sync.timer; do
        install -Dm644 "$srcdir/integrations/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
    done
    install -Dm644 "$srcdir/integrations/assets/icloud-apple-official.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/icloud-apple-official.svg"
    install -Dm644 "$srcdir/integrations/assets/com.nodalix.iCloudAccess.desktop" "$pkgdir/usr/share/applications/com.nodalix.iCloudAccess.desktop"
    for unit in nodalix-app-organizer.service nodalix-app-organizer.path; do
        install -Dm644 "$srcdir/integrations/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
    done
    # No standalone legacy LocalSend receiver: GNOME owns discovery via GLocalSend.
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    for unit in nodalix-user-layout.timer nodalix-user-layout.path nodalix-app-organizer.path nodalix-icloud-drive.service nodalix-icloud-sync.timer; do
        ln -s "../$unit" "$pkgdir/usr/lib/systemd/user/default.target.wants/$unit"
    done
}
