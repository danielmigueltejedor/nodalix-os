_cleanup_legacy_phone_link_bluetooth() {
    local unit="nodalix-iphone-bluetooth.service"
    local path

    systemctl disable --now "$unit" >/dev/null 2>&1 || true

    for path in \
        /etc/systemd/system/"$unit" \
        /usr/lib/systemd/system/"$unit"
    do
        [[ -e "$path" || -L "$path" ]] || continue

        # Never delete a file owned by another package. This cleanup targets
        # only the old unowned Nodalix bootstrap unit.
        if pacman -Qo "$path" >/dev/null 2>&1; then
            continue
        fi

        rm -f -- "$path"
    done
}

_prepare_nodalix_phone_link() {
    _cleanup_legacy_phone_link_bluetooth
    systemctl daemon-reload >/dev/null 2>&1 || true

    local experimental_result
    experimental_result=$(
        /usr/lib/nodalix-phone-link/enable-bluez-experimental 2>/dev/null ||
        true
    )

    if ! systemctl is-active --quiet bluetooth.service; then
        return 0
    fi

    local restart_bluetooth=0

    if [[ "$experimental_result" == "enabled" ]]; then
        echo "Nodalix Phone Link: enabling BlueZ experimental API"
        restart_bluetooth=1
    fi

    if ! systemctl show bluetooth.service -p ExecStart --value 2>/dev/null |
        grep -q -- "--noplugin=hfp"; then
        echo "Nodalix Phone Link: reserving HFP for oFono"
        restart_bluetooth=1
    fi

    if (( restart_bluetooth )); then
        systemctl restart bluetooth.service || true
        sleep 1
    fi

    systemctl restart nodalix-phone-link-bluetooth.service || true
}

post_install() {
    _prepare_nodalix_phone_link
}

post_upgrade() {
    _prepare_nodalix_phone_link
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    if systemctl is-active --quiet bluetooth.service; then
        systemctl restart bluetooth.service || true
    fi
}
