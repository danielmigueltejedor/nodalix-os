pkgname=nodalix-video-wallpapers
pkgver=0.5.0
pkgrel=5
pkgdesc="GNOME 51 animated wallpaper player and Nodalix video collection"
arch=("any")
url="https://github.com/danielmigueltejedor/nodalix-os"
license=("GPL-3.0-or-later")
depends=("gnome-shell>=1:51" "gnome-shell<1:52" "gjs" "gtk4" "gst-plugin-gtk4" "gst-plugins-good" "gst-libav" "gst-plugin-va")
makedepends=("nodejs" "pnpm" "meson" "ninja" "gettext")
source=("hanabi-b18e041.tar.zst" "nodalix-video-wallpapers-$pkgver.tar.zst" "nodalix-animated-collection.tar.zst")
sha256sums=("SKIP" "SKIP" "SKIP")
prepare() {
  cd "$srcdir/hanabi"
  patch -p1 < "$srcdir/packaging/nodalix-video-wallpapers/gnome51.patch"
  cp "$srcdir/packaging/nodalix-video-wallpapers/pnpm-lock.yaml" .
  cp "$srcdir/gnome/lib/window-coverage.js" src/windowCoverage.js
}
build() {
  cd "$srcdir/hanabi"
  pnpm install --frozen-lockfile --ignore-scripts
  node build.js
  meson setup "$srcdir/build" . --prefix=/usr
  meson compile -C "$srcdir/build"
}
package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
  local shell_data="$pkgdir/usr/share/gnome-shell"
  local uuid='hanabi-extension@jeffshee.github.io'
  install -d "$shell_data/nodalix-runtime"
  mv "$shell_data/extensions/$uuid" "$shell_data/nodalix-runtime/"
  ln -s "../nodalix-runtime/$uuid" "$shell_data/extensions/$uuid"
  install -Dm644 "$srcdir/packaging/nodalix-video-wallpapers/90-nodalix-hanabi.gschema.override"     "$pkgdir/usr/share/glib-2.0/schemas/90-nodalix-hanabi.gschema.override"
  install -d "$pkgdir/usr/share/backgrounds/nodalix/animated" "$pkgdir/usr/share/nodalix/wallpaper-previews" "$pkgdir/usr/share/nodalix/wallpaper-stills"
  cp -a --no-preserve=ownership "$srcdir/collection/." "$pkgdir/usr/share/backgrounds/nodalix/animated/"
  cp -a --no-preserve=ownership "$srcdir/previews/." "$pkgdir/usr/share/nodalix/wallpaper-previews/"
  cp -a --no-preserve=ownership "$srcdir/stills/." "$pkgdir/usr/share/nodalix/wallpaper-stills/"
  ln -s animated "$pkgdir/usr/share/backgrounds/nodalix/Animados"
  install -Dm644 "$srcdir/gnome/settings/animated-collection.json" "$pkgdir/usr/share/nodalix/animated-collection.json"
}
