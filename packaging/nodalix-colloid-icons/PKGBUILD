pkgname=nodalix-colloid-icons
pkgver=0.5.1
pkgrel=1
_theme_commit=3c8f2f9f803af8eb1f2c976c10dad332348fa0ad
options=("!strip")
pkgdesc='Nodalix desktop icons: Colloid applications with Adwaita system symbols'
arch=('any')
url='https://github.com/danielmigueltejedor/nodalix-icon-theme'
license=('GPL-3.0-only')
depends=('adwaita-icon-theme' 'hicolor-icon-theme')
makedepends=('git' 'gtk-update-icon-cache')
source=("nodalix-icon-theme::git+https://github.com/danielmigueltejedor/nodalix-icon-theme.git#commit=$_theme_commit")
# Git sources are integrity-checked by their immutable commit ID.
sha256sums=('SKIP')

package() {
    cd "$srcdir/nodalix-icon-theme"
    bash install-nodalix.sh -d "$pkgdir/usr/share/icons" -n Nodalix-Icons
    install -Dm644 nodalix/legacy-icons.json "$pkgdir/usr/share/nodalix/icon-theme/legacy-icons.json"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
