pkgname=nodalix-colloid-icons
pkgver=0.5.1
pkgrel=4
_theme_commit=e31bcbd3d21f1aba80a7008497c36a873cda682a
options=("!strip")
pkgdesc='Nodalix desktop icons: Colloid applications with Adwaita system symbols'
arch=('any')
url='https://github.com/danielmigueltejedor/nodalix-icon-theme'
license=('GPL-3.0-only')
depends=('adwaita-icon-theme' 'hicolor-icon-theme')
makedepends=('gtk-update-icon-cache')
source=("nodalix-icon-theme-$_theme_commit.tar.gz::https://codeload.github.com/danielmigueltejedor/nodalix-icon-theme/tar.gz/$_theme_commit")
sha256sums=('dc74992e85c42541f6078969a5de21017325f863ac5daa6646a8f30887792572')

package() {
    cd "$srcdir/nodalix-icon-theme-$_theme_commit"
    bash install-nodalix.sh -d "$pkgdir/usr/share/icons" -n Nodalix-Icons
    # The pinned installer stages through mktemp, which leaves the theme 0700:
    # only root could read it and every app icon fell back to Adwaita.
    find "$pkgdir/usr/share/icons/Nodalix-Icons" -type d -exec chmod 0755 {} +
    find "$pkgdir/usr/share/icons/Nodalix-Icons" -type f -exec chmod 0644 {} +
    install -Dm644 nodalix/legacy-icons.json "$pkgdir/usr/share/nodalix/icon-theme/legacy-icons.json"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
