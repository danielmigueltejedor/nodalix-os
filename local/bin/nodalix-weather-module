#!/usr/bin/env python3
import json
import subprocess


def sh(cmd):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return ""


weather = sh("curl -fsS --max-time 1 'https://wttr.in/Palencia?format=%c|%t'")

if weather and "|" in weather:
    icon, temp = weather.split("|", 1)
    icon = icon.strip()
    temp = temp.strip().replace("+", "")
    text = (icon + " " + temp).strip()
else:
    text = " --"

print(json.dumps({
    "text": text,
    "tooltip": "Tiempo · popup próximamente",
    "class": "normal"
}))
