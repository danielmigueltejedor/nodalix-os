#!/usr/bin/env bash
set -euo pipefail

mode="${1:-toggle}"

device="$(hyprctl devices -j 2>/dev/null | jq -r '.mice[]?.name, .touchpads[]?.name' | grep -i 'touchpad' | head -n1 || true)"

if [[ -z "$device" ]]; then
  notify-send "Nodalix" "No se ha detectado touchpad"
  exit 0
fi

case "$mode" in
  on)
    hyprctl keyword "device[$device]:enabled" true
    ;;
  off)
    hyprctl keyword "device[$device]:enabled" false
    ;;
  toggle|*)
    notify-send "Nodalix" "Toggle touchpad pendiente de estado persistente"
    ;;
esac
