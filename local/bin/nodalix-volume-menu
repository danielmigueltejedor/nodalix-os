#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/Proyectos/nodalix-os/local/bin/nodalix-audio-menu-window"
LOG="/tmp/nodalix-audio-menu.log"
nodalix-close-popups "nodalix-audio-menu-window"

if pgrep -f "$APP" >/dev/null; then
  pkill -f "$APP" || true
  exit 0
fi

nohup "$APP" >"$LOG" 2>&1 &
~/.local/bin/nodalix-position-popup-right "nodalix-audio-menu-window" 14 >/dev/null 2>&1 &
