#!/usr/bin/env python3

import gi
import json
import subprocess
import sys
import threading
import urllib.parse
import urllib.request
import html
from pathlib import Path

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf


APP_TITLE = "Nodalia WPE Menu"

CONFIG_DIR = Path.home() / ".config/wpe-hypr"
STATE_FILE = CONFIG_DIR / "state.json"
ENV_FILE = CONFIG_DIR / "config.env"
LOG_FILE = Path("/tmp/wpe-menu.log")

DEFAULT_WPE_BIN = "/opt/linux-wallpaperengine/linux-wallpaperengine"
DEFAULT_ASSETS_DIR = "/data/SteamLibrary/steamapps/common/wallpaper_engine/assets"
DEFAULT_WORKSHOP_DIR = "/data/SteamLibrary/steamapps/workshop/content/431960"

WORKSHOP_APP_ID = "431960"
WORKSHOP_BASE_URL = "https://steamcommunity.com/app/431960/workshop/"
WORKSHOP_BROWSE_URL = "https://steamcommunity.com/workshop/browse/"


DEFAULT_STATE = {
    "settings": {
        "fps": 60,
        "scaling": "fill",
        "disable_mouse": True,
        "disable_parallax": True,
        "silent": True,
    },
    "monitors": {
        "DP-3": "/data/SteamLibrary/steamapps/workshop/content/431960/2888108773",
        "DP-2": "/data/SteamLibrary/steamapps/workshop/content/431960/3549235003",
    },
}


def log(msg):
    old = LOG_FILE.read_text(errors="ignore") if LOG_FILE.exists() else ""
    LOG_FILE.write_text(old + msg + "\n")


def sh(args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def parse_env_file():
    data = {}

    if not ENV_FILE.exists():
        return data

    for line in ENV_FILE.read_text(errors="ignore").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue

        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")

    return data


def cfg():
    env = parse_env_file()

    return {
        "wpe_bin": env.get("WPE_BIN", DEFAULT_WPE_BIN),
        "assets_dir": env.get("WPE_ASSETS_DIR", DEFAULT_ASSETS_DIR),
        "workshop_dir": env.get("WPE_WORKSHOP_DIR", DEFAULT_WORKSHOP_DIR),
    }


def ensure_state():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

    if not STATE_FILE.exists():
        STATE_FILE.write_text(json.dumps(DEFAULT_STATE, indent=2, ensure_ascii=False))

    return load_state()


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return json.loads(json.dumps(DEFAULT_STATE))


def save_state(state):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2, ensure_ascii=False))


def get_monitors():
    raw = sh(["hyprctl", "monitors", "-j"])

    try:
        data = json.loads(raw)
        names = [m.get("name") for m in data if m.get("name")]
        if names:
            return names
    except Exception:
        pass

    raw = sh(["hyprctl", "monitors"])
    names = []

    for line in raw.splitlines():
        if line.startswith("Monitor "):
            parts = line.split()
            if len(parts) >= 2:
                names.append(parts[1])

    return names or ["DP-3", "DP-2"]


def wallpaper_title(path):
    p = Path(path)

    for candidate in [
        p / "project.json",
        p / "scene.pkg.json",
    ]:
        if candidate.exists():
            try:
                data = json.loads(candidate.read_text(errors="ignore"))
                for key in ["title", "name", "workshoptitle"]:
                    if data.get(key):
                        return str(data[key])
            except Exception:
                pass

    return p.name


def scan_wallpapers():
    c = cfg()
    root = Path(c["workshop_dir"])

    if not root.exists():
        return []

    items = []

    for p in root.iterdir():
        if not p.is_dir():
            continue

        items.append({
            "id": p.name,
            "title": wallpaper_title(p),
            "path": str(p),
            "mtime": p.stat().st_mtime,
        })

    items.sort(key=lambda x: x["mtime"], reverse=True)
    return items


def assignment_path(value):
    if isinstance(value, dict):
        return value.get("path", "")
    return value or ""


def assignment_scaling(value, fallback="fill"):
    if isinstance(value, dict):
        return value.get("scaling", fallback)
    return fallback


def make_assignment(path, scaling):
    return {
        "path": path,
        "scaling": scaling or "fill",
    }


def current_process_args():
    return sh(["pgrep", "-af", "linux-wallpaperengine"])


def stop_engine():
    subprocess.run(
        ["pkill", "-f", "linux-wallpaperengine"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    GLib.usleep(350_000)


def build_engine_cmd(state):
    c = cfg()
    settings = state.get("settings", {})
    monitor_map = state.get("monitors", {})

    cmd = [c["wpe_bin"]]

    if settings.get("silent", True):
        cmd.append("--silent")

    cmd += [
        "--fps",
        str(int(settings.get("fps", 60))),
        "--assets-dir",
        c["assets_dir"],
    ]

    if settings.get("disable_mouse", True):
        cmd.append("--disable-mouse")

    if settings.get("disable_parallax", True):
        cmd.append("--disable-parallax")

    fallback_scaling = settings.get("scaling", "fill")
    active_monitors = set(get_monitors())

    for monitor, assignment in monitor_map.items():
        if monitor not in active_monitors:
            continue

        bg = assignment_path(assignment)
        scaling = assignment_scaling(assignment, fallback_scaling)

        if not bg or not Path(bg).exists():
            continue

        cmd += [
            "--scaling",
            scaling,
            "--screen-root",
            monitor,
            "--bg",
            bg,
        ]

    return cmd


def apply_state(state):
    save_state(state)
    stop_engine()

    cmd = build_engine_cmd(state)

    LOG_FILE.write_text("")
    log("Running: " + " ".join(cmd))

    if len(cmd) <= 6:
        log("No valid monitor/background assignments found")
        return False

    subprocess.Popen(
        cmd,
        stdout=open(LOG_FILE, "a"),
        stderr=subprocess.STDOUT,
    )
    return True


def restore_from_state():
    state = ensure_state()
    ok = apply_state(state)
    return 0 if ok else 1



def find_preview(path):
    base = Path(path)

    candidates = [
        base / "preview.jpg",
        base / "preview.jpeg",
        base / "preview.png",
        base / "preview.gif",
        base / "thumbnail.jpg",
        base / "thumbnail.png",
        base / "cover.jpg",
        base / "cover.png",
    ]

    # Wallpaper Engine a veces define preview en project.json.
    project = base / "project.json"
    if project.exists():
        try:
            data = json.loads(project.read_text(errors="ignore"))
            for key in ["preview", "previewfile", "thumbnail", "image"]:
                value = data.get(key)
                if value:
                    candidates.insert(0, base / value)
        except Exception:
            pass

    for c in candidates:
        if c.exists() and c.is_file():
            return str(c)

    # Fallback: buscar la primera imagen razonable en la carpeta principal.
    for ext in ["*.jpg", "*.jpeg", "*.png"]:
        found = list(base.glob(ext))
        if found:
            return str(found[0])

    return ""


def pixbuf_cover(path, target_w, target_h):
    if not path or not Path(path).exists():
        return None

    try:
        src = GdkPixbuf.Pixbuf.new_from_file(path)
        src_w = src.get_width()
        src_h = src.get_height()

        if src_w <= 0 or src_h <= 0:
            return None

        # Usamos ceil para garantizar que la imagen escalada nunca quede
        # más pequeña que el área objetivo por culpa del redondeo.
        import math

        scale = max(target_w / src_w, target_h / src_h)
        scaled_w = max(target_w, int(math.ceil(src_w * scale)))
        scaled_h = max(target_h, int(math.ceil(src_h * scale)))

        scaled = src.scale_simple(
            scaled_w,
            scaled_h,
            GdkPixbuf.InterpType.BILINEAR,
        )

        if not scaled:
            return None

        # Clamp defensivo para evitar recortes fuera del pixbuf.
        crop_w = min(target_w, scaled.get_width())
        crop_h = min(target_h, scaled.get_height())
        crop_x = max(0, int((scaled.get_width() - crop_w) / 2))
        crop_y = max(0, int((scaled.get_height() - crop_h) / 2))

        out = GdkPixbuf.Pixbuf.new(
            scaled.get_colorspace(),
            scaled.get_has_alpha(),
            scaled.get_bits_per_sample(),
            crop_w,
            crop_h,
        )

        scaled.copy_area(crop_x, crop_y, crop_w, crop_h, out, 0, 0)
        return out
    except Exception:
        return None


def open_workshop_steam():
    subprocess.Popen(
        ["xdg-open", "steam://url/SteamWorkshopPage/431960"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def open_url(url):
    subprocess.Popen(
        ["xdg-open", url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def open_workshop_item_steam(item_id):
    open_url(f"steam://url/CommunityFilePage/{item_id}")


def open_workshop_item_browser(item_id):
    open_url(f"https://steamcommunity.com/sharedfiles/filedetails/?id={item_id}")


def workshop_cache_dir():
    d = CONFIG_DIR / "workshop-cache"
    d.mkdir(parents=True, exist_ok=True)
    return d


def fetch_url(url):
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 wpe-menu",
            "Accept-Language": "es-ES,es;q=0.9,en;q=0.8",
        },
    )

    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read()


def extract_workshop_results(page_html, limit=36):
    import re

    ids = []
    seen = set()

    # Solo extraemos IDs desde el HTML.
    # Las miniaturas/títulos se piden después a Steam API para evitar previews corridas.
    patterns = [
        r'sharedfiles/filedetails/\?id=(\d+)',
        r'filedetails/\?id=(\d+)',
        r'data-publishedfileid="(\d+)"',
        r'id="Subscription(\d+)"',
    ]

    for pattern in patterns:
        for m in re.finditer(pattern, page_html):
            item_id = m.group(1)

            if item_id in seen:
                continue

            seen.add(item_id)
            ids.append(item_id)

            if len(ids) >= limit:
                break

        if len(ids) >= limit:
            break

    return ids

def fetch_workshop_details(item_ids):
    if not item_ids:
        return []

    data = {
        "itemcount": str(len(item_ids)),
    }

    for idx, item_id in enumerate(item_ids):
        data[f"publishedfileids[{idx}]"] = str(item_id)

    body = urllib.parse.urlencode(data).encode("utf-8")

    req = urllib.request.Request(
        "https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/",
        data=body,
        headers={
            "User-Agent": "Mozilla/5.0 wpe-menu",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )

    with urllib.request.urlopen(req, timeout=20) as r:
        raw = r.read().decode("utf-8", errors="ignore")

    payload = json.loads(raw)
    details = payload.get("response", {}).get("publishedfiledetails", [])

    results = []

    for item in details:
        item_id = str(item.get("publishedfileid", "")).strip()

        if not item_id:
            continue

        title = html.unescape(str(item.get("title") or f"Workshop item {item_id}")).strip()
        preview_url = str(item.get("preview_url") or "").strip()

        if preview_url.startswith("//"):
            preview_url = "https:" + preview_url

        results.append({
            "id": item_id,
            "title": title,
            "url": f"https://steamcommunity.com/sharedfiles/filedetails/?id={item_id}",
            "steam_url": f"steam://url/CommunityFilePage/{item_id}",
            "preview_url": preview_url,
            "preview": "",
        })

    return results


def download_workshop_preview(item):
    url = item.get("preview_url") or ""

    if not url:
        return item

    try:
        ext = ".jpg"
        clean_url = url.split("?")[0].lower()

        if clean_url.endswith(".png"):
            ext = ".png"
        elif clean_url.endswith(".webp"):
            ext = ".webp"
        elif clean_url.endswith(".gif"):
            ext = ".gif"

        target = workshop_cache_dir() / f"{item['id']}{ext}"

        if not target.exists() or target.stat().st_size == 0:
            data = fetch_url(url)
            target.write_bytes(data)

        item["preview"] = str(target)
    except Exception:
        item["preview"] = ""

    return item


def search_workshop(query, limit=36):
    q = query.strip()

    params = {
        "appid": WORKSHOP_APP_ID,
        "browsesort": "trend",
        "section": "readytouseitems",
        "actualsort": "trend",
        "p": "1",
    }

    if q:
        params["searchtext"] = q

    url = WORKSHOP_BROWSE_URL + "?" + urllib.parse.urlencode(params)
    raw = fetch_url(url).decode("utf-8", errors="ignore")

    item_ids = extract_workshop_results(raw, limit=limit)
    results = fetch_workshop_details(item_ids)

    enriched = []
    for item in results:
        enriched.append(download_workshop_preview(item))

    return enriched

