class PillSelect(Gtk.MenuButton):
    def __init__(self):
        super().__init__()
        self.set_name("pill_select")
        self.items = []
        self.active_index = -1
        self.changed_callbacks = []

        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        outer.set_name("pill_select_inner")

        self.label = Gtk.Label(label="Seleccionar", xalign=0)
        self.label.set_name("pill_select_label")
        outer.pack_start(self.label, True, True, 0)

        arrow = Gtk.Label(label="⌄")
        arrow.set_name("pill_select_arrow")
        outer.pack_end(arrow, False, False, 0)

        self.add(outer)

        self.popover = Gtk.Popover()
        self.popover.set_name("pill_select_popover")

        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.list_box.set_name("pill_select_list")
        self.popover.add(self.list_box)

        self.set_popover(self.popover)

    def append_text(self, text):
        index = len(self.items)
        self.items.append(text)

        btn = Gtk.Button(label=text)
        btn.set_name("pill_select_item")
        btn.connect("clicked", lambda _b, i=index: self._select(i))
        self.list_box.pack_start(btn, False, False, 0)
        self.list_box.show_all()

    def set_active(self, index):
        if index < 0 or index >= len(self.items):
            return

        self.active_index = index
        self.label.set_text(self.items[index])

    def get_active_text(self):
        if 0 <= self.active_index < len(self.items):
            return self.items[self.active_index]
        return None

    def connect_changed(self, callback):
        self.changed_callbacks.append(callback)

    def _select(self, index):
        self.set_active(index)
        self.popover.popdown()

        for cb in self.changed_callbacks:
            cb(self)



class WpeMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)

        # Que Hyprland la trate más como popup/app flotante que como ventana tileada.
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Tamaño más contenido, no todo el ancho.
        self.set_default_size(940, 560)
        self.resize(940, 560)
        self.set_resizable(True)
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)

        self.state = ensure_state()
        self.wallpapers = scan_wallpapers()
        self.selected_wallpaper = None

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_name("root")
        self.add(root)

        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        root.pack_start(header, False, False, 0)

        title = Gtk.Label(xalign=0)
        title.set_name("title")
        title.set_markup("<b>Wallpaper Engine</b>")
        header.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(xalign=0)
        subtitle.set_name("subtitle")
        subtitle.set_text("Gestor persistente de fondos por monitor")
        header.pack_start(subtitle, False, False, 0)

        nav = Gtk.Box(spacing=8)
        nav.set_name("nav")
        root.pack_start(nav, False, False, 0)

        btn_wallpapers = Gtk.Button(label="󰸉 Fondos")
        btn_perf = Gtk.Button(label="󰓅 Rendimiento")
        btn_status = Gtk.Button(label="󰒡 Estado")
        btn_search = Gtk.Button(label="󰍉 Buscador")
        btn_search.set_tooltip_text("Buscar fondos en Steam Workshop")
        btn_workshop = Gtk.Button(label="󰓓 Workshop")
        btn_workshop.set_tooltip_text("Abrir Workshop de Wallpaper Engine en Steam")

        nav.pack_start(btn_wallpapers, False, False, 0)
        nav.pack_start(btn_perf, False, False, 0)
        nav.pack_start(btn_status, False, False, 0)
        nav.pack_start(btn_search, False, False, 0)
        nav.pack_end(btn_workshop, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        root.pack_start(self.stack, True, True, 0)

        self.build_wallpapers_page()
        self.build_search_page()
        self.build_performance_page()
        self.build_status_page()

        btn_wallpapers.connect(
            "clicked",
            lambda _b: self.stack.set_visible_child_name("wallpapers"),
        )
        btn_perf.connect(
            "clicked",
            lambda _b: self.stack.set_visible_child_name("performance"),
        )
        btn_status.connect(
            "clicked",
            lambda _b: self.refresh_status_page() or self.stack.set_visible_child_name("status"),
        )
        btn_search.connect("clicked", lambda _b: self.show_search_page())
        btn_workshop.connect("clicked", lambda _b: open_workshop_steam())
        btn_workshop.connect("clicked", lambda _b: open_workshop_steam())

        bottom = Gtk.Box(spacing=10)
        root.pack_end(bottom, False, False, 0)

        restore_btn = Gtk.Button(label="Restaurar actual")
        restore_btn.connect("clicked", lambda _b: self.restore_current())

        close_btn = Gtk.Button(label="Cerrar")
        close_btn.connect("clicked", lambda _b: Gtk.main_quit())

        bottom.pack_start(restore_btn, False, False, 0)
        bottom.pack_end(close_btn, False, False, 0)

        self.stack.set_visible_child_name("wallpapers")

    def on_key(self, _w, event):
        if event.keyval == 65307:
            Gtk.main_quit()

    def build_wallpapers_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page.pack_start(left, True, True, 0)

        top = Gtk.Box(spacing=10)
        left.pack_start(top, False, False, 0)

        search = Gtk.SearchEntry()
        search.set_placeholder_text("Buscar fondo por ID o nombre…")
        search.connect("search-changed", self.on_search)
        top.pack_start(search, True, True, 0)

        refresh_btn = Gtk.Button(label="Actualizar")
        refresh_btn.connect("clicked", lambda _b: self.reload_wallpapers())
        top.pack_start(refresh_btn, False, False, 0)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_size_request(640, 390)
        left.pack_start(scroller, True, True, 0)

        self.wallpaper_flow = Gtk.FlowBox()
        self.wallpaper_flow.set_valign(Gtk.Align.START)
        self.wallpaper_flow.set_column_spacing(6)
        self.wallpaper_flow.set_row_spacing(6)
        self.wallpaper_flow.set_max_children_per_line(4)
        self.wallpaper_flow.set_min_children_per_line(3)
        self.wallpaper_flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.wallpaper_flow.set_activate_on_single_click(True)
        self.wallpaper_flow.connect("child-activated", self.on_wallpaper_child_activated)
        self.wallpaper_flow.connect("selected-children-changed", self.on_wallpaper_selection_changed)
        scroller.add(self.wallpaper_flow)

        # Panel de detalle derecho.
        detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        detail.set_name("detail_panel")
        detail.set_size_request(250, -1)
        page.pack_start(detail, False, False, 0)

        self.detail_image = Gtk.Image()
        self.detail_image.set_size_request(240, 135)
        detail.pack_start(self.detail_image, False, False, 0)

        self.detail_title = Gtk.Label(xalign=0)
        self.detail_title.set_name("detail_title")
        self.detail_title.set_line_wrap(True)
        self.detail_title.set_text("Selecciona un fondo")
        detail.pack_start(self.detail_title, False, False, 0)

        self.detail_meta = Gtk.Label(xalign=0)
        self.detail_meta.set_name("detail_meta")
        self.detail_meta.set_line_wrap(True)
        self.detail_meta.set_selectable(True)
        self.detail_meta.set_text("Elige un fondo del mosaico para ver sus detalles.")
        detail.pack_start(self.detail_meta, False, False, 0)

        monitor_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        detail.pack_start(monitor_row, False, False, 0)

        monitor_label = Gtk.Label(xalign=0)
        monitor_label.set_name("small")
        monitor_label.set_text("Monitor")
        monitor_row.pack_start(monitor_label, False, False, 0)

        self.monitor_combo = PillSelect()
        self.monitor_combo.set_name("wpe_selector")
        self.monitor_combo.set_name("wpe_selector")
        self.monitor_combo.append_text("Todos")
        for m in get_monitors():
            self.monitor_combo.append_text(m)
        self.monitor_combo.set_active(0)
        self.monitor_combo.connect_changed(lambda _c: self.sync_scaling_from_current_assignment())
        monitor_row.pack_start(self.monitor_combo, False, False, 0)

        scaling_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        detail.pack_start(scaling_row, False, False, 0)

        scaling_label = Gtk.Label(xalign=0)
        scaling_label.set_name("small")
        scaling_label.set_text("Escalado para este fondo")
        scaling_row.pack_start(scaling_label, False, False, 0)

        self.detail_scaling_combo = PillSelect()
        self.detail_scaling_combo.set_name("wpe_selector")
        self.detail_scaling_combo.set_name("wpe_selector")
        for item in ["fill", "fit", "stretch"]:
            self.detail_scaling_combo.append_text(item)
        self.detail_scaling_combo.set_active(0)
        scaling_row.pack_start(self.detail_scaling_combo, False, False, 0)

        self.apply_button = Gtk.Button(label="Aplicar")
        self.apply_button.set_name("primary_button")
        self.apply_button.connect("clicked", lambda _b: self.apply_selected())
        self.apply_button.set_sensitive(False)
        detail.pack_start(self.apply_button, False, False, 0)

        self.selection_label = Gtk.Label(xalign=0)
        self.selection_label.set_name("small")
        self.selection_label.set_line_wrap(True)
        self.selection_label.set_text("La ventana no se cerrará al aplicar.")
        detail.pack_start(self.selection_label, False, False, 0)

        detail.pack_end(Gtk.Label(label=""), True, True, 0)

        self.populate_wallpapers("")
        self.stack.add_named(page, "wallpapers")

    def make_wallpaper_tile(self, item):
        child = Gtk.FlowBoxChild()
        child.item = item
        child.set_tooltip_text(f"{item['title']} · {item['id']}")

        tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        tile.set_name("wallpaper_tile")
        child.add(tile)

        preview_path = find_preview(item["path"])
        item["preview"] = preview_path

        image = Gtk.Image()
        pix = pixbuf_cover(preview_path, 158, 89)

        if pix:
            image.set_from_pixbuf(pix)
        else:
            image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)

        # El tile queda ajustado a la miniatura, sin texto debajo.
        tile.pack_start(image, False, False, 0)

        return child


    def populate_wallpapers(self, query):
        for child in self.wallpaper_flow.get_children():
            self.wallpaper_flow.remove(child)

        q = query.lower().strip()

        for item in self.wallpapers:
            label_text = f"{item['title']} · {item['id']} · {item['path']}"
            if q and q not in label_text.lower():
                continue

            self.wallpaper_flow.add(self.make_wallpaper_tile(item))

        self.wallpaper_flow.show_all()

    def reload_wallpapers(self):
        self.wallpapers = scan_wallpapers()
        self.populate_wallpapers("")
        self.selected_wallpaper = None
        self.update_detail_panel(None)

    def on_search(self, entry):
        self.populate_wallpapers(entry.get_text())

    def on_wallpaper_child_activated(self, _flow, child):
        if not child:
            return

        self.selected_wallpaper = child.item
        self.update_detail_panel(child.item)

    def on_wallpaper_selection_changed(self, flow):
        selected = flow.get_selected_children()

        if not selected:
            return

        child = selected[0]
        self.selected_wallpaper = child.item
        self.update_detail_panel(child.item)

    def update_detail_panel(self, item):
        if not item:
            self.detail_image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            self.detail_title.set_text("Selecciona un fondo")
            self.detail_meta.set_text("Elige un fondo del mosaico para ver sus detalles.")
            self.selection_label.set_text("La ventana no se cerrará al aplicar.")
            self.apply_button.set_sensitive(False)
            return

        preview_path = item.get("preview") or find_preview(item["path"])
        pix = pixbuf_cover(preview_path, 240, 135)

        if pix:
            self.detail_image.set_from_pixbuf(pix)
        else:
            self.detail_image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)

        self.detail_title.set_text(item["title"])
        self.detail_meta.set_text(
            f"ID: {item['id']}\n"
            f"Ruta:\n{item['path']}"
        )
        self.selection_label.set_text("Listo para aplicar.")
        self.apply_button.set_sensitive(True)

    def selected_scaling(self):
        if hasattr(self, "detail_scaling_combo"):
            return self.detail_scaling_combo.get_active_text() or "fill"
        return "fill"

    def set_detail_scaling(self, value):
        values = ["fill", "fit", "stretch"]
        if value not in values:
            value = "fill"

        if hasattr(self, "detail_scaling_combo"):
            self.detail_scaling_combo.set_active(values.index(value))

    def sync_scaling_from_current_assignment(self):
        if not hasattr(self, "detail_scaling_combo"):
            return

        state = load_state()
        monitors = state.get("monitors", {})
        fallback = state.get("settings", {}).get("scaling", "fill")
        monitor = self.selected_monitor_name()

        if monitor != "Todos" and monitor in monitors:
            self.set_detail_scaling(assignment_scaling(monitors.get(monitor), fallback))
        else:
            self.set_detail_scaling(fallback)


    def selected_monitor_name(self):
        return self.monitor_combo.get_active_text() or "Todos"

    def apply_selected(self):
        if not self.selected_wallpaper:
            self.selection_label.set_text("No hay ningún fondo seleccionado.")
            return

        monitor = self.selected_monitor_name()
        bg = self.selected_wallpaper["path"]

        self.state = load_state()
        self.state.setdefault("monitors", {})

        scaling = self.selected_scaling()

        if monitor == "Todos":
            for m in get_monitors():
                self.state["monitors"][m] = make_assignment(bg, scaling)
        else:
            self.state["monitors"][monitor] = make_assignment(bg, scaling)

        ok = apply_state(self.state)

        if ok:
            self.selection_label.set_text(
                f"Aplicado en {monitor}: {self.selected_wallpaper['title']}"
            )
        else:
            self.selection_label.set_text("No se pudo aplicar. Mira /tmp/wpe-menu.log")


