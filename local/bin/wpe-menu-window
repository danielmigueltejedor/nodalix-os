    def show_search_page(self):
        self.stack.set_visible_child_name("search")

        if not getattr(self, "workshop_loaded_once", False):
            self.workshop_loaded_once = True
            self.workshop_search_entry.set_text("")
            self.run_workshop_search()


    def run_workshop_search(self):
        query = self.workshop_search_entry.get_text().strip()
        self.workshop_status_label.set_text("Cargando tendencias de Steam Workshop…" if not query else "Buscando en Steam Workshop…")
        self.clear_workshop_results()

        def worker():
            try:
                results = search_workshop(query, limit=36)
                GLib.idle_add(self.populate_workshop_results, results)
            except Exception as e:
                GLib.idle_add(self.workshop_status_label.set_text, f"No se pudo buscar: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def clear_workshop_results(self):
        for child in self.workshop_flow.get_children():
            self.workshop_flow.remove(child)

        self.workshop_flow.show_all()

    def populate_workshop_results(self, results):
        self.clear_workshop_results()

        if not results:
            self.workshop_status_label.set_text("No se encontraron resultados.")
            return False

        for item in results:
            self.workshop_flow.add(self.make_workshop_tile(item))

        self.workshop_flow.show_all()
        self.workshop_status_label.set_text(f"{len(results)} resultados encontrados.")
        return False

    def make_workshop_tile(self, item):
        child = Gtk.FlowBoxChild()
        child.item = item
        child.set_tooltip_text(f"{item.get('title', '')} · {item.get('id', '')}")

        tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        tile.set_name("workshop_result_tile")
        child.add(tile)

        image = Gtk.Image()
        pix = pixbuf_cover(item.get("preview", ""), 158, 89)

        if pix:
            image.set_from_pixbuf(pix)
        else:
            image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)

        tile.pack_start(image, False, False, 0)
        return child

    def on_workshop_child_activated(self, _flow, child):
        if not child:
            return

        self.selected_workshop_item = child.item
        self.update_workshop_detail(child.item)

    def on_workshop_selection_changed(self, flow):
        selected = flow.get_selected_children()

        if not selected:
            return

        child = selected[0]
        self.selected_workshop_item = child.item
        self.update_workshop_detail(child.item)

    def update_workshop_detail(self, item):
        if not item:
            self.workshop_detail_image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            self.workshop_detail_title.set_text("Busca un fondo")
            self.workshop_detail_meta.set_text("Selecciona un resultado para abrirlo en Steam.")
            self.workshop_open_steam_btn.set_sensitive(False)
            self.workshop_open_browser_btn.set_sensitive(False)
            return

        pix = pixbuf_cover(item.get("preview", ""), 240, 135)

        if pix:
            self.workshop_detail_image.set_from_pixbuf(pix)
        else:
            self.workshop_detail_image.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)

        self.workshop_detail_title.set_text(item.get("title", "Workshop item"))
        self.workshop_detail_meta.set_text(
            f"ID: {item.get('id', '')}\n"
            "Abre el fondo en Steam, suscríbete y luego actualiza la biblioteca local."
        )
        self.workshop_open_steam_btn.set_sensitive(True)
        self.workshop_open_browser_btn.set_sensitive(True)

    def open_selected_workshop_steam(self):
        if not self.selected_workshop_item:
            return

        open_workshop_item_steam(self.selected_workshop_item.get("id", ""))

    def open_selected_workshop_browser(self):
        if not self.selected_workshop_item:
            return

        open_workshop_item_browser(self.selected_workshop_item.get("id", ""))


    def build_performance_page(self):
