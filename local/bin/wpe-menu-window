        self.fps_spin = Gtk.SpinButton()
        self.fps_spin.set_range(15, 144)
        self.fps_spin.set_increments(5, 10)
        self.fps_spin.set_value(int(settings.get("fps", 60)))
        row_fps.pack_start(self.fps_spin, False, False, 0)

        scaling_note = Gtk.Label(xalign=0)
        scaling_note.set_name("small")
        scaling_note.set_line_wrap(True)
        scaling_note.set_text(
            "El escalado ya no es global: se configura por fondo/monitor desde la pestaña Fondos."
        )
        page.pack_start(scaling_note, False, False, 0)

        self.disable_mouse = Gtk.CheckButton(label="Desactivar interacción del ratón")
        self.disable_mouse.set_active(bool(settings.get("disable_mouse", True)))
        page.pack_start(self.disable_mouse, False, False, 0)

        self.disable_parallax = Gtk.CheckButton(label="Desactivar parallax")
        self.disable_parallax.set_active(bool(settings.get("disable_parallax", True)))
        page.pack_start(self.disable_parallax, False, False, 0)

        hint = Gtk.Label(xalign=0)
        hint.set_name("small")
        hint.set_line_wrap(True)
        hint.set_text(
            "Recomendado para escritorio: 60 FPS, escalado fill, ratón y parallax "
            "desactivados. Si notas consumo alto de GPU, baja a 30 FPS."
        )
        page.pack_start(hint, False, False, 0)

        save_btn = Gtk.Button(label="Guardar y reaplicar")
        save_btn.set_name("primary_button")
        save_btn.connect("clicked", lambda _b: self.save_performance())
        page.pack_start(save_btn, False, False, 0)

        self.perf_label = Gtk.Label(xalign=0)
        self.perf_label.set_name("small")
        self.perf_label.set_text("")
        page.pack_start(self.perf_label, False, False, 0)

        self.stack.add_named(page, "performance")

    def save_performance(self):
        self.state = load_state()
        self.state.setdefault("settings", {})

        self.state["settings"]["fps"] = int(self.fps_spin.get_value())
        self.state["settings"].setdefault("scaling", "fill")
        self.state["settings"]["disable_mouse"] = self.disable_mouse.get_active()
        self.state["settings"]["disable_parallax"] = self.disable_parallax.get_active()
        self.state["settings"]["silent"] = True

        ok = apply_state(self.state)
        self.perf_label.set_text(
            "Ajustes aplicados." if ok else "No se pudo aplicar. Mira /tmp/wpe-menu.log"
        )

    def build_status_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        self.status_label = Gtk.Label(xalign=0, yalign=0)
        self.status_label.set_name("status_box")
        self.status_label.set_selectable(True)
        self.status_label.set_line_wrap(True)
        page.pack_start(self.status_label, True, True, 0)

        refresh_btn = Gtk.Button(label="Actualizar estado")
        refresh_btn.connect("clicked", lambda _b: self.refresh_status_page())
        page.pack_start(refresh_btn, False, False, 0)

        self.stack.add_named(page, "status")
        self.refresh_status_page()

    def refresh_status_page(self):
        state = load_state()
        monitors = state.get("monitors", {})
        settings = state.get("settings", {})
        process = current_process_args()

        lines = []
        lines.append("Monitores detectados:")
        for m in get_monitors():
            lines.append(f"  · {m}")

        lines.append("")
        lines.append("Fondos asignados:")
        fallback_scaling = settings.get("scaling", "fill")
        for monitor, assignment in monitors.items():
            bg = assignment_path(assignment)
            scaling = assignment_scaling(assignment, fallback_scaling)
            lines.append(f"  · {monitor}: {Path(bg).name} · scaling={scaling}")

        lines.append("")
        lines.append("Rendimiento:")
        lines.append(f"  · FPS: {settings.get('fps', 60)}")
        lines.append(f"  · Escalado: {settings.get('scaling', 'fill')}")
        lines.append(f"  · Ratón desactivado: {settings.get('disable_mouse', True)}")
        lines.append(f"  · Parallax desactivado: {settings.get('disable_parallax', True)}")

        lines.append("")
        lines.append("Proceso actual:")
        lines.append(process if process else "  No hay linux-wallpaperengine activo.")

        self.status_label.set_text("\n".join(lines))
        return False

    def restore_current(self):
        self.state = load_state()
        apply_state(self.state)
        self.refresh_status_page()
        self.stack.set_visible_child_name("status")


if __name__ == "__main__":
    if "--restore" in sys.argv:
        raise SystemExit(restore_from_state())

    setup_css()
    win = WpeMenu()
    win.show_all()

    # Forzar comportamiento tipo popup flotante al abrir.

    Gtk.main()
