#!/usr/bin/env python3
import gi
import json
import os
import re
import subprocess
import sys
from pathlib import Path

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

THEME_FILE = Path.home() / ".config/nodalix/theme.json"
GTK_CSS = Path.home() / ".config/gtk-3.0/gtk.css"

PRESETS = {
    "purple": {
        "name": "Nodalix Purple",
        "hex": "#cba6f7",
        "rgba": "rgba(cba6f7ee)",
        "soft": "rgba(cba6f733)",
        "inactive": "rgba(31324455)",
    },
    "blue": {
        "name": "Nodalix Blue",
        "hex": "#89b4fa",
        "rgba": "rgba(89b4faee)",
        "soft": "rgba(89b4fa33)",
        "inactive": "rgba(31324455)",
    },
    "pink": {
        "name": "Nodalix Pink",
        "hex": "#f5c2e7",
        "rgba": "rgba(f5c2e7ee)",
        "soft": "rgba(f5c2e733)",
        "inactive": "rgba(31324455)",
    },
    "green": {
        "name": "Nodalix Green",
        "hex": "#a6e3a1",
        "rgba": "rgba(a6e3a1ee)",
        "soft": "rgba(a6e3a133)",
        "inactive": "rgba(31324455)",
    },
    "orange": {
        "name": "Nodalix Orange",
        "hex": "#fab387",
        "rgba": "rgba(fab387ee)",
        "soft": "rgba(fab38733)",
        "inactive": "rgba(31324455)",
    },
}


def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def sh(cmd):
    return subprocess.run(cmd, shell=True, text=True, capture_output=True)


def hex_to_rgba(hex_color, alpha="ee"):
    h = hex_color.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if not re.fullmatch(r"[0-9a-fA-F]{6}", h):
        raise ValueError(f"Color inválido: {hex_color}")
    return f"rgba({h.lower()}{alpha})"


def hex_to_soft(hex_color):
    h = hex_color.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    return f"rgba({h.lower()}33)"


def notify(title, body):
    run(f"notify-send {title!r} {body!r}")


def load_theme():
    if THEME_FILE.exists():
        try:
            return json.loads(THEME_FILE.read_text())
        except Exception:
            pass
    return PRESETS["purple"].copy()


def save_theme(theme):
    THEME_FILE.parent.mkdir(parents=True, exist_ok=True)
    THEME_FILE.write_text(json.dumps(theme, indent=2, ensure_ascii=False) + "\n")


def apply_hyprland(theme):
    rgba = theme["rgba"]
    inactive = theme.get("inactive", "rgba(31324455)")
    cmd = (
        "hyprctl eval "
        + repr(
            f'hl.config({{ general = {{ border_size = 3, ["col.active_border"] = "{rgba}", ["col.inactive_border"] = "{inactive}" }} }})'
        )
    )
    sh(cmd)


def apply_gtk(theme):
    GTK_CSS.parent.mkdir(parents=True, exist_ok=True)
    block = f"""
/* Nodalix accent color */
@define-color nodalix_accent {theme["hex"]};
@define-color accent_color {theme["hex"]};
@define-color accent_bg_color {theme["hex"]};
@define-color accent_fg_color #11111b;
"""
    existing = GTK_CSS.read_text() if GTK_CSS.exists() else ""
    existing = re.sub(
        r"/\* Nodalix accent color \*/.*?(?=\n/\*|\Z)",
        "",
        existing,
        flags=re.S,
    ).strip()
    GTK_CSS.write_text((existing + "\n\n" + block).strip() + "\n")


def apply_zen(theme):
    # Zen/Firefox solo respeta esto si userChrome.css está habilitado:
    # toolkit.legacyUserProfileCustomizations.stylesheets = true
    zen_dir = Path.home() / ".zen"
    if not zen_dir.exists():
        return

    for chrome_dir in zen_dir.glob("*/chrome"):
        chrome_dir.mkdir(parents=True, exist_ok=True)
        css = chrome_dir / "userChrome.css"
        block = f"""
/* Nodalix accent color */
:root {{
  --nodalix-accent: {theme["hex"]} !important;
  --zen-primary-color: {theme["hex"]} !important;
  --zen-colors-primary: {theme["hex"]} !important;
  --toolbarbutton-icon-fill-attention: {theme["hex"]} !important;
}}
"""
        existing = css.read_text() if css.exists() else ""
        existing = re.sub(
            r"/\* Nodalix accent color \*/.*?(?=\n/\*|\Z)",
            "",
            existing,
            flags=re.S,
        ).strip()
        css.write_text((existing + "\n\n" + block).strip() + "\n")


def apply_nodalix_apps(theme):
    # Archivo común para Nodalix Files y futuras apps.
    # Nodalix Files podrá leerlo desde frontend/Rust más adelante.
    apps_dir = Path.home() / ".config/nodalix"
    apps_dir.mkdir(parents=True, exist_ok=True)
    (apps_dir / "accent.css").write_text(f""":root {{
  --nodalix-accent: {theme["hex"]};
  --nodalix-accent-rgba: {theme["rgba"]};
  --nodalix-accent-soft: {theme["soft"]};
}}
""")


def apply_theme(theme):
    save_theme(theme)
    apply_hyprland(theme)
    apply_gtk(theme)
    apply_zen(theme)
    apply_nodalix_apps(theme)
    notify("Nodalix Accent", f"Color aplicado: {theme['name']} · {theme['hex']}")


def choose_custom():
    current = load_theme()
    dialog = Gtk.ColorChooserDialog(title="Elegir color de acento Nodalix")
    dialog.set_modal(True)

    response = dialog.run()
    if response == Gtk.ResponseType.OK:
        rgba = dialog.get_rgba()
        hex_color = "#{:02x}{:02x}{:02x}".format(
            int(rgba.red * 255),
            int(rgba.green * 255),
            int(rgba.blue * 255),
        )
        theme = {
            "name": "Custom",
            "hex": hex_color,
            "rgba": hex_to_rgba(hex_color),
            "soft": hex_to_soft(hex_color),
            "inactive": current.get("inactive", "rgba(31324455)"),
        }
        apply_theme(theme)

    dialog.destroy()


def main():
    if len(sys.argv) < 2:
        print("Uso: nodalix-accent-color [purple|blue|pink|green|orange|custom|show]")
        return

    arg = sys.argv[1].lower().strip()

    if arg == "show":
        print(json.dumps(load_theme(), indent=2, ensure_ascii=False))
        return

    if arg == "custom":
        choose_custom()
        return

    if arg not in PRESETS:
        print(f"Preset no válido: {arg}")
        sys.exit(1)

    theme = PRESETS[arg].copy()
    apply_theme(theme)


if __name__ == "__main__":
    main()
