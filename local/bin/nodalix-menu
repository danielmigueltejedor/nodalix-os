#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/.local/bin/nodalix-menu-window"
LOG="/tmp/nodalix-menu-window.log"

# Toggle exacto por clase
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "nodalix-menu-window")' >/dev/null; then
  pkill -f "nodalix-menu-window" 2>/dev/null || true
  exit 0
fi

# Comportamiento tipo popup: cerrar otros popups antes de abrir
nodalix-close-popups "nodalix-menu-window" 2>/dev/null || true
nodalix-close-center-popups "nodalix-menu-window" 2>/dev/null || true
pkill -f "nodalix-command-bar" 2>/dev/null || true

nohup "$APP" >"$LOG" 2>&1 &
