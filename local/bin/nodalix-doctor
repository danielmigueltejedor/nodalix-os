#!/usr/bin/env bash
set -euo pipefail

echo "== Nodalix Doctor =="

echo
echo "Desktop:"
echo "  XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unknown}"
echo "  HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-not running}"

echo
echo "Hyprland:"
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl version || true
else
  echo "  hyprctl not found"
fi

echo
echo "GPU:"
lspci -k | grep -A 4 -Ei "VGA|3D|Display" || true

echo
echo "Audio:"
systemctl --user is-active pipewire 2>/dev/null || true
systemctl --user is-active wireplumber 2>/dev/null || true

echo
echo "Waybar:"
pgrep -a waybar || echo "  waybar not running"

echo
echo "Portals:"
systemctl --user status xdg-desktop-portal --no-pager 2>/dev/null | head -20 || true
systemctl --user status xdg-desktop-portal-hyprland --no-pager 2>/dev/null | head -20 || true

echo
echo "Failed system units:"
systemctl --failed --no-pager || true

echo
echo "Failed user units:"
systemctl --user --failed --no-pager || true
