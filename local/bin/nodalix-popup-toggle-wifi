#!/usr/bin/env bash
set -euo pipefail

if command -v nodalix-wifi-menu >/dev/null 2>&1; then
  exec nodalix-wifi-menu
fi

if [ -x "$HOME/Proyectos/nodalix-os/local/bin/nodalix-wifi-menu" ]; then
  exec "$HOME/Proyectos/nodalix-os/local/bin/nodalix-wifi-menu"
fi

notify-send "Nodalix" "No encuentro nodalix-wifi-menu"
