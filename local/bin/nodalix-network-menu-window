#!/usr/bin/env python3

import gi
import subprocess
import shlex

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

APP_TITLE = "Nodalix Network"

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL, timeout=4).strip()
    except Exception:
        return ""

def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def has_cmd(cmd):
    return bool(sh("command -v " + cmd))

def active_status():
    raw = sh("nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status")
    connected = []

    for line in raw.splitlines():
        parts = line.split(":", 3)
        if len(parts) != 4:
            continue
        device, kind, state, connection = parts
        if state == "connected":
            connected.append((device, kind, connection))

    if not connected:
        return "Sin conexión", "No hay conexión de red activa"

    # Preferimos mostrar Ethernet si existe, si no Wi-Fi.
    for device, kind, connection in connected:
        if kind == "ethernet":
            return "Ethernet conectado", device + " · " + connection

    for device, kind, connection in connected:
        if kind == "wifi":
            signal = sh("nmcli -t -f IN-USE,SIGNAL dev wifi | awk -F: '$1==\"*\" {print $2; exit}'")
            suffix = " · " + signal + "%" if signal else ""
            return "Wi-Fi conectado", connection + suffix

    device, kind, connection = connected[0]
    return "Red conectada", device + " · " + connection

def wifi_enabled():
    return sh("nmcli radio wifi") == "enabled"

def set_wifi(enabled):
    run("nmcli radio wifi " + ("on" if enabled else "off"))

def scan_wifi():
    run("nmcli dev wifi rescan")

def wifi_networks():
    raw = sh("nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list")
    networks = []
    seen = set()

    for line in raw.splitlines():
        parts = line.split(":")
        if len(parts) < 4:
            continue

        in_use = parts[0] == "*"
        ssid = parts[1].strip()
        signal = parts[2].strip()
        security = ":".join(parts[3:]).strip()

        if not ssid or ssid in seen:
            continue

        seen.add(ssid)
        networks.append({
            "ssid": ssid,
            "signal": signal,
            "security": security,
            "active": in_use,
        })

    def score(n):
        try:
            return int(n["signal"])
        except Exception:
            return 0

    networks.sort(key=score, reverse=True)
    return networks[:12]

def connect_wifi(ssid):
    if not ssid:
        return

    safe_ssid = shlex.quote(ssid)
    run(f'nmcli dev wifi connect {safe_ssid} || notify-send "Nodalix Network" "No se pudo conectar. Si requiere contraseña, abre ajustes avanzados."')


def open_advanced_network_settings():
    # Futuro: nodalix-settings network
    if has_cmd("nm-connection-editor"):
        run("nm-connection-editor")
    elif has_cmd("impala"):
        run("alacritty -e impala")
    elif has_cmd("nmtui"):
        run("alacritty -e nmtui")
    else:
        run("notify-send \"Nodalix Network\" \"Ajustes avanzados de red todavía no implementados\"")

def setup_css():
    css = b"""
* {
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Adwaita Sans", "Cantarell", sans-serif;
  font-size: 13px;
  color: #cdd6f4;
}
window {
  background: transparent;
}
#root {
  background: rgba(17, 17, 27, 0.96);
  border: 1px solid rgba(137, 180, 250, 0.28);
  border-radius: 22px;
  padding: 16px;
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.48);
}
#title {
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
}
#subtitle {
  color: #a6adc8;
  font-size: 12px;
}
#card {
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 12px;
}
#network_row {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  padding: 9px 10px;
}
#network_row_active {
  background: rgba(137, 180, 250, 0.13);
  border: 1px solid rgba(137, 180, 250, 0.24);
  border-radius: 14px;
  padding: 9px 10px;
}
#row_title {
  color: #ffffff;
  font-weight: 800;
}
#row_subtitle {
  color: #a6adc8;
  font-size: 12px;
}
button {
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  padding: 7px 12px;
  box-shadow: none;
}
button:hover {
  background: rgba(137, 180, 250, 0.18);
  color: #ffffff;
}
#primary_button {
  background: rgba(137, 180, 250, 0.22);
  border: 1px solid rgba(137, 180, 250, 0.36);
  color: #ffffff;
}
#danger_button {
  background: rgba(243, 139, 168, 0.14);
  border: 1px solid rgba(243, 139, 168, 0.28);
}
#success_badge {
  background: rgba(166, 227, 161, 0.16);
  border: 1px solid rgba(166, 227, 161, 0.28);
  border-radius: 999px;
  padding: 4px 8px;
  color: #d9ffcf;
}
"""
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

class NetworkMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)
        self.set_default_size(480, 460)
        self.set_resizable(False)
        self.set_decorated(False)
        # Nace fuera de pantalla; nodalix-popup-toggle la coloca bajo su isla.
        self.move(-20000, -20000)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)

        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.root.set_name("root")
        self.add(self.root)

        title = Gtk.Label(xalign=0)
        title.set_name("title")
        title.set_text("󰖩 Red")
        self.root.pack_start(title, False, False, 0)

        self.subtitle = Gtk.Label(xalign=0)
        self.subtitle.set_name("subtitle")
        self.root.pack_start(self.subtitle, False, False, 0)

        self.status_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.status_card.set_name("card")
        self.root.pack_start(self.status_card, False, False, 0)

        self.status_label = Gtk.Label(xalign=0)
        self.status_label.set_name("row_title")
        self.status_card.pack_start(self.status_label, True, True, 0)

        self.wifi_button = Gtk.Button(label="")
        self.wifi_button.connect("clicked", self.on_wifi_clicked)
        self.status_card.pack_start(self.wifi_button, False, False, 0)

        self.networks_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.networks_card.set_name("card")
        self.root.pack_start(self.networks_card, True, True, 0)

        networks_title = Gtk.Label(xalign=0)
        networks_title.set_name("row_title")
        networks_title.set_text("Redes Wi-Fi")
        self.networks_card.pack_start(networks_title, False, False, 0)

        self.networks_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        self.networks_card.pack_start(self.networks_box, True, True, 0)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.root.pack_end(footer, False, False, 0)

        refresh = Gtk.Button(label="Escanear")
        refresh.connect("clicked", self.on_refresh_clicked)
        footer.pack_start(refresh, False, False, 0)

        advanced = Gtk.Button(label="Ajustes avanzados de red")
        advanced.set_name("primary_button")
        advanced.connect("clicked", lambda _b: open_advanced_network_settings())
        footer.pack_start(advanced, True, True, 0)

        close = Gtk.Button(label="Cerrar")
        close.connect("clicked", lambda _b: Gtk.main_quit())
        footer.pack_start(close, False, False, 0)

        self.refresh()

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False

    def clear_networks(self):
        for child in self.networks_box.get_children():
            self.networks_box.remove(child)

    def refresh(self):
        title, subtitle = active_status()
        self.status_label.set_text(title)
        self.subtitle.set_text(subtitle)

        enabled = wifi_enabled()
        self.wifi_button.set_label("Desactivar Wi-Fi" if enabled else "Activar Wi-Fi")
        self.wifi_button.set_name("danger_button" if enabled else "primary_button")

        self.clear_networks()

        if not enabled:
            label = Gtk.Label(xalign=0)
            label.set_name("row_subtitle")
            label.set_text("Activa Wi-Fi para ver redes disponibles.")
            self.networks_box.pack_start(label, False, False, 0)
            self.networks_box.show_all()
            return False

        networks = wifi_networks()
        if not networks:
            label = Gtk.Label(xalign=0)
            label.set_name("row_subtitle")
            label.set_text("No hay redes Wi-Fi visibles.")
            self.networks_box.pack_start(label, False, False, 0)
            self.networks_box.show_all()
            return False

        for network in networks:
            self.networks_box.pack_start(self.make_network_row(network), False, False, 0)

        self.networks_box.show_all()
        return False

    def make_network_row(self, network):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_name("network_row_active" if network["active"] else "network_row")

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        row.pack_start(text, True, True, 0)

        title = Gtk.Label(xalign=0)
        title.set_name("row_title")
        title.set_text(network["ssid"])
        text.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(xalign=0)
        subtitle.set_name("row_subtitle")
        sec = network["security"] if network["security"] else "abierta"
        subtitle.set_text("Señal " + network["signal"] + "% · " + sec)
        text.pack_start(subtitle, False, False, 0)

        if network["active"]:
            badge = Gtk.Label(label="Conectada")
            badge.set_name("success_badge")
            row.pack_start(badge, False, False, 0)
        else:
            btn = Gtk.Button(label="Conectar")
            btn.set_name("primary_button")
            btn.connect("clicked", lambda _b, ssid=network["ssid"]: self.connect_and_refresh(ssid))
            row.pack_start(btn, False, False, 0)

        return row

    def connect_and_refresh(self, ssid):
        connect_wifi(ssid)
        GLib.timeout_add(1800, self.refresh)

    def on_wifi_clicked(self, _button):
        set_wifi(not wifi_enabled())
        GLib.timeout_add(900, self.refresh)

    def on_refresh_clicked(self, _button):
        scan_wifi()
        GLib.timeout_add(1800, self.refresh)

if __name__ == "__main__":
    setup_css()
    win = NetworkMenu()
    win.show_all()
    Gtk.main()
