#!/usr/bin/env sh
set -eu

APP_DIR="/home/dani/Proyectos/nodalix-os/apps/nodalix-bar"
RELEASE="$APP_DIR/target/release/nodalix-bar"
DEBUG="$APP_DIR/target/debug/nodalix-bar"

if [ -x "$RELEASE" ]; then
  exec "$RELEASE" "$@"
fi

if [ -x "$DEBUG" ]; then
  exec "$DEBUG" "$@"
fi

cd "$APP_DIR"
exec cargo run -- "$@"

