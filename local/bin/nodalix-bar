#!/usr/bin/env sh
set -eu

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
APP_DIR="$ROOT_DIR/apps/nodalix-bar"
RELEASE="$APP_DIR/target/release/nodalix-bar"
DEBUG="$APP_DIR/target/debug/nodalix-bar"

if [ -x "$RELEASE" ]; then
  exec "$RELEASE" "$@"
fi

if [ -x "$DEBUG" ]; then
  exec "$DEBUG" "$@"
fi

cd "$APP_DIR"
exec cargo run -- "$@"
