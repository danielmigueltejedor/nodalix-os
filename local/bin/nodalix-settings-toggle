#!/usr/bin/env bash
set -u

LOG="/tmp/nodalix-settings-toggle.log"

APP_RELEASE="$HOME/Projects/nodalix-os/apps/nodalix-settings/target/release/nodalix-settings"
APP_DEBUG="$HOME/Projects/nodalix-os/apps/nodalix-settings/target/debug/nodalix-settings"
APP_DIR="$HOME/Projects/nodalix-os/apps/nodalix-settings"

echo "---- $(date) ----" >> "$LOG"

clients_json="$(hyprctl clients -j 2>/dev/null || echo '[]')"

pids="$(
  printf '%s' "$clients_json" | jq -r '
    .[] |
    select(
      (.class // "") == "os.nodalix.Settings" or
      (.initialClass // "") == "os.nodalix.Settings" or
      (.title // "") == "Nodalix Settings" or
      (.initialTitle // "") == "Nodalix Settings"
    ) |
    .pid
  ' | grep -E '^[0-9]+$' | sort -u
)"

if [[ -n "${pids:-}" ]]; then
  echo "Closing existing Nodalix Settings pids: $pids" >> "$LOG"

  while read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done <<< "$pids"

  exit 0
fi

if [[ -x "$APP_RELEASE" ]]; then
  echo "Opening release: $APP_RELEASE" >> "$LOG"
  nohup "$APP_RELEASE" >> "$LOG" 2>&1 &
  exit 0
fi

if [[ -x "$APP_DEBUG" ]]; then
  echo "Opening debug: $APP_DEBUG" >> "$LOG"
  nohup "$APP_DEBUG" >> "$LOG" 2>&1 &
  exit 0
fi

if [[ -d "$APP_DIR" && -f "$APP_DIR/Cargo.toml" ]]; then
  echo "Opening via cargo run in: $APP_DIR" >> "$LOG"
  nohup bash -lc "cd '$APP_DIR' && cargo run" >> "$LOG" 2>&1 &
  exit 0
fi

echo "ERROR: Nodalix Settings app not found" >> "$LOG"
notify-send "Nodalix Settings" "No encuentro la app"
exit 1
