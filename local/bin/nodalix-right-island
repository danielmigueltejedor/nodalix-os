#!/usr/bin/env python3

import json
import subprocess


def sh(cmd):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return ""


def mic_active():
    out = sh("pactl list source-outputs short")
    return bool(out.strip())


def camera_active():
    out = sh("fuser /dev/video* 2>/dev/null")
    return bool(out.strip())


def screen_active():
    out = sh("pgrep -af 'wf-recorder|obs|kooha|grimblast'")
    return bool(out.strip())


privacy_icons = []
privacy_class = "normal"
tooltip_parts = []

if screen_active():
    privacy_icons.append("󰹑")
    tooltip_parts.append("pantalla")
    privacy_class = "screen"

if camera_active():
    privacy_icons.append("󰖠")
    tooltip_parts.append("cámara")
    privacy_class = "camera"

if mic_active():
    privacy_icons.append("󰍬")
    tooltip_parts.append("micrófono")

    if privacy_class == "normal":
        privacy_class = "mic"

if not privacy_icons:
    text = "󰌾"
    tooltip = "Privacidad · sin actividad sensible detectada"
else:
    text = " ".join(privacy_icons)
    tooltip = "Privacidad activa · " + ", ".join(tooltip_parts)

print(json.dumps({
    "text": text,
    "tooltip": tooltip,
    "class": privacy_class,
}))
