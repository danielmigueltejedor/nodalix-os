#!/usr/bin/env python3
import json
import subprocess


def sh(cmd):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
    except Exception:
        return ""


status = sh("playerctl status")

if status not in ["Playing", "Paused"]:
    print(json.dumps({
        "text": "",
        "tooltip": "",
        "class": "hidden"
    }))
    raise SystemExit(0)

title = sh("playerctl metadata title")
artist = sh("playerctl metadata artist")

if not title:
    print(json.dumps({
        "text": "",
        "tooltip": "",
        "class": "hidden"
    }))
    raise SystemExit(0)

icon = "󰝚" if status == "Playing" else "󰏤"
media = title

if artist:
    media = title + " — " + artist

if len(media) > 42:
    media = media[:41].rstrip() + "…"

print(json.dumps({
    "text": "|  " + icon + " " + media,
    "tooltip": "Media Center · click para abrir popup",
    "class": "playing" if status == "Playing" else "paused"
}))
