#!/usr/bin/env python3

import json
import subprocess

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL, timeout=2).strip()
    except Exception:
        return ""

def wifi_icon(signal):
    try:
        signal = int(signal)
    except Exception:
        signal = 0

    if signal >= 75:
        return "󰤨"
    if signal >= 50:
        return "󰤥"
    if signal >= 25:
        return "󰤢"
    if signal > 0:
        return "󰤟"
    return "󰤯"

def get_active_connection():
    raw = sh("nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status")

    ethernet = None
    wifi = None

    for line in raw.splitlines():
        parts = line.split(":", 3)
        if len(parts) != 4:
            continue

        device, kind, state, connection = parts

        if state != "connected":
            continue

        if kind == "ethernet":
            ethernet = {"device": device, "connection": connection}
        elif kind == "wifi":
            wifi = {"device": device, "connection": connection}

    if ethernet:
        return "ethernet", ethernet

    if wifi:
        return "wifi", wifi

    return "none", {}

kind, data = get_active_connection()

if kind == "ethernet":
    text = "󰈀"
    tooltip = "Ethernet · " + data.get("connection", "")
    css_class = "ethernet"
elif kind == "wifi":
    ssid = data.get("connection", "")
    signal = sh("nmcli -t -f IN-USE,SIGNAL dev wifi | awk -F: '$1==\"*\" {print $2; exit}'")
    icon = wifi_icon(signal)
    text = icon
    tooltip = "Wi-Fi · " + ssid + (" · " + signal + "%" if signal else "")
    css_class = "wifi"
else:
    text = "󰤯"
    tooltip = "Sin conexión de red"
    css_class = "disconnected"

print(json.dumps({
    "text": text,
    "tooltip": tooltip,
    "class": css_class,
}))
