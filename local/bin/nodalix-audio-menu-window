#!/usr/bin/env python3

WIDTH = 615
HEIGHT = 562

import gi
import json
import subprocess

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

APP_TITLE = "Nodalix Audio"

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL, timeout=2).strip()
    except Exception:
        return ""

def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def has_cmd(cmd):
    return bool(sh("command -v " + cmd))

def get_volume():
    if has_cmd("pamixer"):
        out = sh("pamixer --get-volume")
        if out.isdigit():
            return int(out)
    return 0

def get_muted():
    if has_cmd("pamixer"):
        return sh("pamixer --get-mute") == "true"
    return False

def set_volume(value):
    if has_cmd("pamixer"):
        run("pamixer --set-volume " + str(int(value)))

def toggle_mute():
    if has_cmd("pamixer"):
        run("pamixer -t")

def get_default_sink():
    return sh("pactl get-default-sink").strip()

def get_sinks():
    raw = sh("pactl -f json list sinks")
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except Exception:
        return []
    sinks = []
    for sink in data:
        name = sink.get("name") or ""
        props = sink.get("properties") or {}
        desc = props.get("device.description") or props.get("node.description") or name
        if name:
            sinks.append({"name": name, "description": desc})
    return sinks

def set_default_sink(name):
    if name:
        run("pactl set-default-sink " + name)

def open_advanced_sound_settings():
    if has_cmd("pavucontrol"):
        run("pavucontrol")
    else:
        run("notify-send \"Nodalix Audio\" \"Ajustes avanzados de sonido próximamente\"")

