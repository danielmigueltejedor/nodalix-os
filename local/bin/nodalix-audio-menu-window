"""
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

def position_near_waybar_click(window, width, height):
    """
    Position Nodalix right-island popup inside the monitor that contains the cursor.

    Multi-monitor fix:
    - DP-2 ends at x=1920 and DP-3 starts at x=1920.
    - If we place the popup around cursor x≈1913 without subtracting popup width,
      it spills into DP-3.
    - Correct formula:
        target_x = monitor_x + monitor_width - popup_width - margin
    """
    raw = sh("hyprctl cursorpos -j")
    monitors_raw = sh("hyprctl monitors -j")

    margin = 14
    top_bar = 52

    try:
        cursor = json.loads(raw)
        x = int(cursor.get("x", 0))
        y = int(cursor.get("y", 0))
    except Exception:
        x = 0
        y = 0

    try:
        monitors = json.loads(monitors_raw)
    except Exception:
        window.set_position(Gtk.WindowPosition.CENTER)
        return

    selected = None

    for mon in monitors:
        mon_x = int(mon.get("x", 0))
        mon_y = int(mon.get("y", 0))
        mon_w = int(mon.get("width", 1920))
        mon_h = int(mon.get("height", 1080))

        if mon_x <= x < mon_x + mon_w and mon_y <= y < mon_y + mon_h:
            selected = (mon_x, mon_y, mon_w, mon_h)
            break

    if selected is None:
        for mon in monitors:
            if mon.get("focused"):
                selected = (
                    int(mon.get("x", 0)),
                    int(mon.get("y", 0)),
                    int(mon.get("width", 1920)),
                    int(mon.get("height", 1080)),
                )
                break

    if selected is None:
        window.set_position(Gtk.WindowPosition.CENTER)
        return

    mon_x, mon_y, mon_w, mon_h = selected

    target_x = mon_x + mon_w - width - margin
    target_y = mon_y + top_bar + 8

    if target_x < mon_x + margin:
        target_x = mon_x + margin

    if target_y + height > mon_y + mon_h - margin:
        target_y = mon_y + mon_h - height - margin

    if target_y < mon_y + margin:
        target_y = mon_y + margin

    window.move(int(target_x), int(target_y))


class AudioMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)
        self.set_default_size(WIDTH, HEIGHT)
        self.set_size_request(WIDTH, HEIGHT)
        self.set_resizable(False)
        self.set_decorated(False)
        position_near_waybar_click(self, WIDTH, HEIGHT)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_name("root")
        self.add(root)

        title = Gtk.Label(xalign=0)
        title.set_name("title")
        title.set_text("󰕾 Audio")
        root.pack_start(title, False, False, 0)

        self.subtitle = Gtk.Label(xalign=0)
        self.subtitle.set_name("subtitle")
        self.subtitle.set_text("Control rápido de sonido")
        root.pack_start(self.subtitle, False, False, 0)

        volume_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        volume_card.set_name("card")
        root.pack_start(volume_card, False, False, 0)

        volume_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        volume_card.pack_start(volume_header, False, False, 0)

        self.volume_label = Gtk.Label(xalign=0)
        self.volume_label.set_name("row_title")
        volume_header.pack_start(self.volume_label, True, True, 0)

        self.mute_button = Gtk.Button(label="󰝟 Mute")
        self.mute_button.connect("clicked", self.on_mute_clicked)
        volume_header.pack_start(self.mute_button, False, False, 0)

        self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume.set_draw_value(False)
        self.volume.connect("value-changed", self.on_volume_changed)
        volume_card.pack_start(self.volume, False, False, 0)

        output_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        output_card.set_name("card")
        root.pack_start(output_card, False, False, 0)

        output_title = Gtk.Label(xalign=0)
        output_title.set_name("row_title")
        output_title.set_text("Salida de audio")
        output_card.pack_start(output_title, False, False, 0)

        self.output_combo = Gtk.ComboBoxText()
        self.sinks = get_sinks()
        self.default_sink = get_default_sink()
        active_index = 0

        for idx, sink in enumerate(self.sinks):
            self.output_combo.append(sink["name"], sink["description"])
            if sink["name"] == self.default_sink:
                active_index = idx

        if self.sinks:
            self.output_combo.set_active(active_index)
        else:
            self.output_combo.append_text("Sin salidas detectadas")
            self.output_combo.set_active(0)
            self.output_combo.set_sensitive(False)

        self.output_combo.connect("changed", self.on_sink_changed)
        output_card.pack_start(self.output_combo, False, False, 0)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.pack_end(footer, False, False, 0)

        advanced = Gtk.Button(label="Ajustes avanzados de sonido")
        advanced.set_name("primary_button")
        advanced.connect("clicked", lambda _b: open_advanced_sound_settings())
        footer.pack_start(advanced, True, True, 0)

        close = Gtk.Button(label="Cerrar")
        close.connect("clicked", lambda _b: Gtk.main_quit())
        footer.pack_start(close, False, False, 0)

        self.refresh()

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False

    def refresh(self):
        volume = get_volume()
        muted = get_muted()
        self.volume.handler_block_by_func(self.on_volume_changed)
        self.volume.set_value(volume)
        self.volume.handler_unblock_by_func(self.on_volume_changed)
        if muted:
            self.volume_label.set_text(f"Volumen · silenciado · {volume}%")
            self.mute_button.set_label("󰕾 Activar")
            self.mute_button.set_name("primary_button")
        else:
            self.volume_label.set_text(f"Volumen · {volume}%")
            self.mute_button.set_label("󰝟 Mute")
            self.mute_button.set_name("danger_button")
        if self.default_sink:
            self.subtitle.set_text(f"Salida actual · {self.default_sink}")

    def on_volume_changed(self, scale):
        value = int(scale.get_value())
        set_volume(value)
        self.volume_label.set_text(f"Volumen · {value}%")

    def on_mute_clicked(self, _button):
        toggle_mute()
        GLib.timeout_add(150, self.refresh)

    def on_sink_changed(self, combo):
        sink_id = combo.get_active_id()
        if sink_id:
            set_default_sink(sink_id)
            self.default_sink = sink_id
            GLib.timeout_add(150, self.refresh)

if __name__ == "__main__":
    setup_css()
    win = AudioMenu()
    win.show_all()
    Gtk.main()
