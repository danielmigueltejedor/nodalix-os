#!/usr/bin/env bash
set -euo pipefail

name="${1:-}"
url="${2:-}"

if [[ -z "$name" || -z "$url" ]]; then
  echo "Usage: nodalix-launch-or-focus-webapp <name> <url>" >&2
  exit 1
fi

class="nodalix-webapp-${name// /-}"
class="${class,,}"

address="$(
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg q "$class" --arg n "$name" '
      .[]
      | select(
          (.class // "" | test($q; "i"))
          or (.initialClass // "" | test($q; "i"))
          or (.title // "" | test($n; "i"))
        )
      | .address
    ' \
    | head -n 1
)"

if [[ -n "$address" && "$address" != "null" ]]; then
  hyprctl dispatch focuswindow "address:$address" >/dev/null
else
  exec nodalix-launch-webapp "$name" "$url"
fi
