#!/usr/bin/env bash
set -euo pipefail

if command -v nodalix-privacy-menu >/dev/null 2>&1; then
  exec nodalix-privacy-menu
fi

if [ -x "$HOME/Proyectos/nodalix-os/local/bin/nodalix-privacy-menu" ]; then
  exec "$HOME/Proyectos/nodalix-os/local/bin/nodalix-privacy-menu"
fi

notify-send "Nodalix" "No encuentro nodalix-privacy-menu"
