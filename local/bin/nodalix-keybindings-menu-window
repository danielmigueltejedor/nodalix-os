#!/usr/bin/env python3
import gi
import json
import os
import subprocess
from pathlib import Path

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

APP_TITLE = "Nodalix Keybindings"
WIDTH = 940
HEIGHT = 620


def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def sh(cmd, timeout=2):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        ).strip()
    except Exception:
        return ""


def load_accent():
    theme = Path.home() / ".config/nodalix/theme.json"
    if theme.exists():
        try:
            data = json.loads(theme.read_text())
            return data.get("hex", "#cba6f7")
        except Exception:
            pass
    return "#cba6f7"


ACCENT = load_accent()


