  font-family: "Inter", "SF Pro Display", "Segoe UI", "Roboto", "Ubuntu", "Cantarell", "Noto Sans", sans-serif;
  font-size: 13px;
  color: #cdd6f4;
}}

window {{
  background: transparent;
}}

#root {{
  background: rgba(17, 17, 27, 0.970);
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 28px;
  padding: 18px;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.58);
}}

#header_title {{
  color: #ffffff;
  font-size: 22px;
  font-weight: 900;
}}

