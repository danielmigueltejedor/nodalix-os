def setup_css():
    accent = ACCENT
    css = f"""
* {{
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 13px;
  color: #cdd6f4;
}}

window {{
  background: transparent;
}}

#root {{
  background: rgba(17, 17, 27, 0.970);
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 28px;
  padding: 18px;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.58);
}}

#header_title {{
  color: #ffffff;
  font-size: 22px;
  font-weight: 900;
}}

#header_subtitle {{
  color: #a6adc8;
  font-size: 12px;
}}

#search {{
  background: rgba(255, 255, 255, 0.065);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 999px;
  padding: 10px 16px;
  color: #ffffff;
}}

#section {{
  background: rgba(255, 255, 255, 0.040);
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 22px;
  padding: 14px;
}}

#section_header {{
  color: #ffffff;
  font-size: 16px;
  font-weight: 900;
}}

#section_icon {{
  color: {accent};
  font-size: 22px;
  min-width: 34px;
  margin-right: 8px;
}}

#binding_row {{
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.060);
  border-radius: 16px;
  padding: 10px 12px;
}}

#binding_row:hover {{
  background: rgba(203, 166, 247, 0.10);
  border-color: rgba(203, 166, 247, 0.25);
}}

#key {{
  background: rgba(203, 166, 247, 0.16);
  border: 1px solid rgba(203, 166, 247, 0.34);
  border-radius: 999px;
  color: #ffffff;
  font-weight: 900;
  padding: 6px 10px;
  min-width: 170px;
}}

#desc {{
  color: #cdd6f4;
}}

#footer {{
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.070);
  border-radius: 999px;
  padding: 8px 12px;
}}

#footer_hint {{
  color: #7f849c;
  font-size: 12px;
}}

button {{
  background: rgba(255, 255, 255, 0.060);
  border: 1px solid rgba(255, 255, 255, 0.090);
  border-radius: 999px;
  padding: 7px 12px;
  box-shadow: none;
}}

button:hover {{
  background: rgba(203, 166, 247, 0.18);
  color: #ffffff;
}}

#primary_button {{
  background: rgba(203, 166, 247, 0.22);
  border: 1px solid rgba(203, 166, 247, 0.36);
  color: #ffffff;
}}

scrollbar {{
  background: transparent;
  border: 0;
}}

scrollbar trough {{
  background: rgba(255, 255, 255, 0.035);
  border-radius: 999px;
}}

scrollbar slider {{
  background: rgba(203, 166, 247, 0.30);
  border-radius: 999px;
}}
"""
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )


class KeybindingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)

        self.set_wmclass("nodalix-keybindings-menu-window", "nodalix-keybindings-menu-window")
        self.set_default_size(WIDTH, HEIGHT)
        self.set_resizable(True)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_name("root")
        self.add(root)

        self.build_header(root)
        self.build_search(root)
        self.build_list(root)
        self.build_footer(root)

        self.render()

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def build_header(self, root):
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        root.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.pack_start(title_box, True, True, 0)

        title = Gtk.Label(label="󰌌  Nodalix Keybindings", xalign=0)
        title.set_name("header_title")
        title_box.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Vista rápida de atajos del sistema, ventanas, workspaces, Waybar y controles Nodalix",
            xalign=0,
        )
        subtitle.set_name("header_subtitle")
        title_box.pack_start(subtitle, False, False, 0)

        close = Gtk.Button(label="Cerrar")
        close.connect("clicked", lambda *_: self.destroy())
        header.pack_start(close, False, False, 0)

    def build_search(self, root):
        self.search = Gtk.SearchEntry()
        self.search.set_name("search")
        self.search.set_placeholder_text("Buscar atajos: ventana, workspace, audio, captura, Nodalix…")
        self.search.connect("search-changed", lambda *_: self.render())
        root.pack_start(self.search, False, False, 0)

    def build_list(self, root):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.pack_start(scroll, True, True, 0)

        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scroll.add(self.list_box)

    def build_footer(self, root):
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_name("footer")

        hint = Gtk.Label(label="Pulsa Esc para cerrar · Edita este menú desde local/bin/nodalix-keybindings-menu-window")
        hint.set_name("footer_hint")
        hint.set_xalign(0)
        footer.pack_start(hint, True, True, 0)

        edit = Gtk.Button(label="Editar")
        edit.set_name("primary_button")
        edit.connect("clicked", lambda *_: run("zed ~/Projects/nodalix-os/local/bin/nodalix-keybindings-menu-window"))
        footer.pack_start(edit, False, False, 0)

        root.pack_start(footer, False, False, 0)

    def clear(self):
        for child in self.list_box.get_children():
            self.list_box.remove(child)

    def render(self):
        self.clear()
        query = self.search.get_text().lower().strip()

        for group in KEYBINDINGS:
            filtered = []
            for key, desc in group["items"]:
                haystack = f"{group['section']} {key} {desc}".lower()
                if not query or query in haystack:
                    filtered.append((key, desc))

            if not filtered:
                continue

            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            section.set_name("section")

            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            section.pack_start(header, False, False, 0)

            icon = Gtk.Label(label=group["icon"])
            icon.set_name("section_icon")
            header.pack_start(icon, False, False, 0)

            title = Gtk.Label(label=group["section"], xalign=0)
            title.set_name("section_header")
            header.pack_start(title, True, True, 0)

            for key, desc in filtered:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.set_name("binding_row")

                key_label = Gtk.Label(label=key)
                key_label.set_name("key")
                key_label.set_xalign(0.5)
                row.pack_start(key_label, False, False, 0)

                desc_label = Gtk.Label(label=desc, xalign=0)
                desc_label.set_name("desc")
                desc_label.set_line_wrap(True)
                row.pack_start(desc_label, True, True, 0)

                section.pack_start(row, False, False, 0)

            self.list_box.pack_start(section, False, False, 0)

        self.list_box.show_all()


def main():
    setup_css()
    win = KeybindingsWindow()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
