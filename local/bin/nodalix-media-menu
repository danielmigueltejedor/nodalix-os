#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/Proyectos/nodalix-os/local/bin/media-popup-window"
LOG="/tmp/nodalix-media-popup.log"

if pgrep -f "$APP" >/dev/null; then
  pkill -f "$APP" || true
  exit 0
fi

nohup "$APP" >"$LOG" 2>&1 &
~/.local/bin/nodalix-position-popup-right "media-popup-window" 14 >/dev/null 2>&1 &
