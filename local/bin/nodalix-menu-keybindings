#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/.local/bin/nodalix-keybindings-menu-window"
LOG="/tmp/nodalix-keybindings-menu.log"
CLASS="nodalix-keybindings-menu-window"

nodalix-close-popups "$CLASS" 2>/dev/null || true

if hyprctl clients -j 2>/dev/null | jq -e --arg class "$CLASS" '.[] | select(.class == $class)' >/dev/null; then
  pkill -f "$APP" 2>/dev/null || true
  exit 0
fi

nohup "$APP" >"$LOG" 2>&1 &
