#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix/toggles"
state_file="$state_dir/notifications-silenced"
mkdir -p "$state_dir"

if [[ -f "$state_file" ]]; then
  rm -f "$state_file"
  makoctl mode -r do-not-disturb >/dev/null 2>&1 || true
  notify-send "Nodalix" "Notificaciones activadas"
else
  touch "$state_file"
  makoctl mode -a do-not-disturb >/dev/null 2>&1 || true
fi
