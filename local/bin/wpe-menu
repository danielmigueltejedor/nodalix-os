#!/usr/bin/env bash

APP_TITLE="Nodalia WPE Menu"
APP_CMD="$HOME/.local/bin/wpe-menu-window"

focus_and_shape() {
  local addr

  addr="$(hyprctl clients -j | jq -r --arg title "$APP_TITLE" '.[] | select(.title == $title) | .address' | head -n1)"

  if [[ -z "$addr" || "$addr" == "null" ]]; then
    return 1
  fi

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1
  sleep 0.12

  hyprctl dispatch setfloating "address:$addr" >/dev/null 2>&1 || true
  sleep 0.12

  # Importante: el parámetro exact va como una sola cadena.
  hyprctl dispatch resizeactive "exact 940 560" >/dev/null 2>&1 || true
  sleep 0.05

  hyprctl dispatch centerwindow >/dev/null 2>&1 || hyprctl dispatch "hl.dsp.window.center()" >/dev/null 2>&1 || true

  return 0
}

if focus_and_shape; then
  exit 0
fi

"$APP_CMD" >/tmp/wpe-menu-window.log 2>&1 &

for i in {1..50}; do
  sleep 0.1
  if focus_and_shape; then
    exit 0
  fi
done
