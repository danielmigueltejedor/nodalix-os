#!/usr/bin/env python3

WIDTH = 615
HEIGHT = 562

import gi
import json
import re
import subprocess

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

APP_TITLE = "Nodalix Bluetooth"

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL, timeout=3).strip()
    except Exception:
        return ""

def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def has_cmd(cmd):
    return bool(sh("command -v " + cmd))

def bluetooth_powered():
    out = sh("bluetoothctl show")
    return "Powered: yes" in out

def bluetooth_available():
    return bool(sh("bluetoothctl show"))

def set_power(enabled):
    run("bluetoothctl power " + ("on" if enabled else "off"))

def parse_devices():
    devices = []
    paired = sh("bluetoothctl devices Paired")
    connected_raw = sh("bluetoothctl devices Connected")
    connected = set()

    for line in connected_raw.splitlines():
        m = re.match(r"Device\s+([0-9A-Fa-f:]{17})\s+(.+)", line)
        if m:
            connected.add(m.group(1).upper())

    for line in paired.splitlines():
        m = re.match(r"Device\s+([0-9A-Fa-f:]{17})\s+(.+)", line)
        if not m:
            continue
        mac = m.group(1).upper()
        name = m.group(2).strip()
        devices.append({"mac": mac, "name": name, "connected": mac in connected})

    return devices

def connect_device(mac):
    if mac:
        run("bluetoothctl connect " + mac)

def disconnect_device(mac):
    if mac:
        run("bluetoothctl disconnect " + mac)

def open_advanced_bluetooth_settings():
    # Futuro: nodalix-settings bluetooth
    if has_cmd("bluetui"):
        run("alacritty -e bluetui")
    elif has_cmd("blueberry"):
        run("blueberry")
    elif has_cmd("blueman-manager"):
        run("blueman-manager")
    else:
        run("notify-send \"Nodalix Bluetooth\" \"Ajustes avanzados de Bluetooth todavía no implementados\"")

