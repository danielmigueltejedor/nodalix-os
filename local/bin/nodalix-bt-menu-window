#!/usr/bin/env python3

WIDTH = 615
HEIGHT = 562

import gi
import json
import re
import subprocess
import threading

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

APP_TITLE = "Nodalix Bluetooth"


def sh(cmd, timeout=4):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        ).strip()
    except Exception:
        return ""


def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def has_cmd(cmd):
    return bool(sh("command -v " + cmd))


def notify(title, msg):
    run(f"notify-send {title!r} {msg!r}")


def bluetooth_available():
    return bool(sh("bluetoothctl show"))


def bluetooth_powered():
    return "Powered: yes" in sh("bluetoothctl show")


def bluetooth_pairable():
    return "Pairable: yes" in sh("bluetoothctl show")


def bluetooth_discovering():
    return "Discovering: yes" in sh("bluetoothctl show")


def set_power(enabled):
    run("bluetoothctl power " + ("on" if enabled else "off"))


def bt(cmd, timeout=8):
    return sh("bluetoothctl " + cmd, timeout=timeout)


def parse_bool(info, key):
    return f"{key}: yes" in info


def parse_field(info, key):
    m = re.search(rf"^\s*{re.escape(key)}:\s+(.+)$", info, re.M)
    return m.group(1).strip() if m else ""


def pretty_type(info, name):
    hay = (info + "\n" + name).lower()
    icon = parse_field(info, "Icon").lower()

    if "xbox" in hay or "input-gaming" in icon or "human interface device" in hay or "00001124" in hay:
        return "󰊴 Mando / Gamepad", "gamepad"

    if "phone" in icon or "generic audio" in hay or "handsfree" in hay:
        return "󰄜 Teléfono / Audio", "phone"

    if "audio" in hay or "headset" in hay or "speaker" in hay:
        return "󰋋 Audio", "audio"

    if "keyboard" in hay:
        return "󰌌 Teclado", "keyboard"

    if "mouse" in hay:
        return "󰍽 Ratón", "mouse"

    if "sonos" in hay:
        return "󰓃 Sonos / Audio", "audio"

    return "󰂯 Bluetooth", "generic"


def device_icon(kind):
    return {
        "gamepad": "󰊴",
        "phone": "󰄜",
        "audio": "󰋋",
        "keyboard": "󰌌",
        "mouse": "󰍽",
        "generic": "󰂯",
    }.get(kind, "󰂯")


def all_device_macs():
    macs = []
    seen = set()

    for cmd in [
        "bluetoothctl devices",
        "bluetoothctl devices Paired",
        "bluetoothctl devices Connected",
        "bluetoothctl devices Trusted",
    ]:
        out = sh(cmd)
        for line in out.splitlines():
            m = re.match(r"Device\s+([0-9A-Fa-f:]{17})\s+(.+)", line)
            if not m:
                continue

            mac = m.group(1).upper()
            if mac in seen:
                continue

            seen.add(mac)
            macs.append(mac)

    return macs


def parse_devices():
    devices = []

    for mac in all_device_macs():
        info = bt(f"info {mac}", timeout=4)
        if not info:
            continue

        name = parse_field(info, "Name") or parse_field(info, "Alias") or mac
        alias = parse_field(info, "Alias") or name
        icon = parse_field(info, "Icon")
        rssi = parse_field(info, "RSSI")
        klass = parse_field(info, "Class")
        dev_type, kind = pretty_type(info, name)

        paired = parse_bool(info, "Paired")
        trusted = parse_bool(info, "Trusted")
        connected = parse_bool(info, "Connected")
        blocked = parse_bool(info, "Blocked")

        # Oculta ruido Apple random sin nombre útil, pero deja dispositivos con nombre real.
        if not paired and not connected and name.replace("-", ":").upper() == mac:
            manufacturer = parse_field(info, "ManufacturerData.Key")
            if manufacturer == "0x004c (76)":
                continue

        devices.append({
            "mac": mac,
            "name": name,
            "alias": alias,
            "icon": icon,
            "class": klass,
            "rssi": rssi,
            "type": dev_type,
            "kind": kind,
            "paired": paired,
            "trusted": trusted,
            "connected": connected,
            "blocked": blocked,
        })

    def score(d):
        return (
            not d["connected"],
            not d["paired"],
            d["kind"] != "gamepad",
            d["kind"] != "audio",
            d["name"].lower(),
        )

    devices.sort(key=score)
    return devices


def connect_device(mac):
    if mac:
        run(f"bluetoothctl connect {mac}")


def disconnect_device(mac):
    if mac:
        run(f"bluetoothctl disconnect {mac}")


def pair_device(mac):
    if mac:
        run(f"bluetoothctl pair {mac}")


def trust_device(mac):
    if mac:
        run(f"bluetoothctl trust {mac}")


def remove_device(mac):
    if mac:
        run(f"bluetoothctl remove {mac}")


def scan_for_devices(seconds=25):
    # Prepara BlueZ para pairing HID/gamepad.
    bt("agent on", timeout=2)
    bt("default-agent", timeout=2)
    bt("power on", timeout=2)
    bt("pairable on", timeout=2)
    bt("discoverable on", timeout=2)

    # Mantener el escaneo activo en background.
    run("bluetoothctl scan on")


def stop_scan():
    bt("scan off", timeout=2)
    bt("discoverable off", timeout=2)


