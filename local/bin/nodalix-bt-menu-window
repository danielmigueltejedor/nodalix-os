  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 13px;
  color: #cdd6f4;
}
window {
  background: transparent;
}
#root {
  background: rgba(17, 17, 27, 0.96);
  border: 1px solid rgba(137, 180, 250, 0.28);
  border-radius: 22px;
  padding: 16px;
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.48);
}
#title {
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
}
#subtitle {
  color: #a6adc8;
  font-size: 12px;
}
#card {
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 12px;
}
#device_row {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  padding: 9px 10px;
