class BluetoothMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)
        self.set_default_size(WIDTH, HEIGHT)
        self.set_size_request(WIDTH, HEIGHT)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        self.scanning = False
        self.scan_ticks_left = 0
        self.scan_ticks_left = 0

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)

        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.root.set_name("root")
        self.add(self.root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.root.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.pack_start(title_box, True, True, 0)

        title = Gtk.Label(xalign=0)
        title.set_name("title")
        title.set_text("󰂯 Bluetooth")
        title_box.pack_start(title, False, False, 0)

        self.subtitle = Gtk.Label(xalign=0)
        self.subtitle.set_name("subtitle")
        self.subtitle.set_text("Control rápido de Bluetooth")
        title_box.pack_start(self.subtitle, False, False, 0)

        self.scan_button = Gtk.Button(label="Escanear")
        self.scan_button.set_name("primary_button")
        self.scan_button.connect("clicked", self.on_scan_clicked)
        header.pack_start(self.scan_button, False, False, 0)

        close = Gtk.Button(label="Cerrar")
        close.connect("clicked", lambda _b: Gtk.main_quit())
        header.pack_start(close, False, False, 0)

        self.status_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.status_card.set_name("card")
        self.root.pack_start(self.status_card, False, False, 0)

        self.status_label = Gtk.Label(xalign=0)
        self.status_label.set_name("row_title")
        self.status_card.pack_start(self.status_label, True, True, 0)

        self.power_button = Gtk.Button(label="")
        self.power_button.connect("clicked", self.on_power_clicked)
        self.status_card.pack_start(self.power_button, False, False, 0)

        self.devices_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.devices_card.set_name("card")
        self.root.pack_start(self.devices_card, True, True, 0)

        devices_title = Gtk.Label(xalign=0)
        devices_title.set_name("row_title")
        devices_title.set_text("Dispositivos Bluetooth")
        self.devices_card.pack_start(devices_title, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.devices_card.pack_start(scroll, True, True, 0)

        self.devices_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        scroll.add(self.devices_box)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.root.pack_end(footer, False, False, 0)

        footer_spacer = Gtk.Label(label="")
        footer.pack_start(footer_spacer, True, True, 0)

        self.refresh()

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False

    def clear_devices(self):
        for child in self.devices_box.get_children():
            self.devices_box.remove(child)

    def refresh(self):
        if not bluetooth_available():
            self.status_label.set_text("Bluetooth no disponible")
            self.subtitle.set_text("No se detecta adaptador Bluetooth")
            self.power_button.set_label("No disponible")
            self.power_button.set_sensitive(False)
            self.scan_button.set_sensitive(False)
            self.clear_devices()
            return False

        powered = bluetooth_powered()
        pairable = bluetooth_pairable()
        discovering = bluetooth_discovering() or self.scanning

        self.status_label.set_text("Bluetooth activado" if powered else "Bluetooth desactivado")
        self.subtitle.set_text(
            (f"Escaneando dispositivos cercanos… {self.scan_ticks_left * 1.5:.0f}s" if discovering else "Dispositivos emparejados y cercanos")
            + (" · Pairable" if pairable else "")
        )

        self.power_button.set_sensitive(True)
        self.power_button.set_label("Desactivar" if powered else "Activar")
        self.power_button.set_name("danger_button" if powered else "primary_button")
        self.scan_button.set_sensitive(powered and not self.scanning)
        self.scan_button.set_label("Escaneando…" if self.scanning else "Escanear")

        self.clear_devices()

        if not powered:
            self.add_empty("Activa Bluetooth para ver dispositivos.")
            return False

        devices = parse_devices()

        if not devices:
            self.add_empty("No hay dispositivos nuevos. Pulsa Escanear y pon el dispositivo Bluetooth en modo emparejamiento.")
            return False

        for device in devices:
            self.devices_box.pack_start(self.make_device_row(device), False, False, 0)

        self.devices_box.show_all()
        return False

    def add_empty(self, text):
        label = Gtk.Label(xalign=0)
        label.set_name("row_subtitle")
        label.set_text(text)
        self.devices_box.pack_start(label, False, False, 0)
        self.devices_box.show_all()

    def make_device_row(self, device):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)

        if device["connected"]:
            row.set_name("device_row_connected")
        elif device["kind"] == "gamepad":
            row.set_name("device_row_gamepad")
        else:
            row.set_name("device_row")

        icon = Gtk.Label(label=device_icon(device["kind"]))
        icon.set_name("row_icon")
        icon.set_size_request(34, -1)
        row.pack_start(icon, False, False, 4)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        row.pack_start(text, True, True, 0)

        title = Gtk.Label(xalign=0)
        title.set_name("row_title")
        title.set_text(device["name"])
        title.set_ellipsize(3)
        text.pack_start(title, False, False, 0)

        flags = []
        flags.append(device["type"])
        if device["paired"]:
            flags.append("emparejado")
        else:
            flags.append("nuevo")
        if device["trusted"]:
            flags.append("confiado")
        if device["connected"]:
            flags.append("conectado")
        if device["rssi"]:
            flags.append("RSSI " + device["rssi"])

        subtitle = Gtk.Label(xalign=0)
        subtitle.set_name("row_subtitle")
        subtitle.set_text(device["mac"] + " · " + " · ".join(flags))
        subtitle.set_ellipsize(3)
        text.pack_start(subtitle, False, False, 0)

        if device["kind"] == "gamepad":
            badge = Gtk.Label(label="Gamepad")
            badge.set_name("success_badge")
            row.pack_start(badge, False, False, 0)
        elif not device["paired"]:
            badge = Gtk.Label(label="Nuevo")
            badge.set_name("warn_badge")
            row.pack_start(badge, False, False, 0)

        if device["connected"]:
            btn = Gtk.Button(label="Desconectar")
            btn.set_name("danger_button")
            btn.connect("clicked", lambda _b, mac=device["mac"]: self.disconnect_and_refresh(mac))
            row.pack_start(btn, False, False, 0)
        else:
            if not device["paired"]:
                pair = Gtk.Button(label="Emparejar")
                pair.set_name("primary_button")
                pair.connect("clicked", lambda _b, mac=device["mac"]: self.pair_trust_connect(mac))
                row.pack_start(pair, False, False, 0)
            else:
                trust = Gtk.Button(label="Confiar")
                trust.connect("clicked", lambda _b, mac=device["mac"]: self.trust_and_refresh(mac))
                row.pack_start(trust, False, False, 0)

                connect = Gtk.Button(label="Conectar")
                connect.set_name("primary_button")
                connect.connect("clicked", lambda _b, mac=device["mac"]: self.connect_and_refresh(mac))
                row.pack_start(connect, False, False, 0)

        remove = Gtk.Button(label="Olvidar")
        remove.set_name("danger_button")
        remove.connect("clicked", lambda _b, mac=device["mac"]: self.remove_and_refresh(mac))
        row.pack_start(remove, False, False, 0)

        return row

    def pair_trust_connect(self, mac):
        notify("Nodalix Bluetooth", "Emparejando dispositivo…")
        run(f"bluetoothctl agent on; bluetoothctl default-agent; bluetoothctl pair {mac}; bluetoothctl trust {mac}; bluetoothctl connect {mac}")
        GLib.timeout_add(3500, self.refresh)

    def connect_and_refresh(self, mac):
        connect_device(mac)
        GLib.timeout_add(1400, self.refresh)

    def disconnect_and_refresh(self, mac):
        disconnect_device(mac)
        GLib.timeout_add(900, self.refresh)

    def trust_and_refresh(self, mac):
        trust_device(mac)
        GLib.timeout_add(900, self.refresh)

    def remove_and_refresh(self, mac):
        remove_device(mac)
        GLib.timeout_add(900, self.refresh)

    def on_power_clicked(self, _button):
        set_power(not bluetooth_powered())
        GLib.timeout_add(900, self.refresh)

    def on_scan_clicked(self, _button):
        if self.scanning:
            return

        self.scanning = True
        self.scan_ticks_left = 18  # 18 * 1500ms = 27s aprox.
        scan_for_devices(25)
        notify("Nodalix Bluetooth", "Escaneando 25s. Pon cualquier dispositivo Bluetooth en modo emparejamiento.")
        self.refresh()
        GLib.timeout_add(1500, self.live_scan_tick)

    def live_scan_tick(self):
        if not self.scanning:
            return False

        self.scan_ticks_left -= 1
        self.refresh()

        if self.scan_ticks_left <= 0:
            return self.finish_scan()

        return True

    def finish_scan(self):
        self.scanning = False
        stop_scan()
        self.refresh()
        notify("Nodalix Bluetooth", "Escaneo completado")
        return False



if __name__ == "__main__":
    setup_css()
    win = BluetoothMenu()
    win.show_all()
    Gtk.main()
