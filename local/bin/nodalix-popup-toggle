#!/usr/bin/env python3
import json, subprocess, time, sys

HYPRCTL = "/usr/bin/hyprctl"

ISLANDS = {
    "volume": {"x": 3200, "y": 80, "width": 420, "height": 310},
    "bt": {"x": 2700, "y": 80, "width": 420, "height": 310},
    "wifi": {"x": 2850, "y": 80, "width": 480, "height": 460},
    "media": {"x": 1500, "y": 80, "width": 568, "height": 327},
}

POPUPS = {
    "volume": "Nodix Audio",
    "bt": "Nodix Bluetooth",
    "wifi": "Nodix Network",
    "media": "Nodalia Media Popup",
}

def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""

def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def dispatch(expr):
    subprocess.run([HYPRCTL, "dispatch", expr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def wait_for_popup(title_filter, timeout=1.5):
    deadline = time.time() + timeout
    while time.time() < deadline:
        out = sh(f"{HYPRCTL} clients -j")
        try:
            clients = json.loads(out)
        except Exception:
            clients = []
        for c in clients:
            title = str(c.get("title") or "").lower()
            addr = str(c.get("address") or "")
            if addr and title_filter.lower() in title.lower():
                return addr
        time.sleep(0.05)
    return ""

def focus_and_tile_popup(address, width, height, x, y):
    if not address:
        return
    dispatch(f"hl.dsp.focus({{ window = \"address:{address}\" }})")
    time.sleep(0.04)
    dispatch("hl.dsp.window.float({ action = \"unset\" })")
    dispatch(f"hl.dsp.window.resize({{ x = {width}, y = {height} }})")
    dispatch(f"hl.dsp.window.move({{ x = {x}, y = {y} }})")
    time.sleep(0.04)

def toggle_popup(kind):
    if kind not in ISLANDS or kind not in POPUPS:
        print(f"Unknown kind: {kind}")
        return
    title_filter = POPUPS[kind]
    addr = wait_for_popup(title_filter)
    if addr:
        dispatch(f"hl.dsp.closewindow({{ window = \"address:{addr}\" }})")
        return
    run(f"nodalix-{kind}-menu")
    time.sleep(0.15)
    addr = wait_for_popup(title_filter)
    if addr:
        isl = ISLANDS[kind]
        focus_and_tile_popup(addr, isl["width"], isl["height"], isl["x"], isl["y"])

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: nodalix-popup-toggle <volume|bt|wifi|media>")
        sys.exit(1)
    toggle_popup(sys.argv[1])

