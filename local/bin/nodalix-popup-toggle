#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import time
from pathlib import Path

HYPRCTL = "/usr/bin/hyprctl"


def sh(args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def run(args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def hypr_json(args):
    raw = sh(args)
    if not raw:
        return None
    try:
        return json.loads(raw)
    except Exception:
        return None


def lua_dispatch(expr):
    subprocess.run([HYPRCTL, "dispatch", expr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def all_clients():
    return hypr_json([HYPRCTL, "clients", "-j"]) or []


def matching_clients(title_match):
    needles = [x.strip().lower() for x in title_match.split("|") if x.strip()]
    matches = []

    for client in all_clients():
        haystack = " ".join([
            str(client.get("title") or ""),
            str(client.get("initialTitle") or ""),
            str(client.get("class") or ""),
            str(client.get("initialClass") or ""),
        ]).lower()

        address = str(client.get("address") or "")

        if address and any(needle in haystack for needle in needles):
            matches.append(client)

    return matches


def popup_script_name(command):
    if not command:
        return ""
    return Path(command[0]).name


def pids_for_exact_popup(command):
    script = popup_script_name(command)
    if not script:
        return []

    current_pid = os.getpid()
    pids = []

    proc = Path("/proc")
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue

        pid = int(entry.name)
        if pid == current_pid:
            continue

        cmdline_file = entry / "cmdline"
        try:
            raw = cmdline_file.read_bytes()
        except Exception:
            continue

        if not raw:
            continue

        parts = [x.decode("utf-8", "ignore") for x in raw.split(b"\0") if x]
        basenames = [Path(x).name for x in parts]

        # Solo matamos procesos cuyo argv contiene exactamente el script popup.
        # No mata terminales, Waybar ni el propio toggle.
        if script in basenames:
            pids.append(pid)

    return pids


def close_popup_processes(command):
    pids = pids_for_exact_popup(command)

    if not pids:
        return False

    for pid in pids:
        try:
            os.kill(pid, 15)
        except Exception:
            pass

    time.sleep(0.12)

    for pid in pids_for_exact_popup(command):
        try:
            os.kill(pid, 9)
        except Exception:
            pass

    return True


def cursor_position():
    pos = hypr_json([HYPRCTL, "cursorpos", "-j"]) or {}
    return int(pos.get("x", 0)), int(pos.get("y", 0))


def monitor_for_cursor():
    x, y = cursor_position()
    monitors = hypr_json([HYPRCTL, "monitors", "-j"]) or []

    for mon in monitors:
        mx = int(mon.get("x", 0))
        my = int(mon.get("y", 0))
        mw = int(mon.get("width", 1920))
        mh = int(mon.get("height", 1080))

        if x >= mx and x < mx + mw and y >= my and y < my + mh:
            return mx, my, mw, mh

    if monitors:
        mon = monitors[0]
        return int(mon.get("x", 0)), int(mon.get("y", 0)), int(mon.get("width", 1920)), int(mon.get("height", 1080))

    return 0, 0, 1920, 1080


def target_position(width, height, anchor):
    mx, my, mw, mh = monitor_for_cursor()

    margin = 18
    island_edge_inset = 210
    top_offset = 92

    if anchor == "left":
        tx = mx + margin + island_edge_inset
    elif anchor == "center":
        tx = mx + (mw // 2) - (width // 2)
    elif anchor == "right":
        tx = mx + mw - width - margin - island_edge_inset
    else:
        tx = mx + (mw // 2) - (width // 2)

    ty = my + top_offset

    if tx < mx + margin:
        tx = mx + margin
    if tx + width > mx + mw - margin:
        tx = mx + mw - width - margin
    if ty < my + margin:
        ty = my + margin
    if ty + height > my + mh - margin:
        ty = my + mh - height - margin

    return tx, ty


def wait_for_window(title_match, timeout=2.0):
    deadline = time.time() + timeout

    while time.time() < deadline:
        clients = matching_clients(title_match)
        if clients:
            return str(clients[0].get("address") or "")
        time.sleep(0.04)

    return ""


def force_float_size_move(address, width, height, anchor):
    if not address:
        return

    x, y = target_position(width, height, anchor)

    lua_dispatch('hl.dsp.focus({ window = "address:' + address + '" })')
    time.sleep(0.03)
    lua_dispatch('hl.dsp.window.float({ action = "set" })')
    lua_dispatch("hl.dsp.window.resize({ x = " + str(width) + ", y = " + str(height) + " })")
    lua_dispatch("hl.dsp.window.move({ x = " + str(x) + ", y = " + str(y) + ", relative = false })")

    time.sleep(0.08)
    lua_dispatch('hl.dsp.focus({ window = "address:' + address + '" })')
    lua_dispatch('hl.dsp.window.float({ action = "set" })')
    lua_dispatch("hl.dsp.window.resize({ x = " + str(width) + ", y = " + str(height) + " })")
    lua_dispatch("hl.dsp.window.move({ x = " + str(x) + ", y = " + str(y) + ", relative = false })")


def main():
    if len(sys.argv) < 5:
        print("Uso: nodalix-popup-toggle <title-match> <width> <height> [left|center|right] <command...>", file=sys.stderr)
        return 2

    title_match = sys.argv[1]
    width = int(sys.argv[2])
    height = int(sys.argv[3])

    if len(sys.argv) >= 6 and sys.argv[4] in ["left", "center", "right"]:
        anchor = sys.argv[4]
        command = sys.argv[5:]
    else:
        anchor = "center"
        command = sys.argv[4:]

    if close_popup_processes(command):
        return 0

    run(command)
    address = wait_for_window(title_match)
    force_float_size_move(address, width, height, anchor)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
