def scale_pixbuf(src):
    if not src:
        return None

    src_w = src.get_width()
    src_h = src.get_height()

    if src_w <= 0 or src_h <= 0:
        return None

    scale = min(MAX_ART_W / src_w, MAX_ART_H / src_h)
    scale = min(scale, 1.0) if max(src_w, src_h) <= max(MAX_ART_W, MAX_ART_H) else scale

    new_w = max(1, int(src_w * scale))
    new_h = max(1, int(src_h * scale))

    return src.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)


def load_art_pixbuf_from_url(url):
    if not url:
        return None

    try:
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 Nodalix Media Popup",
            },
        )

        with urllib.request.urlopen(req, timeout=5) as response:
            data = response.read(8 * 1024 * 1024)

        if not data:
            return None

        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()

        return scale_pixbuf(loader.get_pixbuf())
    except Exception:
        return None


def youtube_video_id(url):
    if not url:
        return ""

    try:
        parsed = urllib.parse.urlparse(url)
        host = (parsed.netloc or "").lower()
        path = parsed.path or ""

        if "youtube.com" in host:
            if path == "/watch":
                return urllib.parse.parse_qs(parsed.query).get("v", [""])[0]

            for prefix in ["/shorts/", "/embed/", "/live/"]:
                if path.startswith(prefix):
                    return path.split(prefix, 1)[1].split("/", 1)[0]

        if "youtu.be" in host:
            return path.strip("/").split("/", 1)[0]
    except Exception:
        return ""

    return ""


def art_candidates(player, art):
    candidates = []

    if art:
        candidates.append(art)

    url = meta(player, "xesam:url", "")
    video_id = youtube_video_id(url)

    if video_id:
        candidates.extend([
            f"https://img.youtube.com/vi/{video_id}/maxresdefault.jpg",
            f"https://img.youtube.com/vi/{video_id}/hqdefault.jpg",
            f"https://img.youtube.com/vi/{video_id}/mqdefault.jpg",
        ])

    return candidates


def resolve_art_pixbuf(player, art):
    for candidate in art_candidates(player, art):
        if not candidate:
            continue

        if candidate.startswith("file://"):
            path = urllib.parse.unquote(candidate.replace("file://", "", 1))
            pix = load_art_pixbuf(path)
        elif candidate.startswith("http://") or candidate.startswith("https://"):
            pix = load_art_pixbuf_from_url(candidate)
        else:
            pix = load_art_pixbuf(candidate)

        if pix:
            return pix

    return None


def load_art_pixbuf(path):
    if not path or not os.path.exists(path):
        return None

    try:
        return scale_pixbuf(GdkPixbuf.Pixbuf.new_from_file(path))
    except Exception:
        return None


class MediaPopup(Gtk.Window):
    def __init__(self):
        super().__init__(title="Nodalia Media Popup")
        self.set_default_size(560, 280)
        self.set_resizable(False)
        self.set_decorated(False)
        self.set_app_paintable(True)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        self.selected_player = pick_initial_player()
        self.known_players = []
        self.action_locked = False
        self.last_cover_key = ""
        self.last_cover_pixbuf = None
        self.last_cover_key = ""
        self.last_cover_pixbuf = None

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        root.set_name("root")
        self.add(root)

        self.art_frame = Gtk.Box()
        self.art_frame.set_name("art_frame")
        self.art_frame.set_halign(Gtk.Align.CENTER)
        self.art_frame.set_valign(Gtk.Align.CENTER)
        root.pack_start(self.art_frame, False, False, 0)

        self.cover = Gtk.Image()
        self.art_frame.pack_start(self.cover, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=11)
        root.pack_start(right, True, True, 0)

        self.combo = Gtk.ComboBoxText()
        self.combo.set_name("player_combo")
        self.combo.set_size_request(190, -1)
        self.combo.connect("changed", self.on_player_changed)
        right.pack_start(self.combo, False, False, 0)
        self.combo.show()

        self.title = Gtk.Label(xalign=0)
        self.title.set_name("title")
        self.title.set_markup("<b>Sin reproducción</b>")
        self.title.set_line_wrap(True)
        self.title.set_max_width_chars(42)
        right.pack_start(self.title, False, False, 0)

        self.artist = Gtk.Label(xalign=0)
        self.artist.set_name("artist")
        right.pack_start(self.artist, False, False, 0)

        controls = Gtk.Box(spacing=10)
        right.pack_start(controls, False, False, 0)

        self.prev_btn = Gtk.Button(label="󰒮")
        self.prev_btn.connect("clicked", lambda _b: self.action("previous"))
        controls.pack_start(self.prev_btn, False, False, 0)

        self.play_btn = Gtk.Button(label="")
        self.play_btn.set_name("play_button")
        self.play_btn.connect("clicked", lambda _b: self.action("play-pause"))
        controls.pack_start(self.play_btn, False, False, 0)

        self.next_btn = Gtk.Button(label="󰒭")
        self.next_btn.connect("clicked", lambda _b: self.action("next"))
        controls.pack_start(self.next_btn, False, False, 0)

        volrow = Gtk.Box(spacing=10)
        right.pack_start(volrow, False, False, 0)

        volrow.pack_start(Gtk.Label(label=""), False, False, 0)

        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        self.vol.set_draw_value(False)
        self.vol.set_hexpand(True)
        self.vol.connect("value-changed", self.set_volume)
        volrow.pack_start(self.vol, True, True, 0)

        self.vol_label = Gtk.Label(label="100%")
        self.vol_label.set_name("volume_label")
        volrow.pack_start(self.vol_label, False, False, 0)

        bottom = Gtk.Box(spacing=10)
        right.pack_end(bottom, False, False, 0)

        open_btn = Gtk.Button(label="Abrir Apple Music")
        open_btn.connect("clicked", lambda _b: focus_or_open_apple_music())
        bottom.pack_start(open_btn, False, False, 0)

        close_btn = Gtk.Button(label="Cerrar")
        close_btn.connect("clicked", lambda _b: Gtk.main_quit())
        bottom.pack_end(close_btn, False, False, 0)

        self.refresh_players()
        self.refresh()
        GLib.timeout_add_seconds(1, self.safe_refresh)
        GLib.timeout_add_seconds(3, self.refresh_players)

    def on_key(self, _w, event):
        if event.keyval == 65307:
            Gtk.main_quit()

    def refresh_players(self):
        ps = players()
        current = self.selected_player

        self.known_players = ps

        self.combo.handler_block_by_func(self.on_player_changed)
        self.combo.remove_all()

        if not ps:
            self.combo.append_text("Sin reproductores activos")
            self.combo.set_active(0)
            self.selected_player = ""
            self.combo.show()
        else:
            if current not in ps:
                current = pick_initial_player()

            self.selected_player = current

            for p in ps:
                self.combo.append_text(pretty_player_name(p))

            try:
                self.combo.set_active(ps.index(current))
            except ValueError:
                self.combo.set_active(0)
                self.selected_player = ps[0]

            # Mostrar siempre el selector para evitar parpadeos/ocultación rara.
            self.combo.show()

        self.combo.handler_unblock_by_func(self.on_player_changed)
        self.queue_resize()
        return True

    def on_player_changed(self, combo):
        idx = combo.get_active()
        ps = self.known_players

        if 0 <= idx < len(ps):
            self.selected_player = ps[idx]
            self.refresh()

    def unlock_action(self):
        self.action_locked = False
        return False

    def action(self, action_name):
        if self.action_locked:
            debug_log(f"[action] ignored repeated click: {action_name}")
            return

        self.action_locked = True
        GLib.timeout_add(450, self.unlock_action)

        player = self.selected_player

        try:
            if not player:
                return

            if action_name == "play-pause":
                player_run_logged(player, ["play-pause"])

            elif action_name == "next":
                # Si el navegador no expone Next por MPRIS, esto hará no-op.
                player_run_logged(player, ["next"])
                GLib.timeout_add(180, lambda: player_run_logged("", ["next"]) or False)

            elif action_name == "previous":
                player_run_logged(player, ["previous"])
                GLib.timeout_add(180, lambda: player_run_logged("", ["previous"]) or False)

            GLib.timeout_add(350, self.safe_refresh)
        except Exception as e:
            debug_log(f"[action] crash prevented: {e!r}")

    def set_volume(self, scale):
        if not self.selected_player:
            return

        value = int(scale.get_value())
        self.vol_label.set_text(f"{value}%")
        set_stream_volume(self.selected_player, value)

    def safe_refresh(self):
        try:
            return self.refresh()
        except Exception as e:
            debug_log(f"[refresh] crash prevented: {e!r}")
            try:
                self.cover.set_from_icon_name("multimedia-player", Gtk.IconSize.DIALOG)
            except Exception:
                pass
            return True

    def refresh(self):
        player = self.selected_player

        if not player:
            self.title.set_markup("<b>Sin reproducción</b>")
            self.artist.set_text("No hay reproductores MPRIS activos")
            self.play_btn.set_label("")
            self.cover.set_from_icon_name("multimedia-player", Gtk.IconSize.DIALOG)
            return True

        title = meta(player, "title", "Sin título")
        artist = meta(player, "artist", "Desconocido")
        status = status_of(player)
        art = player_cmd(player, ["metadata", "mpris:artUrl"])

        self.title.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        self.artist.set_text(f"{artist} · {friendly_status(status)}")

        if status == "Playing":
            self.play_btn.set_label("")
        else:
            self.play_btn.set_label("")

        if hasattr(self, "next_btn"):
            if player_can("next", player):
                self.next_btn.show()
            else:
                self.next_btn.hide()

        if hasattr(self, "prev_btn"):
            if player_can("previous", player):
                self.prev_btn.show()
            else:
                self.prev_btn.hide()

        volume = get_stream_volume(player)
        self.vol.handler_block_by_func(self.set_volume)
        self.vol.set_value(volume)
        self.vol_label.set_text(f"{volume}%")
        self.vol.handler_unblock_by_func(self.set_volume)

        cover_key = (meta(player, "xesam:url", "") or title or "").strip()

        if cover_key and cover_key == self.last_cover_key and self.last_cover_pixbuf:
            self.cover.set_from_pixbuf(self.last_cover_pixbuf)
        else:
            pix = resolve_art_pixbuf(player, art)

            if pix:
                self.last_cover_key = cover_key
                self.last_cover_pixbuf = pix
                self.cover.set_from_pixbuf(pix)
            elif self.last_cover_pixbuf and title and title == self.last_cover_key:
                self.cover.set_from_pixbuf(self.last_cover_pixbuf)
            else:
                self.cover.set_from_icon_name("multimedia-player", Gtk.IconSize.DIALOG)

        return True


setup_css()
win = MediaPopup()
win.show_all()
Gtk.main()
