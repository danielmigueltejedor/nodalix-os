#!/usr/bin/env python3

import gi
import json
import os
import re
import subprocess
import urllib.parse
import urllib.request

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GdkPixbuf, GLib, Gdk


APPLE_MUSIC_CLASS = "chrome-music.apple.com__-Default"
MAX_ART_W = 190
MAX_ART_H = 145


def cmd(args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def run(args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def debug_log(message):
    try:
        with open("/tmp/media-popup-window.log", "a", encoding="utf-8") as f:
            f.write(str(message) + "\n")
    except Exception:
        pass


def players():
    raw = cmd(["playerctl", "-l"])
    found = [p.strip() for p in raw.splitlines() if p.strip()]

    if not found:
        return []

    cleaned = []

    for player in found:
        st = status_of(player)
        title = meta(player, "title", "")
        artist = meta(player, "artist", "")
        art = player_cmd(player, ["metadata", "mpris:artUrl"])

        # Quitar solo sesiones fantasma reales:
        # Stopped + sin título + sin artista + sin carátula.
        if st == "Stopped" and not title and not artist and not art:
            continue

        cleaned.append(player)

    found = cleaned

    if not found:
        return []

    # Deduplicar Apple Music solo si varias sesiones tienen metadata Apple explícita
    # o si su título coincide claramente con la ventana de music.apple.com.
    try:
        clients_raw = cmd(["hyprctl", "clients", "-j"])
        clients = json.loads(clients_raw) if clients_raw else []
    except Exception:
        clients = []

    apple_window_titles = []
    for c in clients:
        klass = (c.get("class") or "").lower()
        win_title = (c.get("title") or "").lower()
        if "music.apple.com" in klass:
            apple_window_titles.append(win_title)

    apple_players = []
    other_players = []

    for player in found:
        title = meta(player, "title", "").lower()
        artist = meta(player, "artist", "").lower()
        raw_meta = player_cmd(player, ["metadata"]).lower()

        is_apple = False

        if "music.apple.com" in raw_meta or "apple music" in raw_meta:
            is_apple = True

        for wt in apple_window_titles:
            if title and title in wt:
                is_apple = True
            elif artist and title and artist in wt:
                is_apple = True

        if is_apple:
            apple_players.append(player)
        else:
            other_players.append(player)

    if apple_players:
        playing = [p for p in apple_players if status_of(p) == "Playing"]
        paused = [p for p in apple_players if status_of(p) == "Paused"]

        if playing:
            selected_apple = playing[0]
        elif paused:
            selected_apple = paused[0]
        else:
            selected_apple = apple_players[0]

        return [selected_apple] + other_players

    return found


def player_cmd(player, args):
    if player:
        return cmd(["playerctl", "-p", player] + args)
    return cmd(["playerctl"] + args)


def player_run(player, args):
    if player:
        run(["playerctl", "-p", player] + args)
    else:
        run(["playerctl"] + args)


def player_run_logged(player, args):
    try:
        cmdline = ["playerctl", "-p", player] + args if player else ["playerctl"] + args
        debug_log("[action] " + " ".join(cmdline))
        subprocess.Popen(cmdline, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        debug_log(f"[action] failed {args}: {e!r}")


def meta(player, key, default=""):
    value = player_cmd(player, ["metadata", "--format", "{{" + key + "}}"])
    return value if value else default


def status_of(player):
    return player_cmd(player, ["status"]) or "Stopped"


def pick_initial_player():
    ps = players()
    if not ps:
        return ""

    for p in ps:
        if status_of(p) == "Playing":
            return p

    return ps[0]


def ellipsize(text, max_len=32):
    text = text or ""
    return text if len(text) <= max_len else text[: max_len - 1] + "…"


def pretty_player_name(player):
    if not player:
        return "Sin reproductor"

    p = player.lower()
    title = meta(player, "title", "").lower()
    artist = meta(player, "artist", "").lower()
    raw_meta = player_cmd(player, ["metadata"]).lower()

    try:
        clients_raw = cmd(["hyprctl", "clients", "-j"])
        clients = json.loads(clients_raw) if clients_raw else []
    except Exception:
        clients = []

    apple_windows = []
    youtube_windows = []

    for c in clients:
        klass = (c.get("class") or "").lower()
        win_title = (c.get("title") or "").lower()

        if "music.apple.com" in klass:
            apple_windows.append(win_title)

        if "youtube" in win_title or "youtu" in klass:
            youtube_windows.append(win_title)

    # Apple Music: metadata directa.
    if "music.apple.com" in raw_meta or "apple music" in raw_meta:
        return "Apple Music"

    # Apple Music: Chromium MPRIS + ventana webapp music.apple.com.
    for wt in apple_windows:
        if title and title in wt:
            return "Apple Music"
        if artist and artist in wt:
            return "Apple Music"
        # Fallback útil: si solo hay una ventana de Apple Music y este player es chromium/chrome.
        if ("chromium" in p or "chrome" in p) and len(apple_windows) == 1:
            return "Apple Music"

    # YouTube.
    if "youtube" in raw_meta or "youtu.be" in raw_meta:
        return "YouTube"

    for wt in youtube_windows:
        if title and title in wt:
            return "YouTube"

    if "spotify" in p:
        return "Spotify"
    if "vlc" in p:
        return "VLC"
    if "firefox" in p:
        return "Firefox"
    if "brave" in p:
        return "Brave"
    if "chromium" in p or "chrome" in p:
        return "Navegador"

    return ellipsize(player.split(".")[0].replace("-", " ").title(), 24)


def get_sink_inputs():
    raw = cmd(["pactl", "list", "sink-inputs"])
    blocks = re.split(r"\nSink Input #", raw)
    out = []

    for block in blocks:
        if not block.strip():
            continue

        first = block.splitlines()[0].strip()
        sid_match = re.match(r"(\d+)", first)
        sid = sid_match.group(1) if sid_match else None
        vol_match = re.search(r"Volume:.*?(\d+)%", block, re.S)

        if sid:
            out.append({
                "id": sid,
                "raw": block,
                "props": block.lower(),
                "volume": int(vol_match.group(1)) if vol_match else 100,
            })

    return out


def find_media_sink(player):
    title = meta(player, "title", "").lower()
    artist = meta(player, "artist", "").lower()
    raw_meta = player_cmd(player, ["metadata"]).lower()
    player_l = (player or "").lower()
    pretty = pretty_player_name(player).lower()

    best = None
    best_score = 0

    # Saber qué tipo de player estamos controlando.
    is_apple_selected = (
        "apple music" in pretty
        or "music.apple.com" in raw_meta
        or "apple music" in raw_meta
    )

    is_youtube_selected = (
        "youtube" in pretty
        or "youtube" in raw_meta
        or "youtu.be" in raw_meta
    )

    for s in get_sink_inputs():
        props = s["props"]
        score = 0

        # Coincidencias fuertes por título/artista del player seleccionado.
        if title and title in props:
            score += 120

        if artist and artist in props:
            score += 60

        # Coincidencia por aplicación/navegador.
        if player_l and player_l in props:
            score += 40

        if "brave" in player_l and "brave" in props:
            score += 35

        if ("chromium" in player_l or "chrome" in player_l) and ("chromium" in props or "chrome" in props):
            score += 35

        # Apple Music solo suma si el player seleccionado ES Apple Music.
        if is_apple_selected and ("apple" in props or "music.apple" in props):
            score += 100

        # YouTube solo suma si el player seleccionado ES YouTube.
        if is_youtube_selected and ("youtube" in props or "youtu" in props):
            score += 100

        # Penalizaciones para evitar tocar Apple Music cuando estás en YouTube.
        if is_youtube_selected and ("apple" in props or "music.apple" in props):
            score -= 200

        # Penalización inversa: evitar tocar YouTube cuando estás en Apple Music.
        if is_apple_selected and ("youtube" in props or "youtu" in props):
            score -= 200

        if score > best_score:
            best = s
            best_score = score

    # Si no hay coincidencia clara, no devolvemos nada para no cambiar el volumen equivocado.
    if best_score < 40:
        return None

    return best

def sink_matches_player(sink, player):
    props = sink["props"]
    pretty = pretty_player_name(player).lower()
    player_l = (player or "").lower()

    if "apple music" in pretty:
        return "application.name = \"chromium\"" in props

    if "youtube" in pretty:
        return "application.name = \"brave\"" in props

    if "brave" in player_l:
        return "application.name = \"brave\"" in props

    if "chromium" in player_l or "chrome" in player_l:
        return "application.name = \"chromium\"" in props

    return False


def sinks_for_player(player):
    return [s for s in get_sink_inputs() if sink_matches_player(s, player)]


def get_stream_volume(player):
    sinks = sinks_for_player(player)
    if sinks:
        return sinks[0]["volume"]

    vol = player_cmd(player, ["volume"])
    try:
        return int(float(vol) * 100)
    except Exception:
        return 100


def set_stream_volume(player, value):
    sinks = sinks_for_player(player)

    if sinks:
        for sink in sinks:
            run(["pactl", "set-sink-input-volume", sink["id"], f"{int(value)}%"])
        return

    player_run(player, ["volume", str(int(value) / 100)])


def player_can(action_name, player):
    if not player:
        return False

    prop = "CanGoNext" if action_name == "next" else "CanGoPrevious"

    try:
        out = subprocess.check_output(
            ["playerctl", "-p", player, "metadata", "--format", "{{mpris:" + prop + "}}"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip().lower()

        return out in ["true", "1", "yes"]
    except Exception:
        return False


def friendly_status(status):
    if status == "Playing":
        return "Reproduciendo"
    if status == "Paused":
        return "Pausado"
    if status == "Stopped":
        return "Detenido"
    return status or "Desconocido"


def focus_or_open_apple_music():
    run([
        "nodalix-launch-or-focus",
        APPLE_MUSIC_CLASS,
        "gtk-launch apple-music",
    ])


