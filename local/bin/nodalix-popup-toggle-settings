#!/usr/bin/env bash
set -euo pipefail

if command -v nodalix-settings-menu >/dev/null 2>&1; then
  exec nodalix-settings-menu
fi

if [ -x "$HOME/Proyectos/nodalix-os/local/bin/nodalix-settings-menu" ]; then
  exec "$HOME/Proyectos/nodalix-os/local/bin/nodalix-settings-menu"
fi

notify-send "Nodalix" "No encuentro nodalix-settings-menu"
