#!/usr/bin/env sh
set -eu

APP_DIR="/home/dani/Projects/nodalix-os/apps/nodalix-dock"
RELEASE="$APP_DIR/target/release/nodalix-dock"
DEBUG="$APP_DIR/target/debug/nodalix-dock"

if [ -x "$RELEASE" ]; then
  exec "$RELEASE" "$@"
fi

if [ -x "$DEBUG" ]; then
  exec "$DEBUG" "$@"
fi

cd "$APP_DIR"
exec cargo run -- "$@"

