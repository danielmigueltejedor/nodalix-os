#!/usr/bin/env bash
set -euo pipefail

if command -v nodalix-volume-menu >/dev/null 2>&1; then
  exec nodalix-volume-menu
fi

if [ -x "$HOME/Projects/nodalix-os/local/bin/nodalix-volume-menu" ]; then
  exec "$HOME/Projects/nodalix-os/local/bin/nodalix-volume-menu"
fi

notify-send "Nodalix" "No encuentro nodalix-volume-menu"
