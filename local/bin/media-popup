#!/usr/bin/env bash
set -euo pipefail

APP="$HOME/.local/bin/media-popup-window"
LOG="/tmp/media-popup-window.log"

# Solo cierra otros popups de la isla central.
nodalix-close-center-popups "media-popup-window"

# Toggle exacto por clase.
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "media-popup-window")' >/dev/null; then
  pkill -f "media-popup-window" 2>/dev/null || true
  exit 0
fi

nohup "$APP" >"$LOG" 2>&1 &
~/.local/bin/nodalix-position-popup-right "media-popup-window" 420 320 14 >/dev/null 2>&1 &
