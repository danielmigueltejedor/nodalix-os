#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-help}"
shift || true

case "$cmd" in
  terminal)
    exec ghostty "$@"
    ;;

  terminal-tmux)
    exec ghostty -e tmux new -A -s main
    ;;

  browser)
    if [[ "${1:-}" == "--private" ]]; then
      exec zen-browser --private-window
    fi
    exec zen-browser "$@"
    ;;

  editor)
    if command -v zed >/dev/null 2>&1; then
      exec zed "$@"
    elif command -v cursor >/dev/null 2>&1; then
      exec cursor "$@"
    else
      exec code "$@"
    fi
    ;;

  nautilus)
    exec nautilus "$@"
    ;;

  nautilus-cwd)
    exec nautilus "$(pwd)"
    ;;

  passwords)
    exec bitwarden "$@"
    ;;

  mail)
    exec thunderbird "$@"
    ;;

  maps)
    exec gnome-maps "$@"
    ;;

  share)
    exec localsend_app "$@"
    ;;

  help|ayuda|*)
    cat <<'HELP'
Nodalix commands:

  nodalix terminal       Open Ghostty
  nodalix terminal-tmux  Open Ghostty with tmux
  nodalix browser        Open Zen Browser
  nodalix browser --private
  nodalix editor         Open Zed/Cursor/Code
  nodalix nautilus       Open file manager
  nodalix nautilus-cwd   Open file manager in current directory
  nodalix passwords      Open Bitwarden
  nodalix mail           Open Thunderbird
  nodalix maps           Open GNOME Maps
  nodalix share          Open LocalSend
HELP
    ;;
esac
