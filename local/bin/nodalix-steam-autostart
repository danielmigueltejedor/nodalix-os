#!/usr/bin/env bash

# Wait for the graphical Wayland/Hyprland session to be ready.
sleep 15

# Do not start another Steam instance if it is already running.
if pgrep -u "$USER" -x steam >/dev/null 2>&1 || pgrep -u "$USER" -f '/Steam/ubuntu12_32/steam' >/dev/null 2>&1; then
  exit 0
fi

# Start Steam silently for background game updates using the RX 9070 XT wrapper.
nohup /home/dani/.local/bin/steam-rx9070xt -silent >/tmp/nodalix-steam-autostart.log 2>&1 &
