#!/usr/bin/env bash
set -euo pipefail

# Esperar a que Wayland/Hyprland y la red estén listos
sleep 8

# Si Steam ya está corriendo, no abrir otra instancia
if pgrep -x steam >/dev/null 2>&1 || pgrep -f "steamwebhelper" >/dev/null 2>&1; then
  exit 0
fi

# Lanzar Steam en modo silencioso/minimizado
steam -silent >/tmp/nodalix-steam-autostart.log 2>&1 &
