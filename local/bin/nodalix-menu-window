#!/usr/bin/env python3

import gi
import subprocess

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

APP_TITLE = "Nodalix"


def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def has_cmd(cmd):
    try:
        subprocess.check_output("command -v " + cmd, shell=True, text=True, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def notify(title, message):
    run("notify-send " + repr(title) + " " + repr(message))


