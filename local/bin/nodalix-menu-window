class NodalixMenu(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_TITLE)

        self.set_default_size(WIDTH, HEIGHT)
        self.set_resizable(True)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        self.sections = [
            ("general", "N", "Inicio", "Accesos rápidos y estado"),
            ("nodalix", "N", "Nodalix", "Files, Command Bar y configuración"),
            ("appearance", "󰉼", "Apariencia", "Tema, Waybar y efectos"),
            ("network", "󰖩", "Red y firewall", "Wi-Fi, IP, DNS, firewall"),
            ("bluetooth", "󰂯", "Bluetooth", "Dispositivos y emparejado"),
            ("audio", "󰕾", "Audio", "Salida, entrada y volumen"),
            ("displays", "󰍹", "Pantallas", "Monitores, escala y Hz"),
            ("storage", "󰋊", "Almacenamiento", "Discos y limpieza"),
            ("ai", "󰚩", "IA del sistema", "Permisos y herramientas"),
            ("bundles", "󰏗", "Bundles", "Módulos instalados"),
            ("security", "󰌾", "Seguridad", "Privacidad y antivirus"),
            ("updates", "󰚰", "Actualizaciones", "Sistema y paquetes"),
            ("power", "󰐥", "Energía", "Suspender, reiniciar, apagar"),
        ]

        self.active = "general"

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_name("root")
        self.add(root)

        self.build_header(root)
        self.build_search(root)
        self.build_body(root)
        self.build_footer(root)

        self.render_sidebar()
        self.render_page()

    def build_header(self, root):
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        root.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.pack_start(title_box, True, True, 0)

        title = make_brand_header("Nodalix Menu")
        title_box.pack_start(title, False, False, 0)

        subtitle = Gtk.Label(
            label="Centro de control de Nodalix: sistema, apariencia, red, IA, bundles y mantenimiento",
            xalign=0,
        )
        subtitle.set_name("header_subtitle")
        title_box.pack_start(subtitle, False, False, 0)

        close = Gtk.Button(label="Cerrar")
        close.connect("clicked", lambda *_: self.destroy())
        header.pack_start(close, False, False, 0)

    def build_search(self, root):
        self.search = Gtk.SearchEntry()
        self.search.set_name("search")
        self.search.set_placeholder_text("Buscar ajustes, apps, red, apariencia, IA, mantenimiento…")
        self.search.connect("search-changed", lambda *_: self.render_sidebar())
        root.pack_start(self.search, False, False, 0)

    def build_body(self, root):
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        root.pack_start(body, True, True, 0)

        sidebar_outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sidebar_outer.set_name("sidebar")
        sidebar_outer.set_size_request(285, -1)
        body.pack_start(sidebar_outer, False, False, 0)

        sidebar_scroll = Gtk.ScrolledWindow()
        sidebar_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scroll.set_min_content_height(0)
        sidebar_outer.pack_start(sidebar_scroll, True, True, 0)

        self.sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        sidebar_scroll.add(self.sidebar)

        page_scroll = Gtk.ScrolledWindow()
        page_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page_scroll.set_name("page")
        body.pack_start(page_scroll, True, True, 0)

        self.page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page_scroll.add(self.page)

    def build_footer(self, root):
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_name("footer")

        hint = Gtk.Label(label="Controles de energía")
        hint.set_name("footer_hint")
        hint.set_xalign(0)
        footer.pack_start(hint, True, True, 8)

        sleep_btn = Gtk.Button(label="󰤄  Suspender")
        sleep_btn.set_name("sleep_button")
        sleep_btn.connect("clicked", lambda *_: self.confirm_power("Suspender", "systemctl suspend"))
        footer.pack_start(sleep_btn, False, False, 0)

        restart_btn = Gtk.Button(label="󰜉  Reiniciar")
        restart_btn.set_name("restart_button")
        restart_btn.connect("clicked", lambda *_: self.confirm_power("Reiniciar", "systemctl reboot"))
        footer.pack_start(restart_btn, False, False, 0)

        power_btn = Gtk.Button(label="󰐥  Apagar")
        power_btn.set_name("power_button")
        power_btn.connect("clicked", lambda *_: self.confirm_power("Apagar", "systemctl poweroff"))
        footer.pack_start(power_btn, False, False, 0)

        root.pack_start(footer, False, False, 0)

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def clear(self, box):
        for child in box.get_children():
            box.remove(child)

    def render_sidebar(self):
        self.clear(self.sidebar)
        query = self.search.get_text().lower().strip()

        for sid, icon, title, subtitle in self.sections:
            haystack = f"{sid} {title} {subtitle}".lower()
            if query and query not in haystack:
                continue

            btn = Gtk.Button()
            btn.set_name("section_button_active" if sid == self.active else "section_button")
            btn.connect("clicked", lambda _b, s=sid: self.set_section(s))

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
            btn.add(row)

            icon_label = Gtk.Label(label=icon)
            icon_label.set_name("section_icon")
            row.pack_start(icon_label, False, False, 0)

            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            row.pack_start(text, True, True, 0)

            title_label = Gtk.Label(label=title, xalign=0)
            title_label.set_name("section_title")
            text.pack_start(title_label, False, False, 0)

            subtitle_label = Gtk.Label(label=subtitle, xalign=0)
            subtitle_label.set_name("section_subtitle")
            text.pack_start(subtitle_label, False, False, 0)

            self.sidebar.pack_start(btn, False, False, 0)

        self.sidebar.show_all()

    def set_section(self, sid):
        self.active = sid
        self.render_sidebar()
        self.render_page()

    def header(self, title, subtitle):
        title_label = Gtk.Label(label=title, xalign=0)
        title_label.set_name("page_title")
        self.page.pack_start(title_label, False, False, 0)

        subtitle_label = Gtk.Label(label=subtitle, xalign=0)
        subtitle_label.set_name("page_subtitle")
        self.page.pack_start(subtitle_label, False, False, 4)

    def card(self, icon, title, subtitle, buttons=None, badge=None, warn=False):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_name("card")

        icon_label = Gtk.Label(label=icon)
        icon_label.set_name("section_icon")
        box.pack_start(icon_label, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.pack_start(text, True, True, 0)

        title_label = Gtk.Label(label=title, xalign=0)
        title_label.set_name("card_title")
        text.pack_start(title_label, False, False, 0)

        subtitle_label = Gtk.Label(label=subtitle, xalign=0)
        subtitle_label.set_name("card_subtitle")
        subtitle_label.set_line_wrap(True)
        subtitle_label.set_max_width_chars(72)
        text.pack_start(subtitle_label, False, False, 0)

        if badge:
            badge_label = Gtk.Label(label=badge)
            badge_label.set_name("badge_warn" if warn else "badge_ok")
            box.pack_start(badge_label, False, False, 0)

        for label, cmd, style in buttons or []:
            btn = Gtk.Button(label=label)
            if style:
                btn.set_name(style)
            btn.connect("clicked", lambda _b, c=cmd: run(c))
            box.pack_start(btn, False, False, 0)

        self.page.pack_start(box, False, False, 0)

    def confirm_power(self, title, command):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=title,
        )
        dialog.format_secondary_text("Esta acción afectará a la sesión actual.")
        response = dialog.run()
        dialog.destroy()

        if response == Gtk.ResponseType.OK:
            run(command)

    def render_page(self):
        self.clear(self.page)

        if self.active == "general":
            host, kernel, uptime, session, version = system_summary()
            self.header("Inicio", "Accesos rápidos y resumen del sistema")
            self.card("󰌢", "Equipo", f"{host} · {session}", badge="Activo")
            self.card("N", "Nodalix", version, buttons=[
                ("Command Bar", "nodalix-command-bar-toggle", "primary_button"),
                ("Files", "nodalix-files-popup", None),
                ("Terminal", "ghostty || alacritty || xterm", None),
            ])
            self.card("󰒋", "Sistema", f"Kernel: {kernel}\nUptime: {uptime}", buttons=[
                ("btop", terminal("btop"), "primary_button"),
                ("Logs Waybar", terminal("tail -n 160 /tmp/waybar.log"), None),
            ])
            self.card("󰊢", "Proyecto", "Repositorio local de Nodalix OS.", buttons=[
                ("Abrir repo", "xdg-open ~/Proyectos/nodalix-os", "primary_button"),
                ("Git status", terminal("cd ~/Proyectos/nodalix-os && git status --short"), None),
            ])

        elif self.active == "nodalix":
            self.header("Nodalix", "Centro de herramientas de Nodalix OS")
            self.card("N", "Command Bar", "Lanzador rápido principal de Nodalix.", buttons=[
                ("Abrir", "nodalix-command-bar-toggle", "primary_button"),
                ("Editar", "zed ~/Proyectos/nodalix-os/local/bin/nodalix-command-bar", None),
            ])
            self.card("", "Nodalix Files", "Gestor de archivos propio integrado en la isla derecha.", buttons=[
                ("Abrir", "nodalix-files-popup", "primary_button"),
                ("Proyecto", "xdg-open ~/Proyectos/nodalix-os/apps/nodalix-files", None),
            ])
            self.card("󰘳", "Configuración Hyprland", "Look & Feel, bindings, monitores y reglas de ventana.", buttons=[
                ("looknfeel.lua", "zed ~/.config/hypr/looknfeel.lua", "primary_button"),
                ("bindings.lua", "zed ~/.config/hypr/bindings.lua", None),
                ("Recargar", "hyprctl reload && notify-send 'Nodalix' 'Hyprland recargado'", None),
            ])
            self.card("󰕮", "Waybar", "Config, estilos y reinicio rápido de la barra.", buttons=[
                ("config.jsonc", "zed ~/.config/waybar/config.jsonc", "primary_button"),
                ("style.css", "zed ~/.config/waybar/style.css", None),
                ("Reiniciar", "pkill waybar; waybar >/tmp/waybar.log 2>&1 &", None),
            ])
            self.card("󰊢", "Repositorio", "Estado Git y sincronización con GitHub.", buttons=[
                ("Git status", terminal("cd ~/Proyectos/nodalix-os && git status --short"), "primary_button"),
                ("Abrir GitHub", "xdg-open https://github.com/danielmigueltejedor/nodalix-os", None),
            ])

        elif self.active == "appearance":
            self.header("Apariencia", "Tema, Waybar, Hyprland y experiencia visual")
            self.card("󰉼", "Look & Feel", "Editar configuración visual principal.", buttons=[
                ("Editar", "zed ~/.config/hypr/looknfeel.lua", "primary_button"),
                ("Recargar", "hyprctl reload && notify-send 'Nodalix' 'Hyprland recargado'", None),
            ])
            self.card("󰝤", "Color de acento", "Cambia el acento global de Nodalix: bordes Hyprland, GTK, apps Nodalix y temas compatibles.", buttons=[
                ("Elegir…", "nodalix-accent-color custom", "primary_button"),
                ("Morado", "nodalix-accent-color purple", None),
                ("Azul", "nodalix-accent-color blue", None),
                ("Rosa", "nodalix-accent-color pink", None),
                ("Verde", "nodalix-accent-color green", None),
                ("Naranja", "nodalix-accent-color orange", None),
            ])
            self.card("󰘳", "Tema actual", "Muestra el tema Nodalix activo guardado en ~/.config/nodalix/theme.json.", buttons=[
                ("Ver tema", terminal("nodalix-accent-color show"), "primary_button"),
                ("Abrir config", "zed ~/.config/nodalix/theme.json", None),
            ])
            self.card("󰝤", "Color de acento", "Cambia el acento global de Nodalix: bordes Hyprland, GTK, apps Nodalix y temas compatibles.", buttons=[
                ("Elegir…", "nodalix-accent-color custom", "primary_button"),
                ("Morado", "nodalix-accent-color purple", None),
                ("Azul", "nodalix-accent-color blue", None),
                ("Rosa", "nodalix-accent-color pink", None),
                ("Verde", "nodalix-accent-color green", None),
                ("Naranja", "nodalix-accent-color orange", None),
            ])
            self.card("󰘳", "Tema actual", "Muestra el tema Nodalix activo guardado en ~/.config/nodalix/theme.json.", buttons=[
                ("Ver tema", terminal("nodalix-accent-color show"), "primary_button"),
                ("Abrir config", "zed ~/.config/nodalix/theme.json", None),
            ])
            self.card("󰕮", "Waybar", "Reiniciar barra superior.", buttons=[
                ("Reiniciar", "pkill waybar; waybar >/tmp/waybar.log 2>&1 &", "primary_button"),
                ("Toggle", "nodalix-toggle-waybar", None),
            ])
            self.card("󰸉", "Fondos", "Wallpaper Engine / fondos animados.", buttons=[
                ("WPE", "wpe-menu", "primary_button"),
                ("Carpeta", "xdg-open ~/.config/wpe-hypr", None),
            ])

        elif self.active == "network":
            wifi, ip, active, tailscale = network_summary()
            fw_name, fw_state = firewall_summary()
            self.header("Red y firewall", "Wi-Fi, IP, Tailscale, DNS y protección de red")
            self.card("󰖩", "Wi-Fi", f"Radio: {wifi}", buttons=[
                ("Abrir Wi-Fi", "nodalix-wifi-menu", "primary_button"),
                ("Conexiones", "nm-connection-editor", None),
            ])
            self.card("󰈀", "Conexiones activas", active)
            self.card("󰩠", "IP local / Tailscale", f"LAN: {ip} · Tailscale: {tailscale}")
            self.card("󰌾", fw_name, fw_state, buttons=[
                ("Estado", terminal("systemctl status firewalld ufw nftables --no-pager"), "primary_button"),
                ("Reglas", terminal("sudo nft list ruleset 2>/dev/null || sudo ufw status verbose 2>/dev/null || firewall-cmd --list-all"), None),
            ], badge="Firewall", warn=True)

        elif self.active == "bluetooth":
            powered, devices = bluetooth_summary()
            self.header("Bluetooth", "Dispositivos, emparejamiento y estado")
            self.card("󰂯", "Estado", f"Powered: {powered}", buttons=[
                ("Abrir BT", "nodalix-bt-menu", "primary_button"),
                ("Alternar", "bluetoothctl power toggle", None),
            ])
            self.card("󰂱", "Conectados", devices, buttons=[
                ("Terminal", terminal("bluetoothctl devices; echo; bluetoothctl devices Connected"), None),
            ])

        elif self.active == "audio":
            vol, sink, source = audio_summary()
            self.header("Audio", "Salida, entrada, volumen y control rápido")
            self.card("󰕾", "Volumen", f"{vol}%", buttons=[
                ("Abrir Audio", "nodalix-volume-menu", "primary_button"),
                ("Mute", "pamixer -t", None),
            ])
            self.card("󰓃", "Salida", sink)
            self.card("󰍬", "Entrada", source)

        elif self.active == "displays":
            monitors = sh("hyprctl monitors | grep -E 'Monitor|focused|scale|transform|availableModes' | head -n 16") or "Sin datos"
            self.header("Pantallas", "Monitores, escala, frecuencia y posición")
            self.card("󰍹", "Monitores Hyprland", monitors, buttons=[
                ("Editar", "zed ~/.config/hypr/monitors.lua", "primary_button"),
                ("Ver", terminal("hyprctl monitors"), None),
                ("Recargar", "hyprctl reload", None),
            ])

        elif self.active == "storage":
            root, home, disks = storage_summary()
            self.header("Almacenamiento", "Uso de disco, limpieza y mantenimiento")
            self.card("󰋊", "Raíz /", root)
            self.card("󰋜", "Home", home)
            self.card("󰋊", "Discos", disks, buttons=[
                ("Analizar", "baobab || notify-send 'Nodalix' 'Baobab no instalado'", "primary_button"),
                ("Terminal", terminal("df -h; echo; lsblk"), None),
            ])
            self.card("󰃢", "Limpieza", "Caché de usuario y paquetes.", buttons=[
                ("Ver cachés", terminal("du -sh ~/.cache/* 2>/dev/null | sort -h | tail -40"), None),
                ("Limpiar pacman", terminal("sudo paccache -r"), "primary_button"),
            ])

        elif self.active == "ai":
            self.header("IA del sistema", "Herramientas, permisos y privacidad")
            self.card("󰚩", "Herramientas detectadas", ai_summary())
            self.card("󰌾", "Privacidad IA", "Control de micro, cámara, pantalla y contexto del sistema.", buttons=[
                ("Privacidad", "nodalix-privacy-menu", "primary_button"),
                ("Procesos IA", terminal("ps aux | grep -Ei 'ollama|openai|codex|cursor|node|python' | grep -v grep"), None),
            ])
            self.card("󰊄", "Uso local vs nube", "Preparado para alternar proveedores IA en futuras versiones.", badge="Roadmap", warn=True)

        elif self.active == "bundles":
            self.header("Bundles", "Componentes, módulos y extras instalados")
            self.card("󰏗", "Componentes Nodalix", bundles_summary())
            self.card("󰚰", "Gestión de bundles", "Instalación, desinstalación y feedback visual.", buttons=[
                ("Abrir repo", "xdg-open ~/Proyectos/nodalix-os", "primary_button"),
                ("Scripts", "xdg-open ~/Proyectos/nodalix-os/local/bin", None),
            ])

        elif self.active == "security":
            self.header("Seguridad", "Privacidad, bloqueo, antivirus y procesos")
            self.card("󰌾", "Privacidad activa", "Micro, cámara, pantalla, ubicación e indicadores sensibles.", buttons=[
                ("Privacidad", "nodalix-privacy-menu", "primary_button"),
                ("Bloquear", "nodalix-system-lock", None),
            ])
            self.card("󰒃", "Antivirus", "ClamAV si está instalado.", buttons=[
                ("Escanear home", terminal("clamscan -r ~/ --bell -i"), "primary_button"),
                ("Instalar ClamAV", terminal("yay -S clamav"), None),
            ])
            self.card("󰈸", "Procesos", "Vista avanzada del sistema.", buttons=[
                ("btop", terminal("btop"), "primary_button"),
                ("ps", terminal("ps aux --sort=-%cpu | head -40"), None),
            ])

        elif self.active == "updates":
            self.header("Actualizaciones", "Sistema, paquetes y mantenimiento")
            self.card("󰚰", "Estado", updates_summary(), buttons=[
                ("Comprobar", terminal("checkupdates 2>/dev/null || yay -Qu"), "primary_button"),
                ("Actualizar", terminal("yay -Syu"), "primary_button"),
            ])
            self.card("󰏖", "Mantenimiento", "Sync, paquetes huérfanos y limpieza.", buttons=[
                ("Sync", terminal("sudo pacman -Syy"), None),
                ("Huérfanos", terminal("pacman -Qtdq 2>/dev/null || true"), None),
            ])

        elif self.active == "power":
            self.header("Energía", "Suspender, reiniciar y apagar")
            self.card("󰤄", "Suspender", "Suspende el equipo de forma segura.", buttons=[
                ("Suspender", "systemctl suspend", "sleep_button"),
            ])
            self.card("󰜉", "Reiniciar", "Reinicia el sistema.", buttons=[
                ("Reiniciar", "systemctl reboot", "restart_button"),
            ])
            self.card("󰐥", "Apagar", "Apaga el equipo.", buttons=[
                ("Apagar", "systemctl poweroff", "power_button"),
            ])

        self.page.show_all()


def main():
    setup_css()
    win = NodalixMenu()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
