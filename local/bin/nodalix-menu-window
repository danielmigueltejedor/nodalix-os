#!/usr/bin/env python3
import gi
import os
import json
import shutil
import subprocess
from pathlib import Path

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf

APP_TITLE = "Nodalix Menu"
WIDTH = 1180
HEIGHT = 760
NODALIX_LOGO_CANDIDATES = [
    Path("/etc/nodalix/brand/nodalix-logo-symbol.svg"),
    Path("/usr/share/nodalix/brand/nodalix-logo-symbol.svg"),
    Path("/home/dani/Proyectos/nodalix-os/assets/brand/nodalix-logo-symbol.svg"),
]


def sh(cmd, timeout=3):
    try:
        return subprocess.check_output(
            cmd,
            shell=True,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        ).strip()
    except Exception:
        return ""


def exists(cmd):
    return shutil.which(cmd) is not None


def run(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def nodalix_logo_path():
    return next((path for path in NODALIX_LOGO_CANDIDATES if path.is_file()), None)


def make_brand_header(text):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
    box.set_valign(Gtk.Align.CENTER)
    logo_path = nodalix_logo_path()
    if logo_path:
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(logo_path), 30, 30, True)
            image = Gtk.Image.new_from_pixbuf(pix)
            image.set_name("brand_logo")
            box.pack_start(image, False, False, 0)
        except Exception:
            pass
    label = Gtk.Label(label=text, xalign=0)
    label.set_name("header_title")
    box.pack_start(label, True, True, 0)
    return box


def notify(title, body):
    run(f"notify-send {title!r} {body!r}")


def terminal(command):
    payload = command + '; echo; read -p "Pulsa Enter para cerrar..."'
    quoted = json.dumps(payload)

    if exists("ghostty"):
        return f"ghostty -e bash -lc {quoted}"
    if exists("alacritty"):
        return f"alacritty -e bash -lc {quoted}"
    return f"xterm -e bash -lc {quoted}"


def system_summary():
    host = sh("hostname") or "dani-desktop"
    kernel = sh("uname -r") or "Kernel no disponible"
    uptime = sh("uptime -p").replace("up ", "") or "No disponible"
    session = os.environ.get("XDG_CURRENT_DESKTOP") or "Hyprland"
    version = sh("nodalix-version 2>/dev/null") or "Nodalix local build"
    return host, kernel, uptime, session, version


def network_summary():
    wifi = sh("nmcli radio wifi") or "desconocido"
    ip = sh("hostname -I | awk '{print $1}'") or "sin IP"
    active = sh("nmcli -t -f NAME,TYPE,DEVICE connection show --active | head -n 4") or "sin datos"
    tailscale = sh("tailscale ip -4 2>/dev/null | head -n1") or "no detectado"
    return wifi, ip, active, tailscale


def firewall_summary():
    if exists("ufw"):
        out = sh("ufw status 2>/dev/null | head -n1")
        if out:
            return "UFW", out
    if exists("firewall-cmd"):
        out = sh("firewall-cmd --state 2>/dev/null")
        if out:
            return "firewalld", out
    nft = sh("systemctl is-active nftables 2>/dev/null")
    if nft:
        return "nftables", nft
    return "Firewall", "No detectado"


def bluetooth_summary():
    powered = sh("bluetoothctl show 2>/dev/null | awk '/Powered/ {print $2}'") or "desconocido"
    devices = sh("bluetoothctl devices Connected 2>/dev/null | sed 's/^Device //' | head -n 5") or "Sin dispositivos conectados"
    return powered, devices


def audio_summary():
    vol = sh("pamixer --get-volume 2>/dev/null") or "?"
    sink = sh("pactl get-default-sink 2>/dev/null") or "No detectada"
    source = sh("pactl get-default-source 2>/dev/null") or "No detectada"
    return vol, sink, source


def storage_summary():
    root = sh("df -h / | awk 'NR==2 {print $3\" / \"$2\" · \"$5}'") or "Sin datos"
    home = sh("df -h $HOME | awk 'NR==2 {print $3\" / \"$2\" · \"$5}'") or "Sin datos"
    disks = sh("lsblk -dn -o NAME,SIZE,TYPE | head -n 5") or "Sin discos"
    return root, home, disks


def updates_summary():
    if exists("checkupdates"):
        pending = sh("checkupdates 2>/dev/null | wc -l", timeout=5) or "0"
        return f"{pending} paquetes pendientes"
    return "checkupdates no disponible"


def ai_summary():
    tools = []
    for name, cmd in [
        ("Ollama", "ollama"),
        ("Codex", "codex"),
        ("Cursor", "cursor"),
        ("OpenAI CLI", "openai"),
        ("GitHub CLI", "gh"),
    ]:
        if exists(cmd):
            tools.append(name)
    return ", ".join(tools) if tools else "Sin herramientas IA detectadas en PATH"


def bundles_summary():
    out = sh("find ~/.local/bin ~/Proyectos/nodalix-os/local/bin -maxdepth 1 -type f -name 'nodalix-*' 2>/dev/null | sed 's#.*/##' | sort | head -n 18")
    return out or "Sin componentes detectados"


