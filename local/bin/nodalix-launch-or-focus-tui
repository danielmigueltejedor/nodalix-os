#!/usr/bin/env bash
set -euo pipefail

cmd="${*:-}"

if [[ -z "$cmd" ]]; then
  exec nodalix-launch-tui
fi

title="TUI.float"

address="$(
  hyprctl clients -j 2>/dev/null \
    | jq -r --arg q "$title" '
      .[]
      | select(
          (.class // "" | test($q; "i"))
          or (.title // "" | test($q; "i"))
          or (.initialTitle // "" | test($q; "i"))
        )
      | .address
    ' \
    | head -n 1
)"

if [[ -n "$address" && "$address" != "null" ]]; then
  hyprctl dispatch focuswindow "address:$address" >/dev/null
else
  exec ghostty --class=TUI.float -e bash -lc "$cmd"
fi
