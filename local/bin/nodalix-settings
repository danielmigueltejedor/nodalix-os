#!/usr/bin/env bash
set -euo pipefail

if [ -x /usr/local/bin/nodalix-settings ]; then
  exec /usr/local/bin/nodalix-settings "$@"
fi

if [ -x "$HOME/Proyectos/nodalix-os/apps/nodalix-settings/target/debug/nodalix-settings" ]; then
  exec "$HOME/Proyectos/nodalix-os/apps/nodalix-settings/target/debug/nodalix-settings" "$@"
fi

if command -v nodalix-settings-menu >/dev/null 2>&1; then
  exec nodalix-settings-menu "$@"
fi

exec nodalix-command-bar-toggle "$@"
