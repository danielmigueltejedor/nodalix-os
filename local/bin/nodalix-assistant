#!/usr/bin/env sh
set -eu

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
APP_DIR="$ROOT_DIR/crates/nodalix-assistant-core"
RELEASE="$APP_DIR/target/release/nodalix-assistant-core"
DEBUG="$APP_DIR/target/debug/nodalix-assistant-core"

if [ -x "$RELEASE" ]; then
  exec "$RELEASE" "$@"
fi

if [ -x "$DEBUG" ]; then
  exec "$DEBUG" "$@"
fi

cd "$APP_DIR"
exec cargo run -- "$@"
