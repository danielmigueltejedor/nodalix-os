#!/usr/bin/env bash
set -euo pipefail

URL="${1:-}"
APP_ID="${2:-Nodalix Web App}"

if [ -z "$URL" ]; then
  notify-send "Nodalix Web Apps" "Uso: nodalix-launch-webapp <url> [app-id]" 2>/dev/null || true
  exit 1
fi

export MOZ_ENABLE_WAYLAND=1
export BROWSER=zen-browser

# Zen/Firefox no tiene --app como Chromium, así que usamos ventana nueva limpia.
# Más adelante podemos evolucionarlo a perfiles dedicados por webapp.
exec zen-browser --new-window "$URL"
