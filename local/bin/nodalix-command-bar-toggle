#!/usr/bin/env python3

import json
import subprocess
import time


COMMAND = "nodalix-command-bar"
CLASS = "nodalix-command-bar"
TITLE = "Nodalix Command Bar"


def sh(args):
    try:
        return subprocess.check_output(
            args,
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""


def run(args):
    subprocess.Popen(
        args,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def get_command_bar_clients():
    raw = sh(["hyprctl", "clients", "-j"])

    if not raw:
        return []

    try:
        clients = json.loads(raw)
    except Exception:
        return []

    matches = []

    for client in clients:
        address = str(client.get("address") or "")
        klass = str(client.get("class") or "")
        initial_class = str(client.get("initialClass") or "")
        title = str(client.get("title") or "")
        pid = client.get("pid")

        if address and (
            klass == CLASS
            or initial_class == CLASS
            or title == TITLE
        ):
            matches.append({
                "address": address,
                "pid": str(pid) if pid else "",
            })

    return matches


def close_existing():
    clients = get_command_bar_clients()

    if not clients:
        return False

    for client in clients:
        address = client["address"]

        # Primero intentamos cierre limpio por Hyprland.
        subprocess.run(
            ["hyprctl", "dispatch", "closewindow", f"address:{address}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    time.sleep(0.15)

    # Si Hyprland no la cerró, matamos el PID exacto de la ventana.
    remaining = get_command_bar_clients()

    for client in remaining:
        pid = client.get("pid")

        if pid:
            subprocess.run(
                ["kill", pid],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    return True


def main():
    if close_existing():
        return 0

    run([COMMAND])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
