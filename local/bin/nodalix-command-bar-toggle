#!/usr/bin/env bash
set -euo pipefail

APP_RELEASE="$HOME/Proyectos/nodalix-os/apps/nodalix-command-bar/target/release/nodalix-command-bar"
APP_DEBUG="$HOME/Proyectos/nodalix-os/apps/nodalix-command-bar/target/debug/nodalix-command-bar"
APP_SOURCE="$HOME/Proyectos/nodalix-os/apps/nodalix-command-bar/src/nodalix-command-bar"
APP_DIR="$HOME/Proyectos/nodalix-os/apps/nodalix-command-bar"

# If already open, close it.
if hyprctl clients -j 2>/dev/null | jq -e '
  .[] | select(
    (.class // "" | test("nodalix-command-bar"; "i")) or
    (.initialClass // "" | test("nodalix-command-bar"; "i")) or
    (.title // "" | test("Nodalix Command Bar"; "i")) or
    (.initialTitle // "" | test("Nodalix Command Bar"; "i"))
  )
' >/dev/null; then
  pkill -f "nodalix-command-bar" 2>/dev/null || true
  exit 0
fi

# Prefer release binary, then debug binary, then Python/source app, then cargo run.
if [[ -x "$APP_RELEASE" ]]; then
  exec "$APP_RELEASE"
fi

if [[ -x "$APP_DEBUG" ]]; then
  exec "$APP_DEBUG"
fi

if [[ -x "$APP_SOURCE" ]]; then
  exec "$APP_SOURCE"
fi

if [[ -d "$APP_DIR" && -f "$APP_DIR/Cargo.toml" ]]; then
  cd "$APP_DIR"
  exec cargo run
fi

notify-send "Nodalix Command Bar" "No encuentro la app en apps/nodalix-command-bar"
exit 1
