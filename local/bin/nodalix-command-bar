#!/usr/bin/env python3

import gi
import json
import os
import subprocess
import shlex
import fcntl
from pathlib import Path

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf


APP_TITLE = "Nodalix Command Bar"

REPO_ROOT = Path(__file__).resolve().parents[2]
USER_ACTIONS_FILE = Path.home() / ".config/nodalix/actions.json"
REPO_ACTIONS_FILE = REPO_ROOT / "config/nodalix/actions.json"


def load_actions_from_json():
    candidates = [
        USER_ACTIONS_FILE,
        REPO_ACTIONS_FILE,
    ]

    for file in candidates:
        if not file.exists():
            continue

        try:
            data = json.loads(file.read_text())
        except Exception:
            continue

        if not isinstance(data, list):
            continue

        actions = []

        for raw in data:
            if not isinstance(raw, dict):
                continue

            title = str(raw.get("title") or "").strip()
            command = str(raw.get("command") or "").strip()

            if not title or not command:
                continue

            actions.append({
                "kind": "action",
                "icon": str(raw.get("icon") or "󰒓"),
                "title": title,
                "subtitle": str(raw.get("subtitle") or "Acción"),
                "search": str(raw.get("search") or title).lower(),
                "command": command,
            })

        if actions:
            return actions

    return None


LOCK_FILE_HANDLE = None


def acquire_single_instance_lock():
    global LOCK_FILE_HANDLE

    lock_path = Path('/tmp/nodalix-command-bar.lock')
    LOCK_FILE_HANDLE = lock_path.open('w')

    try:
        fcntl.flock(LOCK_FILE_HANDLE, fcntl.LOCK_EX | fcntl.LOCK_NB)
        LOCK_FILE_HANDLE.write(str(os.getpid()) if 'os' in globals() else 'locked')
        LOCK_FILE_HANDLE.flush()
        return True
    except BlockingIOError:
        return False



def sh(args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def run_cmd(cmd):
    subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


