#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nodalix"
LOG_FILE="$STATE_DIR/bar.log"
PROFILE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/nodalix/user/profile.json"
REPO_PROFILE_FILE="$HOME/Proyectos/nodalix-os/config/nodalix/user/profile.json"

mkdir -p "$STATE_DIR"

log() {
  printf '%s %s\n' "$(date -Iseconds)" "$*" >>"$LOG_FILE"
}

active_bar() {
  python3 - "$PROFILE_FILE" "$REPO_PROFILE_FILE" <<'PY'
import json
import sys
from pathlib import Path

for raw_path in sys.argv[1:]:
    path = Path(raw_path).expanduser()
    if not path.is_file():
        continue
    try:
        data = json.loads(path.read_text())
    except Exception:
        continue
    value = (data.get("shell") or {}).get("active_bar")
    if value in {"nodalix-bar", "waybar"}:
        print(value)
        raise SystemExit(0)

print("nodalix-bar")
PY
}

stop_bars() {
  pkill -x nodalix-bar >/dev/null 2>&1 || true
  pkill -x waybar >/dev/null 2>&1 || true
}

start_waybar() {
  if ! command -v waybar >/dev/null 2>&1; then
    log "waybar unavailable"
    return 1
  fi

  log "start waybar"
  setsid waybar >>"$LOG_FILE" 2>&1 &
}

start_nodalix_bar() {
  if ! command -v nodalix-bar >/dev/null 2>&1; then
    log "nodalix-bar unavailable"
    return 1
  fi

  log "start nodalix-bar"
  setsid nodalix-bar >>"$LOG_FILE" 2>&1 &
  sleep 1

  if pgrep -x nodalix-bar >/dev/null 2>&1; then
    return 0
  fi

  log "nodalix-bar exited during startup"
  return 1
}

restart=false
if [[ "${1:-}" == "--restart" ]]; then
  restart=true
fi

if "$restart"; then
  stop_bars
fi

bar="$(active_bar)"

case "$bar" in
  nodalix-bar)
    if pgrep -x nodalix-bar >/dev/null 2>&1; then
      log "skip: nodalix-bar already running"
      exit 0
    fi
    pkill -x waybar >/dev/null 2>&1 || true
    if start_nodalix_bar; then
      exit 0
    fi
    log "fallback to waybar"
    start_waybar
    ;;
  waybar|*)
    if pgrep -x waybar >/dev/null 2>&1; then
      log "skip: waybar already running"
      exit 0
    fi
    pkill -x nodalix-bar >/dev/null 2>&1 || true
    start_waybar
    ;;
esac
