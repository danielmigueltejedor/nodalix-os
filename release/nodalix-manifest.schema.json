{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodalix.example/schemas/release-manifest-v1.json",
  "title": "Nodalix release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "version", "channel", "minimum_version", "components", "shell_restart_required", "reboot_required"],
  "properties": {
    "schema": { "const": 1 },
    "schema_version": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "arch": { "enum": ["x86_64", "any"] },
    "channel": { "enum": ["stable", "beta"] },
    "minimum_version": { "$ref": "#/$defs/version" },
    "shell_restart_required": { "type": "boolean" },
    "reboot_required": { "type": "boolean" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signature_asset", "key_id"],
      "properties": {
        "algorithm": { "const": "minisign" },
        "signature_asset": { "type": "string", "pattern": "^[^/]+\\.minisig$" },
        "key_id": { "type": "string", "minLength": 8 }
      }
    },
    "iso": { "$ref": "#/$defs/asset" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "sha256", "size"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[^/]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "package", "version", "required", "restart", "asset", "sha256", "size"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[^/]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "pattern": "^[a-z0-9@._+-]+$" },
        "version": { "$ref": "#/$defs/version" },
        "required": { "type": "boolean" },
        "restart": { "enum": ["none", "shell", "system"] }
      }
    }
  }
}
