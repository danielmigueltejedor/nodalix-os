#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import re
import subprocess
from pathlib import Path

PAYLOAD = Path(
    "/usr/share/nodalix-installer"
)

VERSION_FILE = (
    PAYLOAD
    / "VERSION"
)


if (
    os.geteuid() != 0
    or not Path(
        "/run/archiso/bootmnt"
    ).exists()
):
    raise SystemExit(
        "Este instalador se ejecuta "
        "desde la ISO de Nodalix, "
        "como administrador."
    )


if not VERSION_FILE.is_file():
    raise SystemExit(
        "La ISO no contiene "
        "información de versión."
    )


version = VERSION_FILE.read_text(
    encoding="utf-8"
).strip()


print(
    f"\nNODALIX {version} — Instalación\n"
)

print(
    "Conecta el equipo a Internet. "
    "El asistente permite elegir "
    "idioma, teclado,"
)

print(
    "disco, cifrado y cuenta. "
    "Revisa el resumen antes de confirmar "
    "cambios en el disco.\n"
)

print(
    "El kernel de Arch se conserva para "
    "recuperación; el perfil de hardware "
    "se aplica al final.\n"
)

input(
    "Pulsa Intro para abrir el asistente… "
)


config = {
    "hostname": "nodalix",
    "kernels": [
        "linux",
    ],
    "ntp": True,
    "network_config": {
        "type": "nm",
    },
    "bootloader_config": {
        "bootloader": (
            "Systemd-boot"
            if Path(
                "/sys/firmware/efi"
            ).exists()
            else "Grub"
        ),
        "uki": False,
        "removable": True,
    },
    "profile_config": {
        "profile": {
            "main": "Desktop",
            "details": [
                "Nodalix",
            ],
            "path": (
                "/usr/share/"
                "nodalix-installer/"
                "nodalix_profile.py"
            ),
        },
        "gfx_driver": (
            "All open-source"
        ),
        "greeter": None,
    },
}


pci = subprocess.run(
    [
        "lspci",
    ],
    capture_output=True,
    text=True,
    check=True,
).stdout


nvidia = [
    line
    for line in pci.splitlines()
    if (
        "NVIDIA" in line
        and (
            "VGA" in line
            or "3D controller" in line
        )
    )
]


if (
    nvidia
    and all(
        re.search(
            r"RTX|GTX 16|"
            r"\b(?:TU|GA|AD|GB)\d{3}|"
            r"Turing|Ampere|Ada|Blackwell",
            line,
        )
        for line in nvidia
    )
):
    config[
        "profile_config"
    ][
        "gfx_driver"
    ] = (
        "Nvidia "
        "(open kernel module for newer GPUs, "
        "Turing+)"
    )


path = Path(
    "/run/nodalix-install.json"
)

path.write_text(
    json.dumps(
        config,
        indent=2,
    ),
    encoding="utf-8",
)


os.execvp(
    "archinstall",
    [
        "archinstall",
        "--config",
        str(path),
    ],
)
