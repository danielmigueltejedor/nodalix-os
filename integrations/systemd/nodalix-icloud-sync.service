[Unit]
Description=Synchronize Nodalix calendars and mirror them to GNOME Calendar
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/vdirsyncer/config
ConditionPathExists=/usr/bin/vdirsyncer

[Service]
Type=oneshot
ExecStart=/usr/bin/nodalix-calendar-bridge --export
ExecStart=/usr/bin/vdirsyncer sync
ExecStart=/usr/bin/nodalix-calendar-bridge --import
