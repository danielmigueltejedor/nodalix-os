[Unit]
Description=Automatic user Flatpak updates for user %i
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=%i
ExecStart=/usr/bin/python /usr/lib/nodalix-updater/flatpak_updates.py update --scope user
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
