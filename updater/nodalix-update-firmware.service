[Unit]
Description=Automatic Nodalix firmware update
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/nodalix-updater/update-transaction firmware --automatic
RestartForceExitStatus=75
RestartSec=5min

# fwupdmgr delegates flashing to fwupd over D-Bus. Keep device/kernel access
# compatible while isolating the client from user homes and unrelated state.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
