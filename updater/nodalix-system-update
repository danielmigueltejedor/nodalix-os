#!/bin/sh
set -eu

mode=${1:-}

require_network() {
    # Timers can fire immediately after resume, before the resolver is ready.
    # EX_TEMPFAIL lets systemd retry only this temporary condition.
    if ! getent ahosts archlinux.org >/dev/null 2>&1; then
        printf '%s\n' 'Network name resolution is not ready; deferring the system update.' >&2
        exit 75
    fi
}

update_firmware() {
    if command -v fwupdmgr >/dev/null 2>&1; then
        fwupdmgr refresh --force
        fwupdmgr update -y
    fi
}

case "$mode" in
    privileged-system)
        [ "$(id -u)" -eq 0 ] || {
            printf '%s\n' "privileged-system requires root" >&2
            exit 77
        }
        require_network
        pacman -Syu --noconfirm
        ;;
    privileged-firmware)
        [ "$(id -u)" -eq 0 ] || {
            printf '%s\n' "privileged-firmware requires root" >&2
            exit 77
        }
        update_firmware
        ;;
    privileged-all)
        [ "$(id -u)" -eq 0 ] || {
            printf '%s\n' "privileged-all requires root" >&2
            exit 77
        }
        nodalix-updater update
        pacman -Syu --noconfirm
        update_firmware
        ;;
    user-apps)
        [ "$(id -u)" -ne 0 ] || {
            printf '%s\n' "user-apps must run as the desktop user" >&2
            exit 77
        }
        # AUR recipes are executable user-maintained build instructions.
        # Never execute them from the unattended timer: they require an
        # explicit diff/PKGBUILD review in the interactive update path.
        if command -v flatpak >/dev/null 2>&1; then
            flatpak update -y --noninteractive
        fi
        ;;
    *)
        printf '%s\n' "Usage: nodalix-system-update {privileged-system|privileged-firmware|privileged-all|user-apps}" >&2
        exit 2
        ;;
esac
