[Unit]
Description=Automatic Nodalix OS update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nodalix-updater update

# Nodalix package installation intentionally writes /usr, /etc and /var, so
# ProtectSystem/RestrictSUIDSGID are deliberately not used here.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
