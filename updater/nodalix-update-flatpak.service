[Unit]
Description=Automatic system Flatpak updates
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=oneshot
ExecStart=/usr/lib/nodalix-updater/update-transaction flatpak --automatic
RestartForceExitStatus=75
RestartSec=5min
# Unattended runs (Persistent= catch-up included) happen while the user is
# working: keep package extraction, initramfs generation and DKMS builds out
# of the way of the desktop. Lowest best-effort I/O (not idle) so the package
# lock is never held indefinitely by a starved update.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
