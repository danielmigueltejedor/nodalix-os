[Unit]
Description=Automatic Nodalix system update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nodalix-system-update privileged-system

# Pacman must be able to modify the system, package database and boot assets.
# Keep those paths available while preventing accidental writes into user homes
# and blocking unrelated kernel/cgroup/clock mutation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
