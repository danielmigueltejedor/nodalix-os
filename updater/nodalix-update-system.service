[Unit]
Description=Automatic Nodalix system update
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/nodalix-updater/update-transaction system --automatic
RestartForceExitStatus=75
RestartSec=5min
# Unattended runs (Persistent= catch-up included) happen while the user is
# working: keep package extraction, initramfs generation and DKMS builds out
# of the way of the desktop. Lowest best-effort I/O (not idle) so the pacman
# lock is never held indefinitely by a starved update.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Pacman must be able to modify the system, package database and boot assets.
# Keep those paths available while preventing accidental writes into user homes
# and blocking unrelated kernel/cgroup/clock mutation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
