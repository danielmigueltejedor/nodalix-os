#!/usr/bin/env python3
from __future__ import annotations
import argparse, hashlib, json, os, platform, re, subprocess, sys, tempfile, urllib.error, urllib.request
from datetime import datetime, timezone
from pathlib import Path

CONFIG_PATH = Path("/etc/nodalix/updater.json")
RELEASE_PATH = Path("/etc/nodalix-release")
STATE_DIR = Path("/var/lib/nodalix-updater")
HISTORY_PATH = STATE_DIR / "history.jsonl"
DEFAULT_CONFIG = {"repository":"danielmigueltejedor/nodalix-os","channel":"stable","manifest_asset":"nodalix-manifest.json"}
UA = "Nodalix-Updater/0.1"

class UpdaterError(RuntimeError): pass

def load_config():
    cfg = DEFAULT_CONFIG.copy()
    if CONFIG_PATH.exists():
        cfg.update(json.loads(CONFIG_PATH.read_text()))
    return cfg

def release_data():
    out = {}
    if RELEASE_PATH.exists():
        for raw in RELEASE_PATH.read_text().splitlines():
            raw = raw.strip()
            if raw and not raw.startswith("#") and "=" in raw:
                k,v = raw.split("=",1)
                out[k.strip()] = v.strip().strip('"')
    return out

def current_version():
    return release_data().get("VERSION_ID","0.0.0")

def version_key(v):
    v = v.strip().lstrip("vV")
    main, sep, pre = v.partition("-")
    nums = [int(x) for x in re.findall(r"\d+", main)]
    nums = (nums + [0,0,0,0])[:4]
    return (*nums, 1 if not sep else 0, pre)

def is_newer(remote, local): return version_key(remote) > version_key(local)

def request(url, accept="application/vnd.github+json"):
    headers={"User-Agent":UA,"Accept":accept,"X-GitHub-Api-Version":"2022-11-28"}
    token=os.environ.get("GITHUB_TOKEN")
    if token: headers["Authorization"]=f"Bearer {token}"
    req=urllib.request.Request(url,headers=headers)
    try:
        with urllib.request.urlopen(req,timeout=20) as r: return r.read()
    except urllib.error.HTTPError as e:
        if e.code==404: raise FileNotFoundError(url)
        raise UpdaterError(f"HTTP {e.code}: {e.reason}") from e
    except urllib.error.URLError as e:
        raise UpdaterError(f"No se pudo conectar: {e.reason}") from e

def latest_release(cfg):
    try:
        data=json.loads(request(f"https://api.github.com/repos/{cfg['repository']}/releases/latest"))
    except FileNotFoundError:
        return None
    if data.get("draft") or data.get("prerelease"): return None
    return data

def assets_by_name(rel): return {a["name"]:a for a in rel.get("assets",[])}

def manifest_for(rel,cfg):
    asset=assets_by_name(rel).get(cfg["manifest_asset"])
    if not asset: raise UpdaterError(f"La release no contiene {cfg['manifest_asset']}")
    raw=request(asset["browser_download_url"],"application/octet-stream")
    try: return json.loads(raw.decode())
    except Exception as e: raise UpdaterError("Manifest JSON inválido") from e

def package_installed(pkg):
    return subprocess.run(["pacman","-Q",pkg],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0

def release_info(cfg):
    local=current_version()
    rel=latest_release(cfg)
    if rel is None:
        return {"status":"no_release","current_version":local,"update_available":False,"repository":cfg["repository"]}
    manifest=manifest_for(rel,cfg)
    remote=str(manifest.get("version","")).strip()
    if not remote: raise UpdaterError("El manifest no contiene version")
    tag=str(rel.get("tag_name","")).lstrip("vV")
    if tag and tag != remote.lstrip("vV"):
        raise UpdaterError(f"Manifest {remote} y tag {rel.get('tag_name')} no coinciden")
    arch=manifest.get("arch","x86_64")
    if arch not in ("any",platform.machine()):
        raise UpdaterError(f"Release para {arch}; sistema {platform.machine()}")
    comps=[]
    for c in manifest.get("components",[]):
        installed=bool(c.get("package")) and package_installed(c["package"])
        comps.append({"id":c.get("id"),"name":c.get("name",c.get("id")),"package":c.get("package"),
                      "version":c.get("version"),"required":bool(c.get("required",False)),
                      "installed":installed,"will_update":bool(c.get("required",False) or installed)})
    return {"status":"update_available" if is_newer(remote,local) else "up_to_date",
            "repository":cfg["repository"],"current_version":local,"latest_version":remote,
            "update_available":is_newer(remote,local),"release_name":rel.get("name") or rel.get("tag_name"),
            "tag":rel.get("tag_name"),"published_at":rel.get("published_at"),"notes":rel.get("body") or "",
            "html_url":rel.get("html_url"),"components":comps,"iso":manifest.get("iso"),
            "shell_restart_required":bool(manifest.get("shell_restart_required",False)),
            "reboot_required":bool(manifest.get("reboot_required",False)),
            "_release":rel,"_manifest":manifest}

def validate_manifest(m):
    if m.get("schema")!=1: raise UpdaterError(f"Schema no soportado: {m.get('schema')}")
    if "version" not in m or "components" not in m: raise UpdaterError("Manifest incompleto")
    for c in m["components"]:
        for k in ("id","name","package","asset","sha256"):
            if not c.get(k): raise UpdaterError(f"Componente inválido: falta {k}")

def sha256_file(p):
    h=hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda:f.read(1024*1024),b""): h.update(chunk)
    return h.hexdigest()

def download_to(url,dst):
    headers={"User-Agent":UA,"Accept":"application/octet-stream"}
    token=os.environ.get("GITHUB_TOKEN")
    if token: headers["Authorization"]=f"Bearer {token}"
    req=urllib.request.Request(url,headers=headers)
    try:
        with urllib.request.urlopen(req,timeout=60) as r, dst.open("wb") as out:
            total=int(r.headers.get("Content-Length") or 0); done=0
            while True:
                chunk=r.read(1024*1024)
                if not chunk: break
                out.write(chunk); done += len(chunk)
                if total:
                    print(f"\rDescargando {dst.name}: {done*100//total:3d}%",end="",flush=True)
            if total: print()
    except Exception:
        dst.unlink(missing_ok=True); raise

def selected_components(m):
    out=[]
    for c in m.get("components",[]):
        if c.get("required",False) or package_installed(c["package"]): out.append(c)
    return out

def write_version(v,channel):
    RELEASE_PATH.write_text(f'NAME="Nodalix"\nVERSION="{v}"\nVERSION_ID="{v}"\nCHANNEL="{channel}"\n')

def record_history(old,new,comps):
    STATE_DIR.mkdir(parents=True,exist_ok=True)
    event={"timestamp":datetime.now(timezone.utc).isoformat(),"from":old,"to":new,
           "components":[{"id":c["id"],"package":c["package"],"version":c.get("version")} for c in comps]}
    with HISTORY_PATH.open("a") as f: f.write(json.dumps(event,ensure_ascii=False)+"\n")

def do_update(cfg,force=False):
    if os.geteuid()!=0: raise UpdaterError("Usa: sudo nodalix-updater update")
    info=release_info(cfg)
    if info["status"]=="no_release":
        print("No hay releases estables publicadas todavía."); return 0
    if not info["update_available"] and not force:
        print(f"Nodalix {info['current_version']} ya está actualizado."); return 0
    rel=info["_release"]; m=info["_manifest"]; validate_manifest(m)
    minimum=m.get("minimum_version")
    if minimum and version_key(current_version()) < version_key(minimum):
        raise UpdaterError(f"Esta release requiere como mínimo Nodalix {minimum}")
    assets=assets_by_name(rel); comps=selected_components(m)
    if not comps: raise UpdaterError("No hay componentes para actualizar")
    old=current_version()
    with tempfile.TemporaryDirectory(prefix="nodalix-update-") as td:
        td=Path(td); pkgs=[]
        for c in comps:
            asset=assets.get(c["asset"])
            if not asset: raise UpdaterError(f"Falta el asset {c['asset']}")
            dst=td/c["asset"]; download_to(asset["browser_download_url"],dst)
            digest=sha256_file(dst)
            if digest.lower()!=c["sha256"].lower():
                raise UpdaterError(f"SHA-256 incorrecto para {dst.name}")
            pkgs.append(str(dst))
        print("Instalando componentes Nodalix...")
        subprocess.run(["pacman","-U","--noconfirm","--needed",*pkgs],check=True)
    write_version(m["version"],cfg.get("channel","stable"))
    record_history(old,m["version"],comps)
    print(f"Nodalix actualizado: {old} -> {m['version']}")
    if m.get("shell_restart_required"): print("Reinicia la shell para aplicar todos los cambios.")
    if m.get("reboot_required"): print("Esta actualización requiere reiniciar el sistema.")
    return 0

def clean(info): return {k:v for k,v in info.items() if not k.startswith("_")}

def main():
    ap=argparse.ArgumentParser(prog="nodalix-updater")
    sp=ap.add_subparsers(dest="cmd",required=True)
    p=sp.add_parser("info"); p.add_argument("--json",action="store_true")
    p=sp.add_parser("check"); p.add_argument("--json",action="store_true")
    p=sp.add_parser("update"); p.add_argument("--force",action="store_true")
    a=ap.parse_args(); cfg=load_config()
    try:
        if a.cmd=="info":
            d={"name":"Nodalix","version":current_version(),"channel":cfg.get("channel","stable"),"repository":cfg["repository"]}
            print(json.dumps(d,ensure_ascii=False) if a.json else f"Nodalix {d['version']} ({d['channel']})"); return 0
        if a.cmd=="check":
            d=clean(release_info(cfg))
            if a.json: print(json.dumps(d,ensure_ascii=False))
            elif d["status"]=="no_release": print(f"Nodalix {d['current_version']}: todavía no hay releases estables publicadas.")
            elif d["update_available"]:
                print(f"Actualización disponible: {d['current_version']} -> {d['latest_version']}")
                for c in d.get("components",[]):
                    if c["will_update"]: print(f"  - {c['name']} ({c.get('version') or 'nueva versión'})")
            else: print(f"Nodalix {d['current_version']} está actualizado.")
            return 0
        if a.cmd=="update": return do_update(cfg,a.force)
    except UpdaterError as e:
        print(f"Error: {e}",file=sys.stderr); return 2
    except subprocess.CalledProcessError as e:
        print(f"Error ejecutando: {' '.join(e.cmd)}",file=sys.stderr); return e.returncode or 1
    except KeyboardInterrupt:
        print("\nCancelado.",file=sys.stderr); return 130

if __name__=="__main__": raise SystemExit(main())
