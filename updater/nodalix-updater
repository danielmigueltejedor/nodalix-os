    "nodalix-shell", "nodalix-greeter-theme", "nodalix-hymission", "nodalix-wallpaper-engine",
    "hyprland", "hyprland-git", "quickshell", "quickshell-git", "greetd", "greetd-regreet",
    "xdg-desktop-portal-hyprland", "hymission", "skwd-deck", "skwd-paper", "aquamarine",
    "hypridle", "hyprlock", "hyprpaper", "hyprland-guiutils", "hyprutils", "uwsm",
    "greetd-agreety", "mpvpaper",
}


def retire_legacy_desktop() -> None:
    """Remove the requested former desktop with dependency checking intact."""
    query = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, check=True)
    packages = sorted(name for name in query.stdout.splitlines()
                      if name in LEGACY_DESKTOP_PACKAGES)
    if not packages:
        return
    result = subprocess.run(["pacman", "-Rns", "--noconfirm", *packages],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=False)
    atomic_text(STATE_DIR / "last-legacy-removal.log", result.stdout or "")
    if result.returncode:
        raise PackageTransactionError("No se pudo retirar el escritorio Hyprland; revisa sus dependencias",
                                      returncode=result.returncode,
                                      log_path=str(STATE_DIR / "last-legacy-removal.log"))


def retire_installer_session(packages: list[str], *, root: Path = Path("/"), owner_lookup=None) -> None:
    """Retire only the hash-pinned unowned 0.2.4 installer session before preflight."""
    if not any("nodalix-gnome" in package_metadata(p).get("pkgname", []) for p in packages):
        return
    metadata = Path('/usr/lib/nodalix-updater/legacy-installer-0.2.4.json')
    if not metadata.is_file():
        metadata = Path(__file__).resolve().parent / 'legacy-installer-0.2.4.json'
    relative = 'usr/share/wayland-sessions/nodalix.desktop'
    source = root / relative
    if not source.is_file() or source.is_symlink():
        return
    lookup = owner_lookup or installed_path_owner
    if lookup(source) is not None or sha256_file(source) != json.loads(metadata.read_text())[relative]:
        return  # custom files remain subject to the normal ownership preflight
    backup = STATE_DIR / 'migrations/gnome-0.3.0/files'
    backup.mkdir(parents=True, exist_ok=True, mode=0o700)
    backup.parent.chmod(0o700)
    destination = backup / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    if not destination.exists():
        shutil.copy2(source, destination)
    source.unlink()


def backup_gnome_transition(packages: list[str]) -> None:
    if not any("nodalix-gnome" in package_metadata(p).get("pkgname", []) for p in packages):
        return
    backup = STATE_DIR / "migrations/gnome-0.3.0/files"
    backup.mkdir(parents=True, exist_ok=True, mode=0o700)
    backup.parent.chmod(0o700)
    for relative in ("etc/greetd/config.toml", "etc/gdm/custom.conf", "etc/systemd/system/display-manager.service"):
        source = Path("/") / relative
        destination = backup / relative
        if (source.exists() or source.is_symlink()) and not (destination.exists() or destination.is_symlink()):
            destination.parent.mkdir(parents=True, exist_ok=True)
            if source.is_symlink():
                destination.symlink_to(os.readlink(source))
            else:
                shutil.copy2(source, destination)


def require_reboot(target_version: str) -> None:
    atomic_text(REBOOT_REQUIRED_PATH, target_version + "\n")


def package_conflicts(
    packages: list[str],
    *,
    root: Path = Path("/"),
    payload_reader=None,
    owner_lookup=None,
    progress_callback=None,
    replacements: set[str] | None = None,
) -> list[dict]:
    read_payload = payload_reader or package_payload
    conflicts: list[dict] = []
    candidates: list[tuple[str, str, Path]] = []
    replacements = replacements or set()
    payload_owners: dict[str, str] = {}
    candidate_names: set[str] = set()

    for package in packages:
        package_name, paths = read_payload(package)
        candidate_names.add(package_name)
        for relative in paths:
            if relative in payload_owners and payload_owners[relative] != package_name:
                raise PackagePreflightError(f"Dos paquetes candidatos contienen /{relative}")
            payload_owners[relative] = package_name
            target = root / relative

            if not target.exists() and not target.is_symlink():
                continue

            candidates.append((package_name, relative, target))

    total = len(candidates)

    if total == 0:
        if progress_callback is not None:
            progress_callback(0, 0, "")
        return []

    if owner_lookup is None and root == Path("/"):
        owners = installed_path_owners(
            [target for _, _, target in candidates],
            progress_callback=progress_callback,
        )

        def lookup(target: Path) -> str | None:
            return owners.get(str(target))
    else:
        lookup = owner_lookup or installed_path_owner

    for index, (package_name, relative, target) in enumerate(
        candidates,
        start=1,
    ):
        owner = lookup(target)

        if owner != package_name and owner not in replacements and not (owner in candidate_names and payload_owners.get(relative) == package_name):
            conflicts.append(
                {
                    "package": package_name,
                    "path": "/" + relative.lstrip("/"),
                    "kind": "unowned" if owner is None else "other_owner",
                    "owner": owner,
                }
            )

        if (
            progress_callback is not None
            and not (owner_lookup is None and root == Path("/"))
            and (index == 1 or index == total or index % 128 == 0)
        ):
            progress_callback(index, total, str(target))

    return conflicts


def run_package_preflight(
    packages: list[str],
    *,
    target_version: str,
) -> list[dict]:
    log_path = STATE_DIR / "last-preflight.json"
    log_path.unlink(missing_ok=True)

    def report_progress(
        current: int,
        total: int,
        detail: str,
    ) -> None:
        fraction = 1.0 if total <= 0 else current / total

        set_status(
            "preflight",
            status="preflight",
            stage="preflight",
            version=target_version,
            target_version=target_version,
            current_version=current_version(),
            progress=round(0.58 + 0.24 * fraction, 4),
            progress_current=current,
            progress_total=total,
            progress_detail=detail,
            last_error=None,
        )

    conflicts = package_conflicts(
        packages,
        progress_callback=report_progress,
        replacements=transaction_replacements(packages) if compare_versions(target_version, "0.3.0") >= 0 else set(),
    )

    if not conflicts:
        return []

    payload = {
        "target_version": target_version,
        "conflict_count": len(conflicts),
        "conflicts": conflicts,
    }

    atomic_json(log_path, payload)

    lines = []

    for conflict in conflicts[:20]:
        owner = conflict.get("owner")

        if owner:
            detail = f"pertenece a {owner}"
        else:
            detail = "existe sin pertenecer a ningún paquete"

        lines.append(
            f"{conflict['package']}: {conflict['path']} ({detail})"
        )

    if len(conflicts) > 20:
        lines.append(
            f"... y {len(conflicts) - 20} conflictos más"
        )

    raise PackagePreflightError(
        "La actualización no puede comenzar porque hay "
        "conflictos de archivos:\n"
        + "\n".join(lines),
        target_version=target_version,
        conflicts=conflicts,
        log_path=str(log_path),
    )


def pacman_log_path() -> Path:
    return STATE_DIR / "last-pacman.log"


def ensure_pacman_available() -> None:
    if PACMAN_LOCK_PATH.exists():
        raise BusyError(
            "pacman está siendo utilizado por otro proceso; "
            "espera a que termine antes de actualizar Nodalix"
        )


def run_pacman_transaction(
    packages: list[str],
    *,
    target_version: str,
) -> None:
    ensure_pacman_available()

    command = [
        "pacman",
        "-U",
        "--noconfirm",
        "--needed",
        *packages,
    ]

    if compare_versions(target_version, "0.3.0") >= 0:
        command[1:1] = ["--ask", "4"]  # ALPM conflict replacements, never file overwrites.

    log_path = pacman_log_path()
    log_path.parent.mkdir(parents=True, exist_ok=True)

    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )

    output = result.stdout if isinstance(result.stdout, str) else ""
    atomic_text(log_path, output)

    if result.returncode != 0:
        tail = "\n".join(output.splitlines()[-40:]).strip()
        message = f"pacman falló con código {result.returncode}"
        if tail:
            message += ":" + "\n" + tail

        raise PackageTransactionError(
            message,
            returncode=result.returncode,
            target_version=target_version,
            log_path=str(log_path),
        )

    if output:
        print(output, end="" if output.endswith("\n") else "\n")

def do_update(config: dict, force: bool = False, assets_dir: Path | None = None) -> dict:
    if os.geteuid() != 0:
        raise UpdaterError("Usa: sudo nodalix-updater update")
    previous = current_version()
    if REBOOT_REQUIRED_PATH.exists():
        raise BusyError("Reinicio obligatorio pendiente: reinicia para terminar la migración a GNOME")
    with update_lock():
        target_version = None
        set_status(
            "checking",
            status="checking",
            stage="checking",
            current_version=previous,
            target_version=None,
            progress=0.02,
            progress_current=0,
            progress_total=0,
            last_error=None,
        )
        info = candidate_info(assets_dir, config) if assets_dir else release_info(config)
        if info["status"] == "no_release":
            return set_status("no_release", status="no_release", current_version=previous)
        if info["status"] == "no_compatible_release":
            return set_status(
                "no_compatible_release",
                status="no_compatible_release",
                current_version=previous,
                error=info.get("error"),
            )
        if info["status"] == "up_to_date" and not force:
            return set_status("up_to_date", status="up_to_date", current_version=previous, latest_version=info.get("latest_version"))
        fail_closed(info, "update")
        manifest = info["_manifest"]
        target_version = canonical_version(str(manifest["version"]))
        if compare_versions(target_version, previous) < 0:
            raise ManifestError("La versión instalada es más reciente; el actualizador no realiza descensos de versión")
        minimum = manifest["minimum_version"]
        if compare_versions(current_version(), minimum) < 0:
            raise ManifestError(f"Esta release requiere como mínimo Nodalix {minimum}")
        components = selected_components(manifest)
        if not components:
            raise ManifestError("No hay componentes para actualizar")
        assets = assets_by_name(info["_release"])
        staging = CACHE_DIR / f"v{manifest['version']}"
        staging.mkdir(parents=True, exist_ok=True)
        packages: list[str] = []
        total_size = sum(int(component.get("size") or 0) for component in components)
        for index, component in enumerate(components, start=1):
            set_status(
                "downloading",
                status="downloading",
                stage="downloading",
                version=manifest["version"],
                target_version=target_version,
                component=component["id"],
                component_index=index,
                component_count=len(components),
                total_size=total_size,
                current_version=previous,
                progress=round(
                    0.05
                    + 0.45
                    * ((index - 1) / max(1, len(components))),
                    4,
                ),
                progress_current=index - 1,
                progress_total=len(components),
                progress_detail=component["id"],
                last_error=None,
            )
            asset = assets.get(component["asset"])
            if asset is None:
                raise ManifestMissingError(f"Falta el asset {component['asset']}")
            destination = staging / component["asset"]
            if assets_dir:
                source = (assets_dir / component["asset"]).resolve(strict=True)
                if source.parent != assets_dir.resolve() or not source.is_file():
                    raise ManifestError("Ruta de paquete candidato no válida")
                if source != destination.resolve():
                    shutil.copyfile(source, destination)
            elif not destination.exists() or sha256_file(destination) != component["sha256"].lower():
                download_to(asset_download_url(asset), destination)
            set_status(
                "verifying",
                status="verifying",
                stage="verifying",
                version=manifest["version"],
                target_version=target_version,
                current_version=previous,
                component=component["id"],
                component_index=index,
                component_count=len(components),
                progress=round(
                    0.05
                    + 0.45
                    * ((index - 0.5) / max(1, len(components))),
                    4,
                ),
                progress_current=index,
                progress_total=len(components),
                progress_detail=component["id"],
                last_error=None,
            )
            digest = sha256_file(destination)
            if digest != component["sha256"].lower():
                destination.unlink(missing_ok=True)
                raise IntegrityError(f"SHA-256 incorrecto para {component['asset']}")
            packages.append(str(destination))
        prepare_gnome_dependencies(packages, target_version)
        set_status(
            "migrating",
            status="migrating",
            stage="migrating",
            version=manifest["version"],
            current_version=previous,
            target_version=target_version,
            progress=0.54,
            progress_current=0,
            progress_total=0,
            last_error=None,
        )
        try:
            run_migrations(
                previous,
                target_version,
                compare_versions=compare_versions,
                state_dir=STATE_DIR,
                log=lambda message: print(f"migración: {message}", flush=True),
            )
        except MigrationError as error:
            raise MigrationFailedError(str(error)) from error
        set_status(
            "preflight",
            status="preflight",
            stage="preflight",
            version=manifest["version"],
            target_version=target_version,
            current_version=previous,
            components=[item["id"] for item in components],
            progress=0.58,
            progress_current=0,
            progress_total=0,
            last_error=None,
        )

        if any(item["id"] == "gnome" for item in components):
            retire_installer_session(packages)
        run_package_preflight(
            packages,
            target_version=target_version,
        )

        set_status(
            "installing",
            status="installing",
            stage="installing",
            version=manifest["version"],
            target_version=target_version,
            current_version=previous,
            components=[item["id"] for item in components],
            progress=0.86,
            progress_current=0,
            progress_total=len(components),
            last_error=None,
        )
        # Pacman replaces files, including this script. Keep running from the
        # already-loaded Python process; do not re-exec mid-transaction.
        # Known 0.1.1 leftovers are removed by migrations; unknown conflicts
        # must still abort with the normal pacman error.
        if compare_versions(target_version, "0.3.0") >= 0:
            backup_gnome_transition(packages)
        run_pacman_transaction(
            packages,
            target_version=target_version,
        )
        if any(item["id"] == "gnome" for item in components):
            require_reboot(target_version)
            retire_legacy_desktop()
            subprocess.run(["/usr/bin/nodalix-gnome-migrate", "--system"], check=True)
        reload_systemd_units(components)
        installed = current_version()
        if installed != canonical_version(str(manifest["version"])):
            raise UpdaterError(
                f"packages installed but system identity is {installed}, expected {manifest['version']}"
            )
        if any(item["id"] == "gnome" for item in components):
            require_reboot(installed)
        record_history(previous, installed, components)
        result = set_status(
            "completed",
            status="completed",
            stage="completed",
            previous_version=previous,
            current_version=installed,
            target_version=target_version,
            progress=1.0,
            progress_current=len(components),
            progress_total=len(components),
            last_error=None,
            components=[item["id"] for item in components],
            shell_restart_required=any(item["restart"] == "shell" for item in components),
            reboot_required=any(item["restart"] == "system" for item in components),
            reboot_mandatory=REBOOT_REQUIRED_PATH.exists(),
        )
        print(f"Nodalix actualizado: {previous} -> {installed}")
        if result.get("shell_restart_required"):
            print("Reinicia la shell para aplicar todos los cambios.")
        if result.get("reboot_required"):
            print("Esta actualización requiere reiniciar el sistema.")
        return result


def public_info(info: dict) -> dict:
    return {key: value for key, value in info.items() if not key.startswith("_")}


def human_check_message(data: dict) -> str:
    status = data.get("status")
    current = data.get("current_version")
    if status == "update_available":
        lines = [f"Actualización disponible: {current} -> {data.get('latest_version')}"]
        for component in data.get("components") or []:
            if component.get("will_update"):
                lines.append(f"  - {component.get('name')} ({component.get('version') or 'nueva versión'})")
        return "\n".join(lines)
    if status == "up_to_date":
        return f"Nodalix {current} está actualizado."
    if status == "no_release":
        return f"Nodalix {current}: todavía no hay releases publicadas."
    if status == "no_compatible_release":
        return f"Nodalix {current}: no hay una release compatible con el canal {data.get('channel')}."
    if status == "manifest_missing":
        return data.get("error") or f"La release no contiene {DEFAULT_CONFIG['manifest_asset']}"
    if status == "invalid_manifest":
        return data.get("error") or "Manifest inválido"
    if status == "network_error":
        return data.get("error") or "Error de red"
    return data.get("error") or data.get("state") or f"Nodalix {current}"


def format_history(events: list[dict]) -> str:
    if not events:
        return "No hay actualizaciones registradas."
    lines = []
    for event in events:
        origin = event.get("from") or "?"
        destination = event.get("to") or "?"
        stamp = event.get("timestamp") or ""
        suffix = f" ({stamp})" if stamp else ""
        lines.append(f"{origin} -> {destination}{suffix}")
    return "\n".join(lines)


def emit(data: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(public_info(data), ensure_ascii=False))
        return
    if "history" in data and "channel" not in data and data.get("status") is None:
        print(format_history(list(data.get("history") or [])))
        return
    if data.get("status") in {
        "no_release",
        "no_compatible_release",
        "manifest_missing",
        "invalid_manifest",
        "update_available",
        "up_to_date",
        "network_error",
    }:
        print(human_check_message(data))
        return
    if "version" in data and "channel" in data:
        print(f"Nodalix {data['version']} ({data['channel']})")
        return
    print(data.get("state") or human_check_message(data))


def error_payload(error: UpdaterError, current: str | None = None) -> dict:
    payload = {
        "status": getattr(error, "status", "update_error"),
        "state": "error_recoverable" if error.recoverable else "error_critical",
        "code": error.code,
        "update_available": False,
        "error": str(error),
        "message": str(error),
    }
    if current is not None:
        payload["current_version"] = current

    target_version = getattr(error, "target_version", None)
    if target_version is not None:
        payload["target_version"] = target_version

    returncode = getattr(error, "returncode", None)
    if returncode is not None:
        payload["returncode"] = returncode

    log_path = getattr(error, "log_path", None)
    if log_path is not None:
        payload["log_path"] = log_path

    conflicts = getattr(error, "conflicts", None)
    if conflicts:
        payload["conflicts"] = conflicts
        payload["conflict_count"] = len(conflicts)

    return payload


def main() -> int:
    parser = argparse.ArgumentParser(prog="nodalix-updater")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("info", "check", "status"):
        command = commands.add_parser(name)
        command.add_argument("--json", action="store_true")
    update = commands.add_parser("update")
    update.add_argument("--force", action="store_true")
    update.add_argument("--json", action="store_true")
    update.add_argument("--assets", type=Path, help="Explicit local CI/offline candidate directory")
    history = commands.add_parser("history")
    history.add_argument("--json", action="store_true")
    channel = commands.add_parser("channel")
    channel.add_argument("name", nargs="?", choices=VALID_CHANNELS)
    channel.add_argument("--json", action="store_true")
    args = parser.parse_args()
    current = current_version()
    try:
        config = load_config()
        if args.command == "info":
            emit(
                {
                    "name": "Nodalix",
                    "version": current,
                    "channel": config["channel"],
                    "repository": config["repository"],
                },
                args.json,
            )
        elif args.command == "check":
            data = release_info(config)
            emit(data, args.json)
            if data["status"] in {"network_error"}:
                return 2
            return 0
        elif args.command == "status":
            emit(load_status(), args.json)
        elif args.command == "update":
            emit(do_update(config, args.force, args.assets), args.json)
        elif args.command == "history":
            events = []
            if HISTORY_PATH.exists():
                events = [json.loads(line) for line in HISTORY_PATH.read_text(encoding="utf-8").splitlines() if line]
            emit({"history": events}, args.json)
            return 0
        elif args.command == "channel":
            if args.name is None:
                emit({"channel": config["channel"], "version": current, "repository": config["repository"]}, args.json)
                return 0
            if os.geteuid() != 0:
                raise UpdaterError("Usa: sudo nodalix-updater channel stable|beta")
            config["channel"] = args.name
            written = write_config(config)
            emit(
                {
                    "channel": written["channel"],
                    "version": current,
                    "repository": written["repository"],
                    "config": str(CONFIG_PATH),
                },
                args.json,
            )
        return 0
    except UpdaterError as error:
        payload = error_payload(error, current)
        payload["stage"] = error.status if error.status in {
            "migration_failed",
            "preflight_failed",
            "install_failed",
        } else "failed"
        payload["last_error"] = str(error)
        payload["target_version"] = payload.get("target_version")
        with contextlib.suppress(OSError):
            set_status(**payload)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False))
        else:
            print(f"Error: {error}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as error:
        payload = {
            "status": "install_failed",
            "stage": "install_failed",
            "state": "error_critical",
            "code": "package_transaction_failed",
            "current_version": current_version(),
            "target_version": None,
            "last_error": f"pacman exited with status {error.returncode}",
            "update_available": False,
            "error": f"pacman exited with status {error.returncode}",
            "message": f"pacman exited with status {error.returncode}",
        }
        with contextlib.suppress(OSError):
            set_status(**payload)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False))
        else:
            print(f"Error: {payload['message']}", file=sys.stderr)
        return error.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
