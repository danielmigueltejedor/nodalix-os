CONFIG_PATH = Path(os.environ.get("NODALIX_UPDATER_CONFIG", "/etc/nodalix/updater.json"))
RELEASE_PATH = Path(os.environ.get("NODALIX_RELEASE_FILE", "/etc/nodalix-release"))
STATE_DIR = Path(os.environ.get("NODALIX_UPDATER_STATE", "/var/lib/nodalix-updater"))
CACHE_DIR = Path(os.environ.get("NODALIX_UPDATER_CACHE", "/var/cache/nodalix-updater"))
PUBLIC_KEY_PATH = Path(os.environ.get("NODALIX_UPDATER_PUBLIC_KEY", "/usr/share/nodalix/keys/release.pub"))
HISTORY_PATH = STATE_DIR / "history.jsonl"
STATUS_PATH = STATE_DIR / "status.json"
LOCK_PATH = STATE_DIR / "update.lock"
DEFAULT_CONFIG = {
    "repository": "danielmigueltejedor/nodalix-os",
    "channel": "stable",
    "manifest_asset": "nodalix-manifest.json",
    "require_signature": False,
}
VALID_CHANNELS = ("stable", "beta")
CHANNEL_ALIASES = {"rc": "beta"}
UA = "Nodalix-Updater/0.2"
VERSION_PATTERN = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?"
    r"(?:\+[0-9A-Za-z.-]+)?$"
)
NUMERIC_IDENTIFIER = re.compile(r"^(0|[1-9]\d*)$")
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")
PACKAGE_PATTERN = re.compile(r"^[a-z0-9@._+-]+$")
ASSET_PATTERN = re.compile(r"^[^/\\]+$")


class UpdaterError(RuntimeError):
    code = "update_error"
    status = "update_error"
    recoverable = True


class ManifestError(UpdaterError):
    code = "invalid_manifest"
    status = "invalid_manifest"
    recoverable = False


class ManifestMissingError(ManifestError):
    code = "manifest_missing"
    status = "manifest_missing"
    recoverable = True


class IntegrityError(UpdaterError):
    code = "integrity_failed"
    status = "integrity_failed"
    recoverable = False


class NetworkError(UpdaterError):
    code = "network_error"
    status = "network_error"


class BusyError(UpdaterError):
    code = "update_busy"
    status = "update_busy"


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def atomic_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def atomic_text(path: Path, data: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(data, encoding="utf-8")
    os.replace(temporary, path)


def set_status(state: str, **fields: object) -> dict:
    status = {"state": state, "status": fields.get("status", state), "updated_at": utc_now(), **fields}
    atomic_json(STATUS_PATH, status)
    return status


def load_status() -> dict:
    if not STATUS_PATH.exists():
        return {"state": "idle", "status": "idle", "updated_at": None}
    try:
        return json.loads(STATUS_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"state": "error_recoverable", "status": "update_error", "error": "status file is unreadable"}


def normalize_channel(value: object) -> str:
    channel = str(value or "stable").strip().lower()
    channel = CHANNEL_ALIASES.get(channel, channel)
    if channel not in VALID_CHANNELS:
        raise ManifestError("channel must be stable or beta")
    return channel


def load_config() -> dict:
    config = DEFAULT_CONFIG.copy()
    if CONFIG_PATH.exists():
        try:
            value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            raise ManifestError(f"invalid updater configuration: {error}") from error
        if not isinstance(value, dict):
            raise ManifestError("updater configuration must be an object")
        config.update(value)
    repository = str(config.get("repository", ""))
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise ManifestError("invalid GitHub repository")
    config["channel"] = normalize_channel(config.get("channel", "stable"))
    if not str(config.get("manifest_asset") or "").strip():
        config["manifest_asset"] = DEFAULT_CONFIG["manifest_asset"]
    return config


def write_config(config: dict) -> dict:
    payload = {
        "repository": config["repository"],
        "channel": normalize_channel(config["channel"]),
        "manifest_asset": config.get("manifest_asset", DEFAULT_CONFIG["manifest_asset"]),
        "require_signature": bool(config.get("require_signature", False)),
    }
    atomic_text(CONFIG_PATH, json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
    return payload


def release_data() -> dict[str, str]:
    result: dict[str, str] = {}
    if RELEASE_PATH.exists():
        for line in RELEASE_PATH.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                result[key.strip()] = value.strip().strip('"')
    return result


def current_version() -> str:
    return release_data().get("VERSION_ID", "0.0.0")


def canonical_version(value: str) -> str:
    text = str(value).strip()
    if text.startswith(("v", "V")):
        text = text[1:]
    if "+" in text:
        text = text.split("+", 1)[0]
    return text


def parse_version(value: str) -> tuple[int, int, int, tuple[tuple[int, object], ...] | None]:
    text = canonical_version(value)
    match = VERSION_PATTERN.fullmatch(text)
    if not match:
        raise ManifestError(f"invalid semantic version: {value}")
    prerelease = match.group(4)
    identifiers = None
    if prerelease is not None:
        parts: list[tuple[int, object]] = []
        for part in prerelease.split("."):
            if part == "":
                raise ManifestError(f"invalid semantic version: {value}")
            if NUMERIC_IDENTIFIER.fullmatch(part):
                parts.append((0, int(part)))
            elif part.isdigit():
                raise ManifestError(f"invalid semantic version: {value}")
            else:
                parts.append((1, part))
        identifiers = tuple(parts)
    return int(match.group(1)), int(match.group(2)), int(match.group(3)), identifiers


def compare_versions(left: str, right: str) -> int:
    left_value = parse_version(left)
    right_value = parse_version(right)
    if left_value[:3] != right_value[:3]:
        return (left_value[:3] > right_value[:3]) - (left_value[:3] < right_value[:3])
    left_pre, right_pre = left_value[3], right_value[3]
    if left_pre is None or right_pre is None:
        return (left_pre is None) - (right_pre is None)
    for left_part, right_part in zip(left_pre, right_pre):
        if left_part != right_part:
            return (left_part > right_part) - (left_part < right_part)
    return (len(left_pre) > len(right_pre)) - (len(left_pre) < len(right_pre))


def is_prerelease_version(value: str) -> bool:
    return parse_version(value)[3] is not None


class GithubRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is None:
            return None
        old_host = urllib.parse.urlparse(req.full_url).netloc
        new_host = urllib.parse.urlparse(new.full_url).netloc
        if old_host != new_host:
            new.headers.pop("Authorization", None)
        return new


def github_opener() -> urllib.request.OpenerDirector:
    return urllib.request.build_opener(GithubRedirectHandler)


def asset_download_url(asset: dict) -> str:
    api_url = str(asset.get("url") or "")
    browser_url = str(asset.get("browser_download_url") or "")
    if os.environ.get("GITHUB_TOKEN") and "api.github.com" in api_url:
        return api_url
    return browser_url or api_url


def request(url: str, accept: str = "application/vnd.github+json", attempts: int = 3) -> tuple[bytes, dict[str, str]]:
    headers = {"User-Agent": UA, "Accept": accept, "X-GitHub-Api-Version": "2022-11-28"}
    token = os.environ.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    last_error: Exception | None = None
    opener = github_opener()
    for attempt in range(attempts):
        try:
            with opener.open(urllib.request.Request(url, headers=headers), timeout=20) as response:
                header_map = {key.lower(): value for key, value in response.headers.items()}
                return response.read(), header_map
        except urllib.error.HTTPError as error:
            if error.code == 404:
                raise FileNotFoundError(url) from error
            last_error = error
            if error.code < 500 or attempt + 1 == attempts:
                raise NetworkError(f"GitHub returned HTTP {error.code}") from error
        except (urllib.error.URLError, TimeoutError) as error:
            last_error = error
            if attempt + 1 == attempts:
                reason = getattr(error, "reason", error)
                raise NetworkError(f"No se pudo conectar: {reason}") from error
        time.sleep(2**attempt)
    raise NetworkError(f"No se pudo conectar: {last_error}")


def next_link(headers: dict[str, str]) -> str | None:
    link = headers.get("link", "")
    for part in link.split(","):
        section = part.strip()
        if 'rel="next"' in section:
            start = section.find("<")
            end = section.find(">")
            if start != -1 and end != -1:
                return section[start + 1 : end]
    return None


def list_releases(repository: str) -> list[dict]:
    url = f"https://api.github.com/repos/{repository}/releases?per_page=100"
    releases: list[dict] = []
    while url:
        try:
            raw, headers = request(url)
        except FileNotFoundError:
            return releases
        payload = json.loads(raw)
        if not isinstance(payload, list):
            raise NetworkError("GitHub releases response is invalid")
        releases.extend(item for item in payload if isinstance(item, dict))
        url = next_link(headers)
    return releases


def release_tag_version(release: dict) -> str | None:
    tag = release.get("tag_name")
    if not tag:
        return None
    try:
        parse_version(str(tag))
    except ManifestError:
        return None
    return canonical_version(str(tag))


def release_eligible(release: dict, channel: str) -> bool:
    if release.get("draft"):
        return False
    version = release_tag_version(release)
    if version is None:
        return False
    prerelease = bool(release.get("prerelease")) or is_prerelease_version(version)
    if channel == "stable":
        return not prerelease
    if channel == "beta":
        return True
    return False


def select_release(releases: list[dict], channel: str) -> dict | None:
    channel = normalize_channel(channel)
    candidates: list[tuple[str, dict]] = []
    for release in releases:
        if not release_eligible(release, channel):
            continue
        version = release_tag_version(release)
        if version is None:
            continue
        candidates.append((version, release))
    if not candidates:
        return None
    return max(candidates, key=cmp_to_key(lambda left, right: compare_versions(left[0], right[0])))[1]


def assets_by_name(release: dict) -> dict[str, dict]:
    return {asset["name"]: asset for asset in release.get("assets", []) if asset.get("name")}


def validate_manifest(manifest: dict) -> None:
    if not isinstance(manifest, dict):
        raise ManifestError("manifest must be an object")
    if manifest.get("schema") != 1 or manifest.get("schema_version") != 1:
        raise ManifestError(f"Schema no soportado: {manifest.get('schema')}")
    for key in ("version", "minimum_version", "components"):
        if key not in manifest:
            raise ManifestError(f"manifest is missing {key}")
    parse_version(str(manifest["version"]))
    parse_version(str(manifest["minimum_version"]))
    if not isinstance(manifest["components"], list) or not manifest["components"]:
        raise ManifestError("manifest components must be a non-empty array")
    seen_ids: set[str] = set()
    seen_packages: set[str] = set()
    for component in manifest["components"]:
        if not isinstance(component, dict):
            raise ManifestError("component must be an object")
        for key in ("id", "name", "package", "version", "asset", "sha256", "size", "required", "restart"):
            if key not in component:
                raise ManifestError(f"component is missing {key}")
        if not PACKAGE_PATTERN.fullmatch(str(component["package"])):
            raise ManifestError(f"invalid package name: {component['package']}")
        if not ASSET_PATTERN.fullmatch(str(component["asset"])):
            raise ManifestError(f"invalid asset name: {component['asset']}")
        if not SHA256_PATTERN.fullmatch(str(component["sha256"]).lower()):
            raise ManifestError(f"invalid SHA-256 for {component['id']}")
        if component["restart"] not in ("none", "shell", "system"):
            raise ManifestError(f"invalid restart policy for {component['id']}")
        if not isinstance(component["required"], bool):
            raise ManifestError(f"required must be boolean for {component['id']}")
        if not isinstance(component["size"], int) or component["size"] < 1:
            raise ManifestError(f"invalid size for {component['id']}")
        parse_version(str(component["version"]))
        if component["id"] in seen_ids or component["package"] in seen_packages:
            raise ManifestError(f"duplicate component: {component['id']}")
        seen_ids.add(component["id"])
        seen_packages.add(component["package"])
    identity = next((item for item in manifest["components"] if item["id"] == "nodalix-release"), None)
    if identity is None or not identity["required"]:
        raise ManifestError("manifest must include required nodalix-release")


def verify_manifest_signature(raw: bytes, manifest: dict, release: dict, config: dict) -> None:
    signing = manifest.get("signing")
    if not signing:
        if config.get("require_signature"):
            raise IntegrityError("release manifest is not signed")
        return
    if signing.get("algorithm") != "minisign" or not ASSET_PATTERN.fullmatch(str(signing.get("signature_asset", ""))):
        raise ManifestError("invalid manifest signing metadata")
    if not PUBLIC_KEY_PATH.is_file():
        raise IntegrityError("Nodalix release public key is missing")
    executable = shutil.which("minisign")
    if executable is None:
        raise IntegrityError("minisign is required to verify this release")
    asset = assets_by_name(release).get(signing["signature_asset"])
    if asset is None:
        raise IntegrityError("manifest signature asset is missing")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    manifest_path = STATE_DIR / "manifest.verify.json"
    signature_path = STATE_DIR / "manifest.verify.minisig"
    try:
        manifest_path.write_bytes(raw)
        signature_path.write_bytes(request(asset_download_url(asset), "application/octet-stream")[0])
        result = subprocess.run(
            [executable, "-Vm", str(manifest_path), "-x", str(signature_path), "-p", str(PUBLIC_KEY_PATH)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            raise IntegrityError("manifest signature verification failed")
    finally:
        manifest_path.unlink(missing_ok=True)
        signature_path.unlink(missing_ok=True)


def manifest_for(release: dict, config: dict) -> dict:
    asset_name = config["manifest_asset"]
    asset = assets_by_name(release).get(asset_name)
    if asset is None:
        raise ManifestMissingError(f"La release no contiene {asset_name}")
    try:
        raw = request(asset_download_url(asset), "application/octet-stream")[0]
    except FileNotFoundError as error:
        raise ManifestMissingError(f"La release no contiene {asset_name}") from error
    try:
        manifest = json.loads(raw.decode("utf-8"))
    except (UnicodeError, ValueError) as error:
        raise ManifestError("Manifest JSON inválido") from error
    validate_manifest(manifest)
    verify_manifest_signature(raw, manifest, release, config)
    return manifest


def package_installed(package: str) -> bool:
    return subprocess.run(
        ["pacman", "-Q", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    ).returncode == 0


def selected_components(manifest: dict) -> list[dict]:
    return [
        component
        for component in manifest["components"]
        if component["required"] or package_installed(component["package"])
    ]


def base_info(config: dict, local: str) -> dict:
    return {
        "repository": config["repository"],
        "channel": config["channel"],
        "current_version": local,
        "update_available": False,
        "last_checked": utc_now(),
    }


def release_info(config: dict) -> dict:
    local = current_version()
    info = base_info(config, local)
    try:
        releases = list_releases(config["repository"])
    except NetworkError as error:
        info.update(status="network_error", error=str(error), latest_version=local)
        return info
    published = [item for item in releases if not item.get("draft")]
    if not published:
        info.update(status="no_release", latest_version=local)
        return info
    release = select_release(releases, config["channel"])
    if release is None:
        info.update(
            status="no_compatible_release",
            latest_version=local,
            error=f"No hay una release compatible con el canal {config['channel']}",
        )
        return info
    candidate = release_tag_version(release) or canonical_version(str(release.get("tag_name", "")))
    info["candidate_version"] = candidate
    info["tag"] = release.get("tag_name")
    info["release_name"] = release.get("name") or release.get("tag_name")
    info["published_at"] = release.get("published_at")
    info["html_url"] = release.get("html_url")
    info["notes"] = release.get("body") or ""
    try:
        manifest = manifest_for(release, config)
    except ManifestMissingError as error:
        info.update(status="manifest_missing", error=str(error), latest_version=candidate)
        info["_release"] = release
        return info
    except FileNotFoundError as error:
        info.update(status="manifest_missing", error=str(error), latest_version=candidate)
        info["_release"] = release
        return info
    except ManifestError as error:
        info.update(status="invalid_manifest", error=str(error), latest_version=candidate)
        info["_release"] = release
        return info
    except NetworkError as error:
        info.update(status="network_error", error=str(error), latest_version=candidate)
        info["_release"] = release
        return info
    remote = canonical_version(str(manifest["version"]))
    tag = canonical_version(str(release.get("tag_name", "")))
    if tag and tag != remote:
        info.update(
            status="invalid_manifest",
            error=f"Manifest {manifest['version']} y tag {release.get('tag_name')} no coinciden",
            latest_version=candidate,
        )
        info["_release"] = release
        info["_manifest"] = manifest
        return info
    architecture = manifest.get("arch", "x86_64")
    if architecture not in ("any", platform.machine()):
        info.update(
            status="invalid_manifest",
            error=f"Release para {architecture}; sistema {platform.machine()}",
            latest_version=remote,
        )
        info["_release"] = release
        info["_manifest"] = manifest
        return info
    chosen = {component["id"] for component in selected_components(manifest)}
    components = [
        {
            "id": component["id"],
            "name": component["name"],
            "package": component["package"],
            "version": component["version"],
            "required": component["required"],
            "installed": package_installed(component["package"]),
            "will_update": component["id"] in chosen,
            "restart": component["restart"],
            "size": component.get("size"),
        }
        for component in manifest["components"]
    ]
    available = compare_versions(remote, local) > 0
    info.update(
        status="update_available" if available else "up_to_date",
        latest_version=remote,
        candidate_version=remote,
        update_available=available,
        components=components,
        shell_restart_required=any(item["restart"] == "shell" for item in selected_components(manifest)),
        reboot_required=any(item["restart"] == "system" for item in selected_components(manifest)),
    )
    info["_release"] = release
    info["_manifest"] = manifest
    return info


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def download_to(url: str, destination: Path) -> None:
    headers = {"User-Agent": UA, "Accept": "application/octet-stream"}
    token = os.environ.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    temporary = destination.with_suffix(destination.suffix + ".part")
    temporary.unlink(missing_ok=True)
    try:
        with github_opener().open(urllib.request.Request(url, headers=headers), timeout=60) as response:
            total = int(response.headers.get("Content-Length") or 0)
            done = 0
            with temporary.open("wb") as output:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    output.write(chunk)
                    done += len(chunk)
                    if total:
                        print(f"\rDescargando {destination.name}: {done * 100 // total:3d}%", end="", flush=True)
            if total:
                print()
        os.replace(temporary, destination)
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError) as error:
        temporary.unlink(missing_ok=True)
        destination.unlink(missing_ok=True)
        raise NetworkError(f"could not download {destination.name}: {error}") from error


@contextlib.contextmanager
def update_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise BusyError("another Nodalix update is already running") from error
        yield


def record_history(old: str, new: str, components: list[dict]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    event = {
        "timestamp": utc_now(),
        "from": old,
        "to": new,
        "components": [
            {"id": item["id"], "package": item["package"], "version": item["version"]}
            for item in components
        ],
    }
    with HISTORY_PATH.open("a", encoding="utf-8") as history:
        history.write(json.dumps(event, ensure_ascii=False) + "\n")


def fail_closed(info: dict, action: str) -> None:
    status = info.get("status")
    if status in {"update_available", "up_to_date"} and info.get("_manifest"):
        return
    message = info.get("error") or {
        "no_release": "No hay releases publicadas todavía.",
        "no_compatible_release": f"No hay una release compatible con el canal {info.get('channel')}.",
        "manifest_missing": info.get("error") or "La release no contiene nodalix-manifest.json",
        "invalid_manifest": info.get("error") or "Manifest inválido",
        "network_error": info.get("error") or "Error de red",
    }.get(status, f"Cannot {action}: {status}")
    error_type = {
        "network_error": NetworkError,
        "manifest_missing": ManifestMissingError,
        "invalid_manifest": ManifestError,
    }.get(status, UpdaterError)
    raise error_type(str(message))


def do_update(config: dict, force: bool = False) -> dict:
    if os.geteuid() != 0:
        raise UpdaterError("Usa: sudo nodalix-updater update")
    previous = current_version()
    with update_lock():
        set_status("checking", status="checking", current_version=previous)
        info = release_info(config)
        if info["status"] == "no_release":
            return set_status("no_release", status="no_release", current_version=previous)
        if info["status"] == "no_compatible_release":
            return set_status(
                "no_compatible_release",
                status="no_compatible_release",
                current_version=previous,
                error=info.get("error"),
            )
        if info["status"] == "up_to_date" and not force:
            return set_status("up_to_date", status="up_to_date", current_version=previous, latest_version=info.get("latest_version"))
        fail_closed(info, "update")
        manifest = info["_manifest"]
        minimum = manifest["minimum_version"]
        if compare_versions(current_version(), minimum) < 0:
            raise ManifestError(f"Esta release requiere como mínimo Nodalix {minimum}")
        components = selected_components(manifest)
        if not components:
            raise ManifestError("No hay componentes para actualizar")
        assets = assets_by_name(info["_release"])
        staging = CACHE_DIR / f"v{manifest['version']}"
        staging.mkdir(parents=True, exist_ok=True)
        packages: list[str] = []
        total_size = sum(int(component.get("size") or 0) for component in components)
        for index, component in enumerate(components, start=1):
            set_status(
                "downloading",
                status="downloading",
                version=manifest["version"],
                component=component["id"],
                component_index=index,
                component_count=len(components),
                total_size=total_size,
                current_version=previous,
            )
            asset = assets.get(component["asset"])
            if asset is None:
                raise ManifestMissingError(f"Falta el asset {component['asset']}")
            destination = staging / component["asset"]
            if not destination.exists() or sha256_file(destination) != component["sha256"].lower():
                download_to(asset_download_url(asset), destination)
            set_status("verifying", status="verifying", version=manifest["version"], component=component["id"])
            digest = sha256_file(destination)
            if digest != component["sha256"].lower():
                destination.unlink(missing_ok=True)
                raise IntegrityError(f"SHA-256 incorrecto para {component['asset']}")
            packages.append(str(destination))
        set_status("installing", status="installing", version=manifest["version"], components=[item["id"] for item in components])
        # Pacman replaces files, including this script. Keep running from the
        # already-loaded Python process; do not re-exec mid-transaction.
        subprocess.run(
            ["pacman", "-U", "--noconfirm", "--needed", "--overwrite", "/etc/nodalix-release", *packages],
            check=True,
        )
        installed = current_version()
        if installed != canonical_version(str(manifest["version"])):
            raise UpdaterError(
                f"packages installed but system identity is {installed}, expected {manifest['version']}"
            )
        record_history(previous, installed, components)
        result = set_status(
            "completed",
            status="completed",
            previous_version=previous,
            current_version=installed,
            components=[item["id"] for item in components],
            shell_restart_required=any(item["restart"] == "shell" for item in components),
            reboot_required=any(item["restart"] == "system" for item in components),
        )
        print(f"Nodalix actualizado: {previous} -> {installed}")
        if result.get("shell_restart_required"):
            print("Reinicia la shell para aplicar todos los cambios.")
        if result.get("reboot_required"):
            print("Esta actualización requiere reiniciar el sistema.")
        return result


def public_info(info: dict) -> dict:
    return {key: value for key, value in info.items() if not key.startswith("_")}


def human_check_message(data: dict) -> str:
    status = data.get("status")
    current = data.get("current_version")
    if status == "update_available":
        lines = [f"Actualización disponible: {current} -> {data.get('latest_version')}"]
        for component in data.get("components") or []:
            if component.get("will_update"):
                lines.append(f"  - {component.get('name')} ({component.get('version') or 'nueva versión'})")
        return "\n".join(lines)
    if status == "up_to_date":
        return f"Nodalix {current} está actualizado."
    if status == "no_release":
        return f"Nodalix {current}: todavía no hay releases publicadas."
    if status == "no_compatible_release":
        return f"Nodalix {current}: no hay una release compatible con el canal {data.get('channel')}."
    if status == "manifest_missing":
        return data.get("error") or f"La release no contiene {DEFAULT_CONFIG['manifest_asset']}"
    if status == "invalid_manifest":
        return data.get("error") or "Manifest inválido"
    if status == "network_error":
        return data.get("error") or "Error de red"
    return data.get("error") or data.get("state") or f"Nodalix {current}"


def emit(data: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(public_info(data), ensure_ascii=False))
        return
    if data.get("status") in {
        "no_release",
        "no_compatible_release",
        "manifest_missing",
        "invalid_manifest",
        "update_available",
        "up_to_date",
        "network_error",
    }:
        print(human_check_message(data))
        return
    if "version" in data and "channel" in data:
        print(f"Nodalix {data['version']} ({data['channel']})")
        return
    print(data.get("state") or human_check_message(data))


def error_payload(error: UpdaterError, current: str | None = None) -> dict:
    payload = {
        "status": getattr(error, "status", "update_error"),
        "state": "error_recoverable" if error.recoverable else "error_critical",
        "code": error.code,
        "update_available": False,
        "error": str(error),
        "message": str(error),
    }
    if current is not None:
        payload["current_version"] = current
    return payload


def main() -> int:
    parser = argparse.ArgumentParser(prog="nodalix-updater")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("info", "check", "status"):
        command = commands.add_parser(name)
        command.add_argument("--json", action="store_true")
    update = commands.add_parser("update")
    update.add_argument("--force", action="store_true")
    update.add_argument("--json", action="store_true")
    history = commands.add_parser("history")
    history.add_argument("--json", action="store_true")
    channel = commands.add_parser("channel")
    channel.add_argument("name", nargs="?", choices=VALID_CHANNELS)
    channel.add_argument("--json", action="store_true")
    args = parser.parse_args()
    current = current_version()
    try:
        config = load_config()
        if args.command == "info":
            emit(
                {
                    "name": "Nodalix",
                    "version": current,
                    "channel": config["channel"],
                    "repository": config["repository"],
                },
                args.json,
            )
        elif args.command == "check":
            data = release_info(config)
            emit(data, args.json)
            if data["status"] in {"network_error"}:
                return 2
            return 0
        elif args.command == "status":
            emit(load_status(), args.json)
        elif args.command == "update":
            emit(do_update(config, args.force), args.json)
        elif args.command == "history":
            events = []
            if HISTORY_PATH.exists():
                events = [json.loads(line) for line in HISTORY_PATH.read_text(encoding="utf-8").splitlines() if line]
            emit({"history": events}, args.json)
        elif args.command == "channel":
            if args.name is None:
                emit({"channel": config["channel"], "version": current, "repository": config["repository"]}, args.json)
                return 0
            if os.geteuid() != 0:
                raise UpdaterError("Usa: sudo nodalix-updater channel stable|beta")
            config["channel"] = args.name
            written = write_config(config)
            emit(
                {
                    "channel": written["channel"],
                    "version": current,
                    "repository": written["repository"],
                    "config": str(CONFIG_PATH),
                },
                args.json,
            )
        return 0
    except UpdaterError as error:
        payload = error_payload(error, current)
        with contextlib.suppress(OSError):
            set_status(payload["state"], **payload)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False))
        else:
            print(f"Error: {error}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as error:
        payload = {
            "status": "install_failed",
            "state": "error_critical",
            "code": "package_transaction_failed",
            "current_version": current_version(),
            "update_available": False,
            "error": f"pacman exited with status {error.returncode}",
            "message": f"pacman exited with status {error.returncode}",
        }
        with contextlib.suppress(OSError):
            set_status(**payload)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False))
        else:
            print(f"Error: {payload['message']}", file=sys.stderr)
        return error.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
