#!/usr/bin/env bash
set -u -o pipefail
export LC_ALL=C

ANCS_UUID="7905f431-b5ce-4e99-a40f-4b1e122d00d0"

log() {
    printf "[nodalix-phone-link] %s\n" "$*"
}

# Wait until the Bluetooth controller is usable. Some adapters appear a
# little after bluetoothd has started.
adapter_ready=0

for attempt in {1..15}; do
    if /usr/bin/btmgmt info 2>/dev/null | /usr/bin/grep -q "current settings:"; then
        adapter_ready=1
        break
    fi

    /usr/bin/sleep 1
done

if (( ! adapter_ready )); then
    log "Bluetooth controller did not become ready"
    exit 0
fi

# Advertise the A/V Hands-Free service class expected by the phone-link
# telephony integration.
class_ready=0

for attempt in {1..10}; do
    if /usr/bin/btmgmt class 4 8 >/dev/null 2>&1; then
        class_ready=1
        break
    fi

    /usr/bin/sleep 0.5
done

if (( class_ready )); then
    log "Bluetooth class prepared"
else
    log "could not set Bluetooth class after retries; continuing"
fi

# BlueZ 5.87 can restore the bond/IRK of a dual-mode iPhone without
# programming ADDRESS_RESOLUTION into the controller. In that state LE
# connections remain stuck in InProgress even though the device is bonded.
#
# Apply ADDRESS_RESOLUTION to paired iPhones before ANCS is discoverable.
# A classic Apple HFP+MAP device can still be identified while GATT is down;
# requiring the ANCS UUID here would make the recovery circular.
mapfile -t paired_devices < <(
    /usr/bin/bluetoothctl devices Paired 2>/dev/null |
    /usr/bin/awk "{print \$2}"
)

for mac in "${paired_devices[@]}"; do
    [[ -n "$mac" ]] || continue

    info=$(
        /usr/bin/bluetoothctl info "$mac" 2>/dev/null ||
        true
    )

    if ! /usr/bin/grep -qi "$ANCS_UUID" <<< "$info"; then
        if ! /usr/bin/grep -qi 'Modalias: bluetooth:v004c' <<< "$info" ||
           ! /usr/bin/grep -qi '0000111f-0000-1000-8000-00805f9b34fb' <<< "$info" ||
           ! /usr/bin/grep -qi '00001132-0000-1000-8000-00805f9b34fb' <<< "$info"; then
            continue
        fi
    fi

    address_type=$(
        /usr/bin/sed -n             "s/^[[:space:]]*AddressType:[[:space:]]*//p"             <<< "$info" |
        /usr/bin/head -n 1 |
        /usr/bin/tr "[:upper:]" "[:lower:]"
    )

    case "$address_type" in
        random)
            btmgmt_type=2
            ;;
        *)
            # Dual-mode iPhones normally expose a public identity address.
            btmgmt_type=1
            ;;
    esac

    # Keep unrelated flags such as remote wakeup. A classic-only bond has no
    # LE management entry and is intentionally left to normal iOS pairing.
    flags=$(/usr/bin/timeout 5 /usr/bin/btmgmt get-flags -t "$btmgmt_type" "$mac" 2>/dev/null) || continue
    supported=$(/usr/bin/sed -nE 's/^Supported Flags:[[:space:]]+(0x[0-9a-fA-F]+)$/\1/p' <<< "$flags")
    current=$(/usr/bin/sed -nE 's/^Current Flags:[[:space:]]+(0x[0-9a-fA-F]+)$/\1/p' <<< "$flags")
    [[ "$supported" =~ ^0x[0-9a-fA-F]+$ && "$current" =~ ^0x[0-9a-fA-F]+$ ]] || continue
    (( (supported & 4) != 0 && (current & 4) == 0 )) || continue
    printf -v updated '0x%08x' "$((current | 4))"
    if /usr/bin/timeout 5 /usr/bin/btmgmt set-flags -t "$btmgmt_type" -f "$updated" "$mac" >/dev/null 2>&1; then
        log "Address resolution enabled for paired iPhone notifications"
    else
        log "Could not enable address resolution for paired iPhone notifications"
    fi
done

exit 0
