[Unit]
Description=Prepare Bluetooth for Nodalix Phone Link
After=bluetooth.service
Requires=bluetooth.service
PartOf=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/lib/nodalix-phone-link/prepare-bluetooth
RemainAfterExit=yes

# Bluetooth preparation must retain network administration for btmgmt, but it
# does not need filesystem write access or access to user homes.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
