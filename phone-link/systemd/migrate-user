#!/usr/bin/env python3
from pathlib import Path
import shutil
import subprocess
import sys
import time

home = Path.home()
env_file = home / ".config/iphonebridge/local.env"
legacy_unit = home / ".config/systemd/user/iphonebridge.service"
legacy_code = home / ".local/share/nodalix/iphonebridge"


def systemctl(*args):
    return subprocess.run(
        ["systemctl", "--user", *args],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# Nothing to migrate until Phone Link has been configured.
if not env_file.exists():
    print("Nodalix Phone Link: no local.env; migration skipped")
    raise SystemExit(0)

systemctl("daemon-reload")

# Enable the packaged service first. Do not destroy the old installation
# until the replacement has actually started.
if systemctl("enable", "nodalix-phone-link.service").returncode != 0:
    print("Nodalix Phone Link: could not enable packaged service")
    raise SystemExit(1)

start = systemctl("start", "nodalix-phone-link.service")

if start.returncode == 0:
    time.sleep(2)

if start.returncode != 0:
    print("Nodalix Phone Link: packaged service failed; preserving legacy installation")
    systemctl("start", "iphonebridge.service")
    raise SystemExit(1)

active = systemctl("is-active", "nodalix-phone-link.service")

if active.returncode != 0:
    print("Nodalix Phone Link: packaged service is not active; preserving legacy installation")
    systemctl("start", "iphonebridge.service")
    raise SystemExit(1)

# Replacement is alive. The old unit/code can now be removed safely.
systemctl("disable", "--now", "iphonebridge.service")

try:
    legacy_unit.unlink(missing_ok=True)
except OSError as exc:
    print(f"Nodalix Phone Link: could not remove legacy unit: {exc}")

if legacy_code.exists():
    try:
        shutil.rmtree(legacy_code)
    except OSError as exc:
        print(f"Nodalix Phone Link: could not remove legacy code: {exc}")

systemctl("daemon-reload")

print("Nodalix Phone Link: migration complete")
print(f"Nodalix Phone Link: preserved {env_file}")
