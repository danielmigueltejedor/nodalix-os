#!/usr/bin/env python3
"""Safe settings bridge used by the Nodalix shell Phone Link page."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "iphonebridge"
ENV_FILE = CONFIG_DIR / "local.env"
SERVICE = "nodalix-phone-link.service"
KEYS = {
    "name": "IPHONEBRIDGE_BLE_NAME",
    "auto_reconnect": "IPHONEBRIDGE_AUTO_RECONNECT",
    "notifications": "IPHONEBRIDGE_NOTIFICATIONS",
    "calls": "IPHONEBRIDGE_CALLS",
    "copy_codes": "IPHONEBRIDGE_COPY_VERIFICATION_CODES",
}


def read_env() -> tuple[list[str], dict[str, str]]:
    lines = ENV_FILE.read_text(encoding="utf-8").splitlines() if ENV_FILE.exists() else []
    values: dict[str, str] = {}
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return lines, values


def bool_value(value: str | None, default: bool) -> bool:
    if value is None:
        return default
    return value.strip().lower() in {"1", "true", "yes", "on"}


def service_active() -> bool:
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", SERVICE], check=False
    ).returncode == 0


def service_enabled() -> bool:
    return subprocess.run(
        ["systemctl", "--user", "is-enabled", "--quiet", SERVICE], check=False
    ).returncode == 0


def status() -> int:
    _, values = read_env()
    mac = values.get("IPHONEBRIDGE_MAC", "")
    configured = bool(mac and mac.upper() != "AA:BB:CC:DD:EE:FF")
    print(json.dumps({
        "configured": configured,
        "active": service_active(),
        "enabled": service_enabled(),
        "name": values.get("IPHONEBRIDGE_BLE_NAME", "Nodalix"),
        "auto_reconnect": bool_value(values.get("IPHONEBRIDGE_AUTO_RECONNECT"), True),
        "notifications": bool_value(values.get("IPHONEBRIDGE_NOTIFICATIONS"), True),
        "calls": bool_value(values.get("IPHONEBRIDGE_CALLS"), True),
        "copy_codes": bool_value(values.get("IPHONEBRIDGE_COPY_VERIFICATION_CODES"), False),
    }, ensure_ascii=False))
    return 0


def encode(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ") + '"'


def set_value(name: str, value: str) -> int:
    if name not in KEYS:
        return 2
    if name == "name":
        value = value.strip()[:48] or "Nodalix"
    else:
        value = "1" if value.lower() in {"1", "true", "yes", "on"} else "0"
    target_key = KEYS[name]
    lines, _ = read_env()
    output: list[str] = []
    replaced = False
    for line in lines:
        if line.lstrip().startswith(target_key + "="):
            output.append(f"{target_key}={encode(value)}")
            replaced = True
        else:
            output.append(line)
    if not replaced:
        output.append(f"{target_key}={encode(value)}")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    temporary = ENV_FILE.with_suffix(".tmp")
    temporary.write_text("\n".join(output).rstrip() + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(ENV_FILE)
    subprocess.run(["systemctl", "--user", "restart", SERVICE], check=False)
    return 0


def set_enabled(value: str) -> int:
    action = "enable" if value.lower() in {"1", "true", "yes", "on"} else "disable"
    command = ["systemctl", "--user", action, "--now", SERVICE]
    return subprocess.run(command, check=False).returncode


def action(name: str) -> int:
    if name == "restart":
        return subprocess.run(["systemctl", "--user", "restart", SERVICE], check=False).returncode
    if name == "contacts":
        return subprocess.run(["enlace-movil", "contacts-sync"], check=False).returncode
    if name == "open":
        subprocess.Popen(["enlace-movil-ui"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    return 2


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        return status()
    if len(sys.argv) == 3 and sys.argv[1] == "enable":
        return set_enabled(sys.argv[2])
    if len(sys.argv) == 4 and sys.argv[1] == "set":
        return set_value(sys.argv[2], sys.argv[3])
    if len(sys.argv) == 3 and sys.argv[1] == "action":
        return action(sys.argv[2])
    print("invalid arguments", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
