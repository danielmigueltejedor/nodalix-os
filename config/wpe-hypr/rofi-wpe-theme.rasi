configuration {
  show-icons: true;
  font: "JetBrainsMono Nerd Font 11";
}

* {
  bg: #0b0d12;
  bg2: #11141c;
  bg3: #171b25;
  card: #151923;
  card-hover: #202637;
  border: #2b3244;
  border-soft: #232937;

  fg: #eef1f8;
  muted: #9aa4b8;
  accent: #8aadf4;
  accent2: #c6a0f6;

  transparent: rgba(0, 0, 0, 0);
}

window {
  width: 76%;
  height: 82%;
  location: center;
  anchor: center;

  background-color: @bg;
  text-color: @fg;

  border: 2px;
  border-color: @border;
  border-radius: 24px;

  padding: 18px;
}

mainbox {
  background-color: @bg;
  spacing: 14px;
  children: [ inputbar, listview ];
}

inputbar {
  background-color: @bg2;
  text-color: @fg;

  border: 1px;
  border-color: @border-soft;
  border-radius: 18px;

  padding: 10px 14px;
  spacing: 10px;

  children: [ prompt, entry ];
}

prompt {
  background-color: @transparent;
  text-color: @accent;
  font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
  background-color: @transparent;
  text-color: @fg;
  placeholder-color: @muted;
  cursor-color: @accent;
}

listview {
  background-color: @bg;

  columns: 2;
  lines: 5;
  spacing: 10px;

  fixed-height: false;
  dynamic: true;
  scrollbar: true;
}

scrollbar {
  background-color: @bg;
  handle-color: @card-hover;
  border-radius: 10px;
  width: 7px;
}

element {
  background-color: @card;
  text-color: @fg;

  border: 1px;
  border-color: @border-soft;
  border-radius: 18px;

  padding: 8px;
  spacing: 11px;

  orientation: horizontal;
  cursor: pointer;
}

element normal.normal,
element alternate.normal {
  background-color: @card;
  text-color: @fg;
}

element normal.active,
element alternate.active {
  background-color: @card;
  text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
  background-color: @card;
  text-color: #ed8796;
}

element selected.normal,
element selected.active {
  background-color: @card-hover;
  text-color: @fg;

  border: 2px;
  border-color: @accent;
}

element selected.urgent {
  background-color: @card-hover;
  text-color: #ed8796;

  border: 2px;
  border-color: #ed8796;
}

element-icon {
  background-color: @transparent;

  size: 190px;
  border-radius: 14px;
}

element-text {
  background-color: @transparent;
  text-color: inherit;

  vertical-align: 0.5;
  horizontal-align: 0.0;

  font: "JetBrainsMono Nerd Font 10";
}

message {
  background-color: @bg2;
  text-color: @fg;

  border-radius: 14px;
  padding: 10px;
}

textbox {
  background-color: @transparent;
  text-color: @muted;
}
