{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": [
    "custom/nodalix-menu",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/nodalix-center"
  ],
  "modules-right": [
    "custom/nodalix-right"
  ],
  "custom/nodalix-menu": {
    "format": "󱄅",
    "tooltip": true,
    "tooltip-format": "Nodalix Menu",
    "on-click": "nodalix-command-bar-toggle"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "format-active": "{id}",
    "format-visible": "{id}",
    "format-occupied": "{id}",
    "format-empty": "{id}",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "on-click": "activate",
    "sort-by-number": true
  },
  "custom/nodalix-center": {
    "exec": "nodalix-center-island",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/nodalix-right": {
    "exec": "nodalix-right-island",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "nodalix-command-bar-toggle",
    "on-click-right": "pavucontrol"
  }
}
