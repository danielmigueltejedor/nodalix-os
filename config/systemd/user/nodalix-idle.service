# DEPRECATED — do not enable.
#
# This swayidle unit duplicated hypridle (Hyprland autostart) and caused multiple
# hyprlock instances after idle unlock. Use ~/.config/hypr/hypridle.conf instead.
#
# Disable if still active:
#   systemctl --user disable --now nodalix-idle.service

[Unit]
Description=Nodalix idle manager (deprecated — use hypridle)
Documentation=file:///dev/null

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=no

[Install]
# Intentionally empty — never enable this unit.
