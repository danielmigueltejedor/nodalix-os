#!/usr/bin/env bash
set -euo pipefail

source "/usr/share/nodalix-apps/bin/nodalix-apps-lib.sh"

UPSTREAM_HOST="github.com"
UPSTREAM="https://${UPSTREAM_HOST}/SethRobinson/Patchy.git"

# Vacío mientras no haya modificaciones locales.
# Si creamos fork:
# FORK="https://github.com/danielmigueltejedor/Patchy.git"
FORK=""

OVERLAY_REMOTE="nodalix"
OVERLAY_BRANCH="nodalix"

SRC="$HOME/.cache/nodalix-apps/src/patchy"
ROOT="$HOME/.local/opt/nodalix/apps/patchy"
VERSIONS="$ROOT/versions"
CURRENT="$ROOT/current"

mkdir -p "$VERSIONS"
mkdir -p "$(dirname "$SRC")"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/share/applications"
mkdir -p "$HOME/.local/share/metainfo"

TMPDEST=""
SMOKE_DIR=""

cleanup() {
    if [ -n "$TMPDEST" ] && [ -d "$TMPDEST" ]; then
        rm -rf "$TMPDEST"
    fi

    if [ -n "$SMOKE_DIR" ] && [ -d "$SMOKE_DIR" ]; then
        rm -rf "$SMOKE_DIR"
    fi
}

trap cleanup EXIT

echo "==> Nodalix Patchy updater"

for tool in git cmake ninja; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "ERROR: falta la dependencia de build: $tool"
        exit 1
    fi
done

if [ ! -d "$SRC/.git" ]; then
    echo "==> Clonando upstream..."
    git clone "$UPSTREAM" "$SRC"
fi

cd "$SRC"

git cherry-pick --abort >/dev/null 2>&1 || true
git am --abort >/dev/null 2>&1 || true
git reset --hard >/dev/null
git clean -fd >/dev/null

echo "==> Actualizando upstream..."
git fetch origin main --tags --prune

LATEST_TAG=""

while IFS= read -r tag; do
    if [[ "$tag" =~ ^v?[0-9]+(\.[0-9]+)+$ ]]; then
        LATEST_TAG="$tag"
        break
    fi
done < <(git tag --sort=-version:refname)

if [ -n "$LATEST_TAG" ]; then
    UPSTREAM_REF="$LATEST_TAG"
    TRACKING="release:$LATEST_TAG"
else
    UPSTREAM_REF="origin/main"
    TRACKING="origin/main"
fi

COMMIT="$(git rev-parse "$UPSTREAM_REF")"
SHORT="$(git rev-parse --short=12 "$COMMIT")"

VERSION="$(
    git show "${UPSTREAM_REF}:CMakeLists.txt" \
    | awk '
        !found && /^[[:space:]]*VERSION[[:space:]]+[0-9]/ {
            print $2
            found=1
        }
    '
)"

if [ -z "$VERSION" ]; then
    echo "ERROR: no se pudo determinar la versión de Patchy."
    exit 1
fi

CPU="$(nodalix_cpu_name)"
SAFE_CPU="$(nodalix_safe_cpu "$CPU")"

OVERLAY_HASH="none"
OVERLAY_ID="none"
OVERLAY_REF=""

if [ -n "$FORK" ]; then
    echo "==> Actualizando overlay Nodalix..."

    nodalix_ensure_overlay_remote "$OVERLAY_REMOTE" "$FORK"
    nodalix_fetch_overlay "$OVERLAY_REMOTE" "$OVERLAY_BRANCH"

    OVERLAY_REF="refs/remotes/$OVERLAY_REMOTE/$OVERLAY_BRANCH"
    nodalix_prepare_overlay "patchy" "$UPSTREAM_REF" "$OVERLAY_REF"
    OVERLAY_HASH="$NODALIX_OVERLAY_HASH"
    OVERLAY_ID="${OVERLAY_HASH:0:12}"
fi

BUILD_ID="${VERSION}-${SHORT}-${SAFE_CPU}-${OVERLAY_ID}"
DEST="$VERSIONS/$BUILD_ID"

echo
echo "Versión:  $VERSION"
echo "Tracking: $TRACKING"
echo "Commit:   $COMMIT"
echo "CPU:      $CPU"
echo "Overlay:  $OVERLAY_ID"

if [ -n "$OVERLAY_REF" ]; then
    echo
    echo "Cambios Nodalix efectivos:"
    nodalix_show_prepared_overlay
fi

echo

if [ -x "$DEST/bin/patchy" ] \
    && [ -x "$DEST/bin/patchy-mcp" ] \
    && [ -f "$DEST/share/applications/com.rtsoft.patchy.desktop" ]; then

    echo "==> Esta combinación upstream + CPU + overlay ya está compilada."
else
    echo "==> Preparando fuente limpia..."

    git checkout --detach "$UPSTREAM_REF"
    git reset --hard "$UPSTREAM_REF"
    git clean -fd

    if [ -n "$OVERLAY_REF" ]; then
        nodalix_apply_prepared_overlay
    fi

    TMPDEST="$VERSIONS/.patchy-build-${VERSION}-${OVERLAY_ID}-$$"
    rm -rf "$TMPDEST"
    mkdir -p "$TMPDEST"

    echo
    echo "==> Configurando build nativa para:"
    echo "    $CPU"

    cmake \
        -S . \
        -B build/nodalix \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$TMPDEST" \
        -DPATCHY_BUILD_APP=ON \
        -DPATCHY_BUILD_TESTS=OFF \
        "-DCMAKE_C_FLAGS=-march=native -mtune=native" \
        "-DCMAKE_CXX_FLAGS=-march=native -mtune=native"

    echo
    echo "==> Compilando Patchy..."
    cmake --build build/nodalix --parallel "$(nproc)"

    echo
    echo "==> Instalando en staging..."
    cmake --install build/nodalix --prefix "$TMPDEST"

    if [ ! -x "$TMPDEST/bin/patchy" ]; then
        echo "ERROR: no se generó bin/patchy."
        exit 1
    fi

    if [ ! -x "$TMPDEST/bin/patchy-mcp" ]; then
        echo "ERROR: no se generó bin/patchy-mcp."
        exit 1
    fi

    if [ ! -f "$TMPDEST/share/applications/com.rtsoft.patchy.desktop" ]; then
        echo "ERROR: falta el desktop entry de Patchy."
        exit 1
    fi

    echo
    echo "==> Ejecutando smoke test..."

    SMOKE_DIR="$(mktemp -d)"
    mkdir -p "$SMOKE_DIR/settings"

    printf "%s\n" \
        "console.log(\"Nodalix Patchy smoke test\");" \
        > "$SMOKE_DIR/test.js"

    PATCHY_SETTINGS_DIR="$SMOKE_DIR/settings" \
    PATCHY_NO_SOUND=1 \
    QT_QPA_PLATFORM=offscreen \
    "$TMPDEST/bin/patchy" \
        --headless \
        --run-script "$SMOKE_DIR/test.js" \
        --script-output "$SMOKE_DIR/output.txt"

    if [ "$(tail -n1 "$SMOKE_DIR/output.txt" 2>/dev/null)" != "[done]" ]; then
        echo "ERROR: el smoke test de Patchy ha fallado."
        cat "$SMOKE_DIR/output.txt" 2>/dev/null || true
        exit 1
    fi

    echo "==> Comprobando Patchy MCP..."

    MCP_CHECK="$(
        PATCHY_SETTINGS_DIR="$SMOKE_DIR/settings" \
        PATCHY_NO_SOUND=1 \
        QT_QPA_PLATFORM=offscreen \
        "$TMPDEST/bin/patchy-mcp" --check
    )"

    if ! grep -q "\"ok\":true" <<< "$MCP_CHECK"; then
        echo "ERROR: patchy-mcp --check ha fallado."
        echo "$MCP_CHECK"
        exit 1
    fi

    rm -rf "$SMOKE_DIR"
    SMOKE_DIR=""

    echo "$VERSION" > "$TMPDEST/version"
    echo "$COMMIT" > "$TMPDEST/commit"
    echo "$CPU" > "$TMPDEST/cpu"
    echo "$OVERLAY_HASH" > "$TMPDEST/overlay"

    mv "$TMPDEST" "$DEST"
    TMPDEST=""

    echo "==> Build validada correctamente."
fi

echo
echo "==> Activando Patchy..."

CURRENT_TMP="$ROOT/.current.new.$$"
rm -f "$CURRENT_TMP"
ln -s "$DEST" "$CURRENT_TMP"
mv -Tf "$CURRENT_TMP" "$CURRENT"

BINLINK="$HOME/.local/bin/.patchy.new.$$"
rm -f "$BINLINK"
ln -s "$CURRENT/bin/patchy" "$BINLINK"
mv -Tf "$BINLINK" "$HOME/.local/bin/patchy"

MCP_LINK="$HOME/.local/bin/.patchy-mcp.new.$$"
rm -f "$MCP_LINK"
ln -s "$CURRENT/bin/patchy-mcp" "$MCP_LINK"
mv -Tf "$MCP_LINK" "$HOME/.local/bin/patchy-mcp"

cp \
    "$CURRENT/share/applications/com.rtsoft.patchy.desktop" \
    "$HOME/.local/share/applications/com.rtsoft.patchy.desktop"

sed -i \
    "s|^Exec=.*|Exec=$HOME/.local/bin/patchy %F|" \
    "$HOME/.local/share/applications/com.rtsoft.patchy.desktop"

sed -i \
    "s|^Icon=.*|Icon=com.rtsoft.patchy|" \
    "$HOME/.local/share/applications/com.rtsoft.patchy.desktop"

if [ -f "$CURRENT/share/metainfo/com.rtsoft.patchy.metainfo.xml" ]; then
    cp \
        "$CURRENT/share/metainfo/com.rtsoft.patchy.metainfo.xml" \
        "$HOME/.local/share/metainfo/com.rtsoft.patchy.metainfo.xml"
fi

echo "==> Reaplicando integración e iconos Nodalix..."
nodalix_finish_update

echo
echo "==> Patchy activo"
echo "    Versión: $VERSION"
echo "    Commit:  $SHORT"
echo "    CPU:     $CPU"
echo "    Overlay: $OVERLAY_ID"
echo "    Ruta:    $CURRENT"
