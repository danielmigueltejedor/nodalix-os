#!/usr/bin/env bash
set -euo pipefail

source "/usr/share/nodalix-apps/bin/nodalix-apps-lib.sh"

UPSTREAM_HOST="github.com"
UPSTREAM="https://${UPSTREAM_HOST}/hyprlab/hylki.git"
FORK="https://${UPSTREAM_HOST}/danielmigueltejedor/hylki.git"

OVERLAY_REMOTE="nodalix"
OVERLAY_BRANCH="nodalix"

SRC="$HOME/.cache/nodalix-apps/src/hylki"
ROOT="$HOME/.local/opt/nodalix/apps/hylki"
VERSIONS="$ROOT/versions"
CURRENT="$ROOT/current"

mkdir -p "$VERSIONS"
mkdir -p "$(dirname "$SRC")"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/share/applications"

TMPDEST=""

cleanup() {
    if [ -n "$TMPDEST" ] && [ -d "$TMPDEST" ]; then
        rm -rf "$TMPDEST"
    fi
}

trap cleanup EXIT

echo "==> Nodalix Hylki updater"

if [ ! -d "$SRC/.git" ]; then
    echo "==> Clonando upstream..."
    git clone "$UPSTREAM" "$SRC"
fi

cd "$SRC"

git cherry-pick --abort >/dev/null 2>&1 || true
git am --abort >/dev/null 2>&1 || true
git reset --hard >/dev/null
git clean -fd >/dev/null

echo "==> Actualizando upstream..."
git fetch origin --tags --prune

echo "==> Actualizando overlay Nodalix..."
nodalix_ensure_overlay_remote "$OVERLAY_REMOTE" "$FORK"
nodalix_fetch_overlay "$OVERLAY_REMOTE" "$OVERLAY_BRANCH"

LATEST_TAG=""

while IFS= read -r tag; do
    if [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        LATEST_TAG="$tag"
        break
    fi
done < <(git tag --sort=-version:refname)

if [ -z "$LATEST_TAG" ]; then
    echo "ERROR: no se encontró ninguna release estable."
    exit 1
fi

UPSTREAM_REF="$LATEST_TAG"
OVERLAY_REF="refs/remotes/$OVERLAY_REMOTE/$OVERLAY_BRANCH"

COMMIT="$(git rev-list -n1 "$UPSTREAM_REF")"
CPU="$(nodalix_cpu_name)"
SAFE_CPU="$(nodalix_safe_cpu "$CPU")"

nodalix_prepare_overlay \
    "hylki" \
    "$UPSTREAM_REF" \
    "$OVERLAY_REF"

OVERLAY_HASH="$NODALIX_OVERLAY_HASH"
OVERLAY_ID="$NODALIX_OVERLAY_ID"

DEST="$VERSIONS/${LATEST_TAG}-${SAFE_CPU}-${OVERLAY_ID}"

echo
echo "Release:  $LATEST_TAG"
echo "Commit:   $COMMIT"
echo "CPU:      $CPU"
echo "Overlay:  $OVERLAY_ID"
echo
echo "Cambios Nodalix efectivos:"
nodalix_show_prepared_overlay
echo

if [ -x "$DEST/bin/hylki" ]; then
    echo "==> Esta combinación upstream + CPU + overlay ya está compilada."
else
    echo "==> Preparando fuente limpia..."

    git checkout --detach "$UPSTREAM_REF"
    git reset --hard "$UPSTREAM_REF"
    git clean -fd

    nodalix_apply_prepared_overlay

    echo
    echo "==> Regenerando catálogo gettext..."
    ./tools/update-pot.sh

    echo "==> Sincronizando todos los idiomas..."

    for po in po/*.po; do
        msgmerge \
            --update \
            --backup=none \
            "$po" \
            po/hylki.pot \
            >/dev/null
    done

    TMPDEST="$VERSIONS/.hylki-build-${LATEST_TAG}-${OVERLAY_ID}-$$"
    rm -rf "$TMPDEST"

    echo
    echo "==> Compilando específicamente para:"
    echo "    $CPU"

    RUSTFLAGS="-C target-cpu=native" \
    PREFIX="$TMPDEST" \
    ./install.sh

    if [ ! -x "$TMPDEST/bin/hylki" ]; then
        echo "ERROR: no se generó bin/hylki."
        exit 1
    fi

    echo "$LATEST_TAG" > "$TMPDEST/version"
    echo "$COMMIT" > "$TMPDEST/commit"
    echo "$CPU" > "$TMPDEST/cpu"
    echo "$OVERLAY_HASH" > "$TMPDEST/overlay"

    mv "$TMPDEST" "$DEST"
    TMPDEST=""

    echo "==> Build terminada correctamente."
fi

echo
echo "==> Activando Hylki..."

CURRENT_TMP="$ROOT/.current.new.$$"
rm -f "$CURRENT_TMP"
ln -s "$DEST" "$CURRENT_TMP"
mv -Tf "$CURRENT_TMP" "$CURRENT"

BINLINK="$HOME/.local/bin/.hylki.new.$$"
rm -f "$BINLINK"
ln -s "$CURRENT/bin/hylki" "$BINLINK"
mv -Tf "$BINLINK" "$HOME/.local/bin/hylki"

cp \
    "$DEST/share/applications/co.hyprlab.Hylki.desktop" \
    "$HOME/.local/share/applications/co.hyprlab.Hylki.desktop"

sed -i \
    "s|^Exec=.*|Exec=$HOME/.local/bin/hylki %U|" \
    "$HOME/.local/share/applications/co.hyprlab.Hylki.desktop"

sed -i \
    "s|^Icon=.*|Icon=co.hyprlab.Hylki|" \
    "$HOME/.local/share/applications/co.hyprlab.Hylki.desktop"

echo "==> Reaplicando integración e iconos Nodalix..."
nodalix_finish_update

echo
echo "==> Hylki activo"
echo "    Release: $LATEST_TAG"
echo "    CPU:     $CPU"
echo "    Overlay: $OVERLAY_ID"
echo "    Ruta:    $CURRENT"
