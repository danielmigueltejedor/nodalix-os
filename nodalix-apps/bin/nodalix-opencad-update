#!/usr/bin/env bash
set -euo pipefail

source "/usr/share/nodalix-apps/bin/nodalix-apps-lib.sh"

UPSTREAM_HOST="github.com"
UPSTREAM="https://${UPSTREAM_HOST}/HakanSeven12/OpenCADStudio.git"

# Vacío mientras no existan modificaciones locales.
# Cuando exista fork Nodalix:
# FORK="https://github.com/danielmigueltejedor/OpenCADStudio.git"
FORK=""

OVERLAY_REMOTE="nodalix"
OVERLAY_BRANCH="nodalix"

SRC="$HOME/.cache/nodalix-apps/src/opencad"
ROOT="$HOME/.local/opt/nodalix/apps/opencad"
VERSIONS="$ROOT/versions"
CURRENT="$ROOT/current"

mkdir -p "$VERSIONS"
mkdir -p "$(dirname "$SRC")"
mkdir -p "$HOME/.local/bin"

TMPDEST=""

cleanup() {
    if [ -n "$TMPDEST" ] && [ -d "$TMPDEST" ]; then
        rm -rf "$TMPDEST"
    fi
}

trap cleanup EXIT

echo "==> Nodalix OpenCAD Studio updater"

if [ ! -d "$SRC/.git" ]; then
    echo "==> Clonando upstream..."
    git clone "$UPSTREAM" "$SRC"
fi

cd "$SRC"

git cherry-pick --abort >/dev/null 2>&1 || true
git am --abort >/dev/null 2>&1 || true
git reset --hard >/dev/null
git clean -fd >/dev/null

echo "==> Actualizando upstream..."
git fetch origin --tags --prune

LATEST_TAG=""

while IFS= read -r tag; do
    if [[ "$tag" =~ ^v[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
        LATEST_TAG="$tag"
        break
    fi
done < <(git tag --sort=-version:refname)

if [ -z "$LATEST_TAG" ]; then
    echo "ERROR: no se encontró ninguna release estable."
    exit 1
fi

UPSTREAM_REF="$LATEST_TAG"
COMMIT="$(git rev-list -n1 "$UPSTREAM_REF")"

CPU="$(nodalix_cpu_name)"
SAFE_CPU="$(nodalix_safe_cpu "$CPU")"

OVERLAY_HASH="none"
OVERLAY_ID="none"
OVERLAY_REF=""

if [ -n "$FORK" ]; then
    echo "==> Actualizando overlay Nodalix..."

    nodalix_ensure_overlay_remote "$OVERLAY_REMOTE" "$FORK"
    nodalix_fetch_overlay "$OVERLAY_REMOTE" "$OVERLAY_BRANCH"

    OVERLAY_REF="refs/remotes/$OVERLAY_REMOTE/$OVERLAY_BRANCH"
    nodalix_prepare_overlay "opencad" "$UPSTREAM_REF" "$OVERLAY_REF"
    OVERLAY_HASH="$NODALIX_OVERLAY_HASH"
    OVERLAY_ID="${OVERLAY_HASH:0:12}"
fi

DEST="$VERSIONS/${LATEST_TAG}-${SAFE_CPU}-${OVERLAY_ID}"

echo
echo "Release: $LATEST_TAG"
echo "Commit:  $COMMIT"
echo "CPU:     $CPU"
echo "Overlay: $OVERLAY_ID"

if [ -n "$OVERLAY_REF" ]; then
    echo
    echo "Cambios Nodalix efectivos:"
    nodalix_show_prepared_overlay
fi

echo

if [ -x "$DEST/OpenCADStudio" ]; then
    echo "==> Esta combinación upstream + CPU + overlay ya está compilada."
else
    echo "==> Preparando fuente limpia..."

    git checkout --detach "$UPSTREAM_REF"
    git reset --hard "$UPSTREAM_REF"
    git clean -fd

    if [ -n "$OVERLAY_REF" ]; then
        nodalix_apply_prepared_overlay
    fi

    echo
    echo "==> Compilando específicamente para:"
    echo "    $CPU"

    export RUSTFLAGS="-C target-cpu=native"

    cargo build \
        --locked \
        --release \
        --bin OpenCADStudio

    TMPDEST="$VERSIONS/.opencad-build-${LATEST_TAG}-${OVERLAY_ID}-$$"

    rm -rf "$TMPDEST"
    mkdir -p "$TMPDEST"

    install -Dm755 \
        target/release/OpenCADStudio \
        "$TMPDEST/OpenCADStudio"

    if [ ! -x "$TMPDEST/OpenCADStudio" ]; then
        echo "ERROR: no se generó OpenCADStudio."
        exit 1
    fi

    echo "$LATEST_TAG" > "$TMPDEST/version"
    echo "$COMMIT" > "$TMPDEST/commit"
    echo "$CPU" > "$TMPDEST/cpu"
    echo "$OVERLAY_HASH" > "$TMPDEST/overlay"

    mv "$TMPDEST" "$DEST"
    TMPDEST=""

    echo "==> Build terminada correctamente."
fi

echo
echo "==> Activando OpenCAD Studio..."

CURRENT_TMP="$ROOT/.current.new.$$"
rm -f "$CURRENT_TMP"
ln -s "$DEST" "$CURRENT_TMP"
mv -Tf "$CURRENT_TMP" "$CURRENT"

BINLINK="$HOME/.local/bin/.opencad-studio.new.$$"
rm -f "$BINLINK"
ln -s "$CURRENT/OpenCADStudio" "$BINLINK"
mv -Tf "$BINLINK" "$HOME/.local/bin/opencad-studio"

DESKTOP="$HOME/.local/share/applications/io.github.HakanSeven12.OpenCadStudio.desktop"

if [ -f "$DESKTOP" ]; then
    sed -i \
        "s|^Exec=.*|Exec=env DRI_PRIME=1 $HOME/.local/bin/opencad-studio %F|" \
        "$DESKTOP"
fi

echo "==> Reaplicando integración e iconos Nodalix..."
nodalix_finish_update

echo
echo "==> OpenCAD Studio activo"
echo "    Release: $LATEST_TAG"
echo "    CPU:     $CPU"
echo "    Overlay: $OVERLAY_ID"
echo "    Ruta:    $CURRENT"

"$CURRENT/OpenCADStudio" --version 2>/dev/null || true
